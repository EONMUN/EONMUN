# Port Configuration
WEB_PORT=3002
WEB_INTERNAL_PORT=3000

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Authentication Configuration
# Generate a secret with: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here-use-openssl-rand-base64-32

# Google OAuth (optional for production)
# Get credentials from: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret

# Strapi CMS Configuration
NEXT_PUBLIC_STRAPI_API_URL=https://your-strapi-instance.com/api
NEXT_PUBLIC_STRAPI_API_TOKEN=your-strapi-api-token-here

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here

# SMTP Configuration for Contact Form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ncrmro@gmail.com
SMTP_FROM="EONMUN Contact Form"
SMTP_PASS=your-app-password

# Image Uploads (Local Development)
# Files are automatically saved to public/uploads/ directory
# No additional configuration needed for local development
# For production R2 setup, see .env.production.example
