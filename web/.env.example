# Strapi CMS Configuration
NEXT_PUBLIC_STRAPI_API_URL=https://your-strapi-instance.com/api
NEXT_PUBLIC_STRAPI_API_TOKEN=your-strapi-api-token-here

# Stripe Payment Configuration
# Get these from https://dashboard.stripe.com/apikeys
# Use test keys (pk_test_*, sk_test_*) for development
# Use live keys (pk_live_*, sk_live_*) for production
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# SMTP Configuration for Contact Form
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="EONMUN Contact Form <your-email@gmail.com>"