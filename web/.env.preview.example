# ================================================================================
# EONMUN WEB - PREVIEW ENVIRONMENT CONFIGURATION
# ================================================================================
# Copy this file to .env.preview for preview deployments (PR environments)
# Preview environments are deployed automatically for pull requests
# ================================================================================

# --------------------------------------------------------------------------------
# Database Configuration (Preview)
# --------------------------------------------------------------------------------

# Turso Database URL for preview environment
# Get from: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-preview-db.turso.io

# Turso Read-Only Auth Token for preview environment (used during build)
# Create with: turso db tokens create your-preview-db --read-only
TURSO_AUTH_TOKEN_READ=your_preview_read_only_token_here

# Turso Read-Write Auth Token for preview environment (used at runtime)
# Create with: turso db tokens create your-preview-db
TURSO_AUTH_TOKEN_WRITE=your_preview_read_write_token_here

# --------------------------------------------------------------------------------
# Application Configuration
# --------------------------------------------------------------------------------

# Preview environment URL (dynamic per PR)
# Will be set automatically to: https://pr-{number}.eonmun.com
NEXT_PUBLIC_APP_URL=https://pr-preview.eonmun.com

# --------------------------------------------------------------------------------
# Cloudflare Configuration
# --------------------------------------------------------------------------------

# Cloudflare API credentials (same as production)
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# --------------------------------------------------------------------------------
# R2 Storage Configuration
# --------------------------------------------------------------------------------

# Public URL for R2 bucket (preview)
# Configured in wrangler.jsonc under preview environment
R2_PUBLIC_URL=https://cdn-preview.eonmun.com

# --------------------------------------------------------------------------------
# Web3 Configuration (Optional - can reuse production values)
# --------------------------------------------------------------------------------

# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Infura API Key
NEXT_PUBLIC_INFURA_KEY=your_infura_key
