# ================================================================================
# EONMUN WEB - NEXT ENVIRONMENT CONFIGURATION
# ================================================================================
# Copy this file to .env.next for next branch deployments
# Next environment is for testing upcoming features before production
# Deployed to: https://next.eonmun.com
# ================================================================================

# --------------------------------------------------------------------------------
# Database Configuration (Next)
# --------------------------------------------------------------------------------

# Turso Database URL for next environment
# Get from: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-next-db.turso.io

# Turso Auth Token for next environment
# Create with: turso db tokens create your-next-db
TURSO_AUTH_TOKEN=your_next_auth_token_here

# --------------------------------------------------------------------------------
# Application Configuration
# --------------------------------------------------------------------------------

# Next environment URL
NEXT_PUBLIC_APP_URL=https://next.eonmun.com
NEXT_PUBLIC_SITE_URL=https://next.eonmun.com

# --------------------------------------------------------------------------------
# Cloudflare Configuration
# --------------------------------------------------------------------------------

# Cloudflare API credentials (same as production)
# Get from: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id

# --------------------------------------------------------------------------------
# R2 Storage Configuration
# --------------------------------------------------------------------------------

# Public URL for R2 bucket (next)
# Configured in wrangler.jsonc under next environment
R2_PUBLIC_URL=https://cdn.eonmun.com

# --------------------------------------------------------------------------------
# Web3 Configuration (Optional - can reuse production values)
# --------------------------------------------------------------------------------

# WalletConnect Project ID
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Infura API Key
NEXT_PUBLIC_INFURA_KEY=your_infura_key

# --------------------------------------------------------------------------------
# Strapi CMS Configuration (Optional)
# --------------------------------------------------------------------------------

# Next environment Strapi URL (if separate from production)
# NEXT_PUBLIC_STRAPI_API_URL=https://strapi-next.eonmun.com/api
