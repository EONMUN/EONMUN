{
  "name": "eonmun-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "npx tsc --noEmit",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
    "wagmi": "wagmi generate",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:e2e": "npx playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/database/fixtures/load.ts",
    "db:fixtures:load": "tsx src/database/fixtures/load.ts",
    "r2:generate-credentials": "node ./scripts/generate-r2-credentials.js",
    "r2:manifest": "node ./scripts/generate-r2-manifest.js",
    "r2:upload": "node ./scripts/upload-to-r2.js",
    "r2:verify": "node ./scripts/verify-r2-uploads.js",
    "r2:update-fixtures": "node ./scripts/update-fixture-urls.js"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.10.0",
    "@heroicons/react": "^2.2.0",
    "@libsql/client": "^0.15.15",
    "@opennextjs/cloudflare": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.3",
    "@reown/appkit-adapter-wagmi": "^1.7.11",
    "@stripe/stripe-js": "^7.6.1",
    "@tailwindcss/typography": "^0.5.19",
    "arweave": "^1.15.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-fade": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "fs-extra": "^11.3.2",
    "lucide-react": "^0.525.0",
    "next": "15.3.4",
    "next-auth": "^5.0.0-beta.29",
    "nodemailer": "6.10.1",
    "pino-pretty": "^13.0.0",
    "posthog-js": "^1.257.1",
    "posthog-node": "^5.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^18.3.0",
    "tailwind-merge": "^3.3.1",
    "wagmi": "^2.15.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@faker-js/faker": "^10.1.0",
    "@playwright/test": "1.57.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.1",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/ui": "^4.0.4",
    "@wagmi/cli": "^2.3.1",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "15.3.4",
    "fishery": "^2.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.3.5",
    "typescript": "^5",
    "vitest": "^4.0.4",
    "wrangler": "^4.46.0"
  }
}
