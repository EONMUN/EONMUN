# ================================================================================
# EONMUN WEB - PRODUCTION ENVIRONMENT CONFIGURATION
# ================================================================================
# Copy this file to .env.production for production builds
# For local development, use .env (see .env.example)
#
# IMPORTANT: Image Upload Configuration
# --------------------------------------
# Production image uploads use Cloudflare R2 for storage:
# 1. Users upload images via /api/upload endpoint
# 2. Files are stored in Cloudflare R2 bucket (configured in wrangler.jsonc)
# 3. R2 public URL is used to serve images
# 4. Local development saves files to public/uploads/ directory
#
# For Strapi content images (legacy):
# - The Next.js app proxies image requests via /uploads/[...path]/route.ts
# - Configure NEXT_PUBLIC_STRAPI_API_URL for Strapi integration
# ================================================================================

# --------------------------------------------------------------------------------
# Application Configuration
# --------------------------------------------------------------------------------

# The public URL where your production site is hosted
# Used for: SEO, sitemaps, canonical URLs, Open Graph metadata
NEXT_PUBLIC_APP_URL=https://eonmun.com

# --------------------------------------------------------------------------------
# Strapi CMS Configuration (CRITICAL FOR IMAGE UPLOADS)
# --------------------------------------------------------------------------------

# Production Strapi API URL
# This is used for:
# - All content API calls
# - Image upload proxy (/uploads/[...path]/route.ts)
# - Fetching artwork, product, and collection data
# Format: https://your-strapi-domain.com/api (include /api at the end)
NEXT_PUBLIC_STRAPI_API_URL=https://api.eonmun.com/api

# Strapi API Token for authenticated requests
# Required for:
# - Accessing protected content
# - Image upload proxy authentication
# - Create this token in Strapi Admin → Settings → API Tokens
# - Minimum permissions: read access to all content types and upload files
NEXT_PUBLIC_STRAPI_API_TOKEN=your-production-strapi-api-token-here

# --------------------------------------------------------------------------------
# Payment Processing (Stripe)
# --------------------------------------------------------------------------------

# Stripe Publishable Key (safe to expose in client-side code)
# Get from: https://dashboard.stripe.com/apikeys
# Use your LIVE key for production (starts with pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_publishable_key_here

# Stripe Secret Key (NEVER expose this publicly)
# Get from: https://dashboard.stripe.com/apikeys
# Use your LIVE key for production (starts with sk_live_)
STRIPE_SECRET_KEY=sk_live_your_secret_key_here

# --------------------------------------------------------------------------------
# Email Configuration (SMTP)
# --------------------------------------------------------------------------------

# SMTP server hostname
# Examples:
# - Gmail: smtp.gmail.com
# - SendGrid: smtp.sendgrid.net
# - AWS SES: email-smtp.us-east-1.amazonaws.com
SMTP_HOST=smtp.gmail.com

# SMTP server port
# Common ports: 587 (TLS), 465 (SSL), 25 (plain)
SMTP_PORT=587

# SMTP authentication username
# For Gmail: your full email address
# For SendGrid: "apikey"
SMTP_USER=your-email@gmail.com

# Display name for outgoing emails
SMTP_FROM="EONMUN Contact Form"

# SMTP authentication password
# For Gmail: Use an App Password (not your regular password)
# Generate at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-smtp-password-or-app-password

# --------------------------------------------------------------------------------
# Web3 / Blockchain Configuration
# --------------------------------------------------------------------------------

# WalletConnect Project ID
# Get from: https://cloud.walletconnect.com/
# Used for: wallet connection UI (Reown AppKit)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Infura API Key
# Get from: https://infura.io/dashboard
# Used for: Ethereum RPC connections
NEXT_PUBLIC_INFURA_KEY=your-infura-api-key

# --------------------------------------------------------------------------------
# Analytics & Monitoring
# --------------------------------------------------------------------------------

# PostHog API Key
# Get from: https://app.posthog.com/project/settings
# Used for: user analytics, feature flags, session recording
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_key_here

# --------------------------------------------------------------------------------
# Authentication Configuration (NextAuth.js)
# --------------------------------------------------------------------------------

# From email address for authentication emails
# Format: Display Name <email@domain.com> or just email@domain.com
# Example: "EONMUN Onboarding <onboarding@eonmun.com>"
AUTH_EMAIL_FROM=onboarding@eonmun.com

# Google OAuth Configuration
# Get from: https://console.cloud.google.com/apis/credentials
# 1. Create OAuth 2.0 Client ID
# 2. Add authorized redirect URI: https://eonmun.com/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your_google_client_secret

# Mailgun Configuration (for sending auth emails)
# Get from: https://app.mailgun.com/app/account/security/api_keys
# Used for: magic link emails, verification emails
AUTH_MAILGUN_KEY=your_mailgun_api_key

# NextAuth Redirect Proxy URL
# Public URL for authentication redirects (important for OAuth)
# Must match the authorized redirect URI in OAuth provider settings
AUTH_REDIRECT_PROXY_URL=https://eonmun.com/api/auth

# NextAuth Secret (CRITICAL - Generate a secure random string)
# Generate with: openssl rand -base64 32
# Used for: JWT encryption, session tokens, CSRF protection
AUTH_SECRET=your_nextauth_secret_generate_with_openssl_rand

# Trust the host header (required for proxy setups like Cloudflare Workers)
# Set to true when deploying behind a proxy
AUTH_TRUST_HOST=true

# --------------------------------------------------------------------------------
# Database Configuration (Turso - Production)
# --------------------------------------------------------------------------------

# Turso Database URL for production environment
# Get from: https://turso.tech/app
TURSO_DATABASE_URL=libsql://your-production-db.turso.io

# Turso Read-Only Auth Token for production (used during build)
# Create with: turso db tokens create your-production-db --read-only
TURSO_AUTH_TOKEN_READ=your_production_read_only_token_here

# Turso Read-Write Auth Token for production (used at runtime)
# Create with: turso db tokens create your-production-db
TURSO_AUTH_TOKEN_WRITE=your_production_read_write_token_here

# --------------------------------------------------------------------------------
# Image Upload - Cloudflare R2 Storage (PRODUCTION)
# --------------------------------------------------------------------------------

# R2 Public URL for uploaded images
# This is the public domain where your R2 bucket is accessible
# Options:
# 1. R2.dev subdomain: https://pub-xxxxx.r2.dev
# 2. Custom domain: https://r2.eonmun.com
#
# How to set up:
# 1. Create R2 bucket in Cloudflare Dashboard
# 2. Enable public access or set up custom domain
# 3. Configure bucket binding in wrangler.jsonc (see R2_BUCKET binding)
# 4. Set this URL to match your bucket's public endpoint
R2_PUBLIC_URL=https://r2.eonmun.com

# Note: The R2 bucket binding (R2_BUCKET) is configured in wrangler.jsonc
# You don't need to set it here - it's automatically available in Workers

# --------------------------------------------------------------------------------
# Optional: Port Configuration (usually not needed for production)
# --------------------------------------------------------------------------------

# These are typically only used in Docker Compose for local development
# Uncomment if you need to customize ports in your production environment

# WEB_PORT=3002
# WEB_INTERNAL_PORT=3000

# ================================================================================
# DEPLOYMENT NOTES
# ================================================================================
#
# Cloudflare Workers Deployment:
# ------------------------------
# Some environment variables are set in wrangler.jsonc for Cloudflare deployments:
# - NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID
# - NEXT_PUBLIC_INFURA_KEY
#
# For other environment variables, you have two options:
#
# 1. Build-time variables (in .env.production):
#    - NEXT_PUBLIC_* variables are bundled into your build
#    - These cannot be changed without rebuilding
#
# 2. Runtime secrets (set via Wrangler):
#    - Use: wrangler secret put STRIPE_SECRET_KEY
#    - Recommended for sensitive values like API keys and passwords
#    - Can be updated without rebuilding
#
# R2 Bucket Setup (Production Image Uploads):
# --------------------------------------------
# 1. Create R2 bucket in Cloudflare Dashboard:
#    - Go to R2 → Create bucket
#    - Name it (e.g., "eonmun-uploads")
#
# 2. Configure public access:
#    Option A: Use R2.dev subdomain (easiest)
#      - Go to bucket settings → Public access
#      - Enable public access
#      - Copy the R2.dev URL
#
#    Option B: Use custom domain (recommended for production)
#      - Go to bucket settings → Custom domains
#      - Add custom domain (e.g., r2.eonmun.com)
#      - Configure DNS as instructed
#
# 3. Update environment variables:
#    - Set R2_PUBLIC_URL to your bucket's public URL
#    - Update wrangler.jsonc with bucket binding (see below)
#
# 4. Deploy with Wrangler:
#    npm run deploy
#
# Image Upload Testing:
# ---------------------
# To test image uploads:
# Production:
# 1. Deploy app with R2 binding configured
# 2. Use the ImageUpload component in your pages
# 3. Files will be uploaded to R2 and URLs returned
#
# Local Development:
# 1. No configuration needed
# 2. Files are saved to public/uploads/ directory
# 3. Accessible at http://localhost:3002/uploads/filename.jpg
#
# Strapi Images (Legacy/Content):
# 1. Configure NEXT_PUBLIC_STRAPI_API_URL
# 2. Images from Strapi are proxied via /uploads/[...path]/route.ts
#
# ================================================================================
