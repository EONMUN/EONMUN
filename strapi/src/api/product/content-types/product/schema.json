{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Products that can be purchased, optionally linked to artworks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "unique": false
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "price": {
      "type": "decimal",
      "required": true,
      "min": 0,
      "default": 0
    },
    "currency": {
      "type": "enumeration",
      "enum": ["USD", "EUR", "GBP"],
      "default": "USD",
      "required": true
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "title",
      "required": true
    },
    "images": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "artwork": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::artwork.artwork"
    },
    "product_type": {
      "type": "enumeration",
      "enum": ["artwork", "print", "merchandise", "digital", "book", "other"],
      "default": "other",
      "required": true
    },
    "is_digital": {
      "type": "boolean",
      "default": false
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "stock_quantity": {
      "type": "integer",
      "min": 0,
      "default": 1
    },
    "stripe_product_id": {
      "type": "string"
    },
    "sku": {
      "type": "string",
      "unique": true
    },
    "weight": {
      "type": "decimal",
      "min": 0
    },
    "dimensions": {
      "type": "json"
    },
    "shipping_required": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "collections": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::collection.collection",
      "inversedBy": "products"
    }
  }
}