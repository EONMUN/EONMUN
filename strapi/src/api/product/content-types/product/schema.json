{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Products that can be purchased, optionally linked to artworks"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "i18n": {
      "localized": true
    }
  },
  "attributes": {
    "title": {
      "type": "string",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "required": true,
      "unique": false
    },
    "description": {
      "type": "text",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      }
    },
    "price": {
      "type": "decimal",
      "required": true,
      "default": 0,
      "min": 0
    },
    "currency": {
      "type": "enumeration",
      "required": true,
      "default": "USD",
      "enum": [
        "USD",
        "EUR",
        "GBP"
      ]
    },
    "slug": {
      "type": "uid",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "targetField": "title",
      "required": true
    },
    "images": {
      "type": "media",
      "pluginOptions": {
        "i18n": {
          "localized": true
        }
      },
      "multiple": true,
      "allowedTypes": [
        "images"
      ]
    },
    "artwork": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::artwork.artwork"
    },
    "product_type": {
      "type": "enumeration",
      "required": true,
      "default": "other",
      "enum": [
        "artwork",
        "print",
        "merchandise",
        "digital",
        "book",
        "other"
      ]
    },
    "is_digital": {
      "type": "boolean",
      "default": false
    },
    "is_available": {
      "type": "boolean",
      "default": true
    },
    "stock_quantity": {
      "type": "integer",
      "default": 1,
      "min": 0
    },
    "weight": {
      "type": "decimal",
      "min": 0
    },
    "dimensions": {
      "type": "json"
    },
    "shipping_required": {
      "type": "boolean",
      "default": false
    },
    "featured": {
      "type": "boolean",
      "default": false
    }
  }
}
