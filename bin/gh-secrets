#!/usr/bin/env python3
"""
GitHub Secrets Uploader
Upload secrets from .env files to GitHub Actions secrets using gh CLI.
Supports production (.env.production) and preview (.env.preview) environments.
Zero external dependencies - uses only Python standard library + gh CLI.
"""

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Tuple


class Colors:
    """ANSI color codes for terminal output."""
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    RESET = '\033[0m'

    @classmethod
    def red(cls, text: str) -> str:
        return f"{cls.RED}{text}{cls.RESET}"

    @classmethod
    def green(cls, text: str) -> str:
        return f"{cls.GREEN}{text}{cls.RESET}"

    @classmethod
    def yellow(cls, text: str) -> str:
        return f"{cls.YELLOW}{text}{cls.RESET}"

    @classmethod
    def blue(cls, text: str) -> str:
        return f"{cls.BLUE}{text}{cls.RESET}"


def parse_env_file(env_file_path: Path) -> Dict[str, str]:
    """
    Parse environment file and return key-value pairs.
    
    Args:
        env_file_path: Path to the .env file
        
    Returns:
        Dictionary of environment variables
    """
    env_vars = {}
    
    if not env_file_path.exists():
        return env_vars
    
    with open(env_file_path, 'r') as f:
        for line_num, line in enumerate(f, 1):
            # Strip whitespace
            line = line.strip()
            
            # Skip empty lines and comments
            if not line or line.startswith('#'):
                continue
            
            # Match KEY=VALUE pattern
            match = re.match(r'^([A-Za-z_][A-Za-z0-9_]*)=(.*)$', line)
            if match:
                key = match.group(1)
                value = match.group(2)
                
                # Remove quotes if present
                value = value.strip('"').strip("'")
                
                env_vars[key] = value
            else:
                print(Colors.yellow(f"⚠ Skipping invalid line {line_num}: {line}"))
    
    return env_vars


def categorize_variables(env_vars: Dict[str, str]) -> Tuple[Dict[str, str], List[str], List[str]]:
    """
    Categorize variables into secrets, public vars, and empty values.
    
    Args:
        env_vars: Dictionary of all environment variables
        
    Returns:
        Tuple of (secrets_dict, public_vars_list, empty_keys_list)
    """
    secrets = {}
    public_vars = []
    empty_keys = []
    
    for key, value in env_vars.items():
        # Check for empty values
        if not value:
            empty_keys.append(key)
            continue
        
        # Check if it's a public variable (NEXT_PUBLIC_*)
        if key.startswith('NEXT_PUBLIC_'):
            public_vars.append(key)
            continue
        
        # Everything else is a secret
        secrets[key] = value
    
    return secrets, public_vars, empty_keys


def check_gh_available() -> bool:
    """Check if gh CLI is available and authenticated."""
    try:
        subprocess.run(
            ['gh', 'auth', 'status'],
            capture_output=True,
            check=True,
            timeout=10
        )
        return True
    except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired):
        return False


def get_repo_name() -> str:
    """Get the repository name in owner/repo format."""
    try:
        result = subprocess.run(
            ['gh', 'repo', 'view', '--json', 'nameWithOwner', '-q', '.nameWithOwner'],
            capture_output=True,
            check=True,
            text=True,
            timeout=10
        )
        return result.stdout.strip()
    except (subprocess.CalledProcessError, FileNotFoundError, subprocess.TimeoutExpired) as e:
        print(Colors.red(f"Error: Failed to get repository name: {e}"))
        sys.exit(1)


def upload_secret_to_github(key: str, value: str, env_suffix: str = '', dry_run: bool = False) -> bool:
    """
    Upload a single secret to GitHub Actions secrets.
    
    Args:
        key: Secret key name
        value: Secret value
        env_suffix: Optional suffix to append to key (e.g., '_PREVIEW', '_NEXT')
        dry_run: If True, only simulate the upload
        
    Returns:
        True if successful (or dry run), False otherwise
    """
    final_key = f"{key}{env_suffix}"
    
    if dry_run:
        print(Colors.green(f"✓ Would upload: {final_key}"))
        return True
    
    try:
        print(Colors.blue(f"⇪ Uploading: {final_key}"))
        
        # Use gh secret set to upload secret
        process = subprocess.Popen(
            ['gh', 'secret', 'set', final_key],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        
        # Send the secret value via stdin
        stdout, stderr = process.communicate(input=value)
        
        if process.returncode == 0:
            print(Colors.green(f"✓ Uploaded: {final_key}"))
            return True
        else:
            print(Colors.red(f"✗ Failed to upload: {final_key}"))
            if stderr:
                print(Colors.red(f"  Error: {stderr.strip()}"))
            return False
            
    except Exception as e:
        print(Colors.red(f"✗ Failed to upload {final_key}: {str(e)}"))
        return False


def print_header(env_files: List[str], dry_run: bool):
    """Print script header with configuration."""
    print(Colors.blue("━" * 60))
    print(Colors.blue("GitHub Secrets Upload"))
    print(Colors.blue("━" * 60))
    print()
    print(f"Environment files: {', '.join(env_files)}")
    print(f"Repository: {get_repo_name()}")
    if dry_run:
        print(Colors.yellow("Mode: DRY RUN (no changes will be made)"))
    print()


def print_summary(stats: Dict[str, int], dry_run: bool):
    """Print summary of operations."""
    print()
    print(Colors.blue("━" * 60))
    print(Colors.blue("Summary"))
    print(Colors.blue("━" * 60))
    
    if dry_run:
        print(Colors.green(f"Secrets that would be uploaded: {stats['uploaded']}"))
    else:
        print(Colors.green(f"Secrets uploaded: {stats['uploaded']}"))
    
    print(Colors.yellow(f"Public variables skipped: {stats['public']}"))
    print(Colors.yellow(f"Empty values skipped: {stats['empty']}"))
    print()
    
    if stats['public'] > 0:
        print(Colors.yellow("Note: NEXT_PUBLIC_* variables should be added to wrangler.jsonc vars section"))
        print()
    
    if not dry_run and stats['uploaded'] > 0:
        print(Colors.green(f"✓ Secrets successfully uploaded to GitHub Actions"))


def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description='Upload secrets from .env files to GitHub Actions secrets.',
        epilog='''
Examples:
  %(prog)s                           # Upload from .env.production and .env.preview
  %(prog)s --production-only         # Only upload production secrets
  %(prog)s --preview-only            # Only upload preview secrets
  %(prog)s --dry-run                 # Show what would be uploaded
  %(prog)s --next-only               # Only upload next environment secrets

Note:
  - Production secrets are uploaded as-is (e.g., TURSO_AUTH_TOKEN)
  - Preview secrets get _PREVIEW suffix (e.g., TURSO_AUTH_TOKEN_PREVIEW)
  - Next secrets get _NEXT suffix (e.g., TURSO_AUTH_TOKEN_NEXT)
  - NEXT_PUBLIC_* variables are skipped (add to wrangler.jsonc instead)
  - Empty values and comments are skipped
  - Requires gh CLI to be installed and authenticated
        ''',
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    parser.add_argument(
        '--production-only',
        action='store_true',
        help='Only upload production secrets from .env.production'
    )
    
    parser.add_argument(
        '--preview-only',
        action='store_true',
        help='Only upload preview secrets from .env.preview'
    )
    
    parser.add_argument(
        '--next-only',
        action='store_true',
        help='Only upload next environment secrets from .env.next'
    )
    
    parser.add_argument(
        '-d', '--dry-run',
        action='store_true',
        help='Show what would be uploaded without actually uploading'
    )
    
    args = parser.parse_args()
    
    # Resolve paths
    script_dir = Path(__file__).parent
    project_root = script_dir.parent
    web_dir = project_root / 'web'
    
    # Check if gh CLI is available
    if not check_gh_available():
        print(Colors.red("Error: gh CLI not found or not authenticated"))
        print()
        print("Please install and authenticate gh CLI:")
        print("  https://cli.github.com/")
        print("  gh auth login")
        sys.exit(1)
    
    # Determine which environments to process
    environments = []
    if args.production_only:
        environments.append(('production', '.env.production', ''))
    elif args.preview_only:
        environments.append(('preview', '.env.preview', '_PREVIEW'))
    elif args.next_only:
        environments.append(('next', '.env.next', '_NEXT'))
    else:
        # Default: upload both production and preview
        environments.append(('production', '.env.production', ''))
        environments.append(('preview', '.env.preview', '_PREVIEW'))
        environments.append(('next', '.env.next', '_NEXT'))
    
    # Check if environment files exist
    env_files_to_process = []
    for env_name, env_file, suffix in environments:
        env_file_path = web_dir / env_file
        if env_file_path.exists():
            env_files_to_process.append((env_name, env_file_path, suffix))
        else:
            print(Colors.yellow(f"⚠ Skipping {env_name}: {env_file} not found"))
    
    if not env_files_to_process:
        print(Colors.red("Error: No environment files found"))
        print()
        print("Please create at least one of:")
        print("  - web/.env.production")
        print("  - web/.env.preview")
        print("  - web/.env.next")
        sys.exit(1)
    
    # Print header
    print_header([str(p.name) for _, p, _ in env_files_to_process], args.dry_run)
    
    # Process each environment
    stats = {
        'uploaded': 0,
        'public': 0,
        'empty': 0
    }
    
    for env_name, env_file_path, suffix in env_files_to_process:
        print(Colors.blue(f"\n📦 Processing {env_name} environment"))
        print(Colors.blue("─" * 60))
        
        # Parse environment file
        env_vars = parse_env_file(env_file_path)
        
        if not env_vars:
            print(Colors.yellow(f"No variables found in {env_file_path.name}"))
            continue
        
        # Categorize variables
        secrets, public_vars, empty_keys = categorize_variables(env_vars)
        
        # Track stats
        stats['public'] += len(public_vars)
        stats['empty'] += len(empty_keys)
        
        # Show skipped variables
        for key in empty_keys:
            print(Colors.yellow(f"⊘ Skipping {key} (empty value)"))
        
        for key in public_vars:
            print(Colors.yellow(f"⊘ Skipping {key} (public variable - add to wrangler.jsonc instead)"))
        
        # Upload secrets
        for key, value in secrets.items():
            if upload_secret_to_github(key, value, suffix, args.dry_run):
                stats['uploaded'] += 1
    
    # Print summary
    print_summary(stats, args.dry_run)


if __name__ == '__main__':
    main()
