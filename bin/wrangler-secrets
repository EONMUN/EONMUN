#!/usr/bin/env python3
"""
Wrangler Secrets Uploader
Upload secrets from .env.production to Cloudflare Workers using Wrangler.
Zero external dependencies - uses only Python standard library.
"""

import argparse
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Tuple


class Colors:
    """ANSI color codes for terminal output."""
    RED = '\033[0;31m'
    GREEN = '\033[0;32m'
    YELLOW = '\033[1;33m'
    BLUE = '\033[0;34m'
    RESET = '\033[0m'

    @classmethod
    def red(cls, text: str) -> str:
        return f"{cls.RED}{text}{cls.RESET}"

    @classmethod
    def green(cls, text: str) -> str:
        return f"{cls.GREEN}{text}{cls.RESET}"

    @classmethod
    def yellow(cls, text: str) -> str:
        return f"{cls.YELLOW}{text}{cls.RESET}"

    @classmethod
    def blue(cls, text: str) -> str:
        return f"{cls.BLUE}{text}{cls.RESET}"


def parse_env_file(env_file_path: Path) -> Dict[str, str]:
    """
    Parse environment file and return key-value pairs.
    
    Args:
        env_file_path: Path to the .env file
        
    Returns:
        Dictionary of environment variables
    """
    env_vars = {}
    
    if not env_file_path.exists():
        return env_vars
    
    with open(env_file_path, 'r') as f:
        for line_num, line in enumerate(f, 1):
            # Strip whitespace
            line = line.strip()
            
            # Skip empty lines and comments
            if not line or line.startswith('#'):
                continue
            
            # Match KEY=VALUE pattern
            match = re.match(r'^([A-Za-z_][A-Za-z0-9_]*)=(.*)$', line)
            if match:
                key = match.group(1)
                value = match.group(2)
                
                # Remove quotes if present
                value = value.strip('"').strip("'")
                
                env_vars[key] = value
            else:
                print(Colors.yellow(f"⚠ Skipping invalid line {line_num}: {line}"))
    
    return env_vars


def categorize_variables(env_vars: Dict[str, str]) -> Tuple[Dict[str, str], List[str], List[str]]:
    """
    Categorize variables into secrets, public vars, and empty values.
    
    Args:
        env_vars: Dictionary of all environment variables
        
    Returns:
        Tuple of (secrets_dict, public_vars_list, empty_keys_list)
    """
    secrets = {}
    public_vars = []
    empty_keys = []
    
    for key, value in env_vars.items():
        # Check for empty values
        if not value:
            empty_keys.append(key)
            continue
        
        # Check for public variables
        if key.startswith('NEXT_PUBLIC_'):
            public_vars.append(key)
            continue
        
        # It's a secret
        secrets[key] = value
    
    return secrets, public_vars, empty_keys


def check_wrangler_available() -> bool:
    """Check if wrangler CLI is available."""
    try:
        subprocess.run(
            ['npx', 'wrangler', '--version'],
            capture_output=True,
            check=True
        )
        return True
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def upload_secret(key: str, value: str, wrangler_env: str, dry_run: bool = False) -> bool:
    """
    Upload a single secret to Wrangler.
    
    Args:
        key: Secret key name
        value: Secret value
        wrangler_env: Wrangler environment (production, preview, etc.)
        dry_run: If True, only simulate the upload
        
    Returns:
        True if successful (or dry run), False otherwise
    """
    if dry_run:
        print(Colors.green(f"✓ Would upload: {key}"))
        return True
    
    try:
        print(Colors.blue(f"⇪ Uploading: {key}"))
        
        # Use npx wrangler to upload secret
        process = subprocess.Popen(
            ['npx', 'wrangler', 'secret', 'put', key, '--env', wrangler_env],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True
        )
        
        # Send the secret value via stdin
        stdout, stderr = process.communicate(input=value)
        
        if process.returncode == 0:
            print(Colors.green(f"✓ Uploaded: {key}"))
            return True
        else:
            print(Colors.red(f"✗ Failed to upload: {key}"))
            if stderr:
                print(Colors.red(f"  Error: {stderr.strip()}"))
            return False
            
    except Exception as e:
        print(Colors.red(f"✗ Failed to upload {key}: {str(e)}"))
        return False


def print_header(env_file: str, wrangler_env: str, dry_run: bool):
    """Print script header with configuration."""
    print(Colors.blue("━" * 40))
    print(Colors.blue("Wrangler Secrets Upload"))
    print(Colors.blue("━" * 40))
    print()
    print(f"Environment file: {env_file}")
    print(f"Wrangler env: {wrangler_env}")
    if dry_run:
        print(Colors.yellow("Mode: DRY RUN (no changes will be made)"))
    print()


def print_summary(secrets_count: int, public_count: int, empty_count: int, dry_run: bool):
    """Print summary of operations."""
    print()
    print(Colors.blue("━" * 40))
    print(Colors.blue("Summary"))
    print(Colors.blue("━" * 40))
    
    if dry_run:
        print(Colors.green(f"Secrets that would be uploaded: {secrets_count}"))
    else:
        print(Colors.green(f"Secrets uploaded: {secrets_count}"))
    
    print(Colors.yellow(f"Public variables skipped: {public_count}"))
    print(Colors.yellow(f"Empty values skipped: {empty_count}"))
    print()
    
    if public_count > 0:
        print(Colors.yellow("Note: NEXT_PUBLIC_* variables should be added to wrangler.jsonc vars section"))
        print()
    
    if not dry_run and secrets_count > 0:
        print(Colors.green(f"✓ Secrets successfully uploaded to Cloudflare Workers"))


def main():
    """Main entry point."""
    parser = argparse.ArgumentParser(
        description='Upload secrets from .env.production to Cloudflare Workers using Wrangler.',
        epilog='''
Examples:
  %(prog)s                           # Upload secrets to production
  %(prog)s --env preview             # Upload to preview environment
  %(prog)s --dry-run                 # Show what would be uploaded
  %(prog)s --file web/.env.staging   # Use custom env file

Note:
  - Only non-NEXT_PUBLIC_* variables are uploaded as secrets
  - NEXT_PUBLIC_* variables should be added to wrangler.jsonc instead
  - Empty values and comments are skipped
  - The .env.production file should be git-ignored for security
        ''',
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    
    parser.add_argument(
        '-e', '--env',
        default='production',
        help='Wrangler environment (default: production)'
    )
    
    parser.add_argument(
        '-f', '--file',
        default='web/.env.production',
        help='Path to env file (default: web/.env.production)'
    )
    
    parser.add_argument(
        '-d', '--dry-run',
        action='store_true',
        help='Show what would be uploaded without actually uploading'
    )
    
    args = parser.parse_args()
    
    # Resolve paths
    script_dir = Path(__file__).parent
    project_root = script_dir.parent
    env_file_path = project_root / args.file
    web_dir = project_root / 'web'
    
    # Check if env file exists
    if not env_file_path.exists():
        print(Colors.red(f"Error: Environment file not found: {env_file_path}"))
        print()
        print(f"Please create {args.file} with your secrets.")
        print("See web/.env.production.example for template.")
        sys.exit(1)
    
    # Check if wrangler is available
    if not check_wrangler_available():
        print(Colors.red("Error: wrangler CLI not found"))
        print()
        print("Please install wrangler:")
        print("  npm install -g wrangler")
        print("  or")
        print("  cd web && npm install")
        sys.exit(1)
    
    # Change to web directory for wrangler context
    try:
        os.chdir(web_dir)
    except FileNotFoundError:
        print(Colors.red(f"Error: web directory not found: {web_dir}"))
        sys.exit(1)
    
    # Print header
    print_header(args.file, args.env, args.dry_run)
    
    # Parse environment file
    env_vars = parse_env_file(env_file_path)
    
    if not env_vars:
        print(Colors.yellow("No variables found in environment file"))
        sys.exit(0)
    
    # Categorize variables
    secrets, public_vars, empty_keys = categorize_variables(env_vars)
    
    # Show skipped variables
    for key in empty_keys:
        print(Colors.yellow(f"⊘ Skipping {key} (empty value)"))
    
    for key in public_vars:
        print(Colors.yellow(f"⊘ Skipping {key} (public variable - add to wrangler.jsonc instead)"))
    
    # Upload secrets
    success_count = 0
    for key, value in secrets.items():
        if upload_secret(key, value, args.env, args.dry_run):
            success_count += 1
    
    # Print summary
    print_summary(success_count, len(public_vars), len(empty_keys), args.dry_run)
    
    # Exit with appropriate code
    if not args.dry_run and success_count < len(secrets):
        sys.exit(1)


if __name__ == '__main__':
    main()
