/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "eonmun",
	"main": ".open-next/worker.js",
	"compatibility_date": "2025-03-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
		// NOTE: `no_handle_cross_request_promise_resolution` was tried in
		// fb8ca3a and reverted in the next commit. It turned the singleton
		// libSQL client's cross-request promise leak from "sometimes hangs"
		// into "fails fast on every concurrent request", which raised the
		// 500 rate from ~30% to ~67% under fan-out. The flag is the right
		// runtime setting in principle but cannot be enabled until the
		// data layer stops sharing state across requests — see follow-up
		// to rewrite src/database/index.ts as a per-request `getDb()`.
	],
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID": "58d01e1f07385c9558411c3cc158d3ad",
		"NEXT_PUBLIC_INFURA_KEY": "4a51a35099fd4fbd8d8e1532eb7ea933",
		"R2_PUBLIC_URL": "https://r2.eonmun.com",
		"NEXT_PUBLIC_POSTHOG_KEY": "phc_N9CnYysToROM3hTzrt3dC4K12TaF616Z84t83aymTDp"
	},
	"r2_buckets": [
		{
			"binding": "R2_BUCKET",
			"bucket_name": "eonmun-production"
		},
		{
			// Second binding to the same bucket. OpenNext's R2 incremental
			// cache writes under the `incremental-cache/` prefix by default
			// (overridable via NEXT_INC_CACHE_R2_PREFIX), so it's isolated
			// from media at the bucket root.
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "eonmun-production"
		}
	],
	// Durable Object used by OpenNext's `doQueue` to dedupe revalidation
	// renders. When a page's revalidate TTL expires and N concurrent
	// visitors hit it, this object ensures exactly one re-render fires.
	"durable_objects": {
		"bindings": [
			{
				"name": "NEXT_CACHE_DO_QUEUE",
				"class_name": "DOQueueHandler"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["DOQueueHandler"]
		}
	],
	// Self-service binding so the queue can invoke the worker for the
	// dedup'd revalidation render. Required by both r2IncrementalCache
	// and doQueue per OpenNext docs.
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "eonmun"
		}
	]
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 *
	 * Required secrets for contact form (configured in .env.production):
	 * - SMTP_HOST (e.g., smtp.gmail.com)
	 * - SMTP_PORT (e.g., 587)
	 * - SMTP_USER (your email address)
	 * - SMTP_FROM (display name for sender)
	 * - SMTP_PASS (app-specific password)
	 *
	 * Upload secrets from .env.production:
	 * `npx wrangler secret bulk .env.production`
	 */
	/**
	 * Static Assets
	 * https://developers.cloudflare.com/workers/static-assets/binding/
	 */
	// "assets": { "directory": "./public/", "binding": "ASSETS" },
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
}