{
	"name": "eonmun-astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"catalog:sync": "node ./scripts/sync-static-catalog.mjs",
		"dev": "node ./scripts/sync-static-catalog.mjs && astro dev",
		"build": "node ./scripts/sync-static-catalog.mjs && astro build",
		"preview": "node ./scripts/sync-static-catalog.mjs && astro build && astro preview",
		"astro": "astro",
		"deploy": "node ./scripts/sync-static-catalog.mjs && astro build && wrangler deploy",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^13.5.0",
		"@astrojs/mdx": "^5.0.4",
		"@libsql/client": "^0.17.3",
		"astro": "^6.3.1",
		"drizzle-orm": "^0.45.2",
		"sharp": "^0.34.3"
	},
	"devDependencies": {
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"tailwindcss": "^4.3.0",
		"wrangler": "^4.90.1"
	},
	"overrides": {
		"vite": "^7"
	}
}
