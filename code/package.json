{
	"name": "eonmun-astro",
	"type": "module",
	"version": "0.0.1",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"posts:sync": "node ./scripts/sync-posts-content.mjs",
		"content:sync": "node ./scripts/sync-posts-content.mjs",
		"dev": "bun run content:sync && astro dev --ignore-lock --host 0.0.0.0",
		"build": "bun run content:sync && astro build",
		"preview": "bun run content:sync && astro build && astro preview",
		"astro": "astro",
		"deploy": "bun run content:sync && astro build && wrangler deploy",
		"cf-typegen": "wrangler types",
		"test": "bun test",
		"test:e2e": "playwright test",
		"db:migrate": "drizzle-kit migrate",
		"db:seed": "bun run scripts/seed-db.ts"
	},
	"dependencies": {
		"@astrojs/cloudflare": "^14",
		"@astrojs/mdx": "^7",
		"@auth/core": "^0.34.3",
		"@libsql/client": "^0.17.3",
		"astro": "^7",
		"drizzle-orm": "^0.45.2",
		"sharp": "^0.35"
	},
	"devDependencies": {
		"@playwright/test": "1.57.0",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"drizzle-kit": "^0.31.5",
		"happy-dom": "^20.11.2",
		"tailwindcss": "^4.3.0",
		"wrangler": "^4.125"
	}
}
