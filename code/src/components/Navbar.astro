---
const links = [
	{ href: '/collections', label: 'Collections' },
	{ href: '/posts', label: 'Posts' },
	{ href: '/artworks', label: 'Artwork' },
	{ href: '/contact', label: 'Contact' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const onDarkSurface = pathname === '/';
---
<nav class:list={['sticky top-0 z-50 p-2 flex justify-between items-center gap-2 bg-transparent', { 'homepage-navigation': pathname === '/' }]}>
	<a href="/" data-home-logo data-astro-prefetch="load" class:list={['touch-manipulation pl-2 tracking-[0.1em] sm:tracking-[0.363636em] text-lg sm:text-2xl lg:text-3xl font-bold', onDarkSurface ? 'text-white' : 'text-gray-900 dark:text-white']}>
		EONMUN
	</a>
	<div class="backdrop-blur-lg border shadow-xl bg-black/30 border-gray-500/30 flex flex-wrap gap-2 sm:gap-4 uppercase justify-between p-2 sm:p-4 rounded-lg font-bold tracking-wider sm:tracking-widest w-full sm:w-auto items-center">
		{links.map(({ href, label }) => {
			const isActive = pathname === href || pathname.startsWith(`${href}/`);
			return (
				<a
					href={href}
					aria-current={isActive ? 'page' : undefined}
					data-astro-prefetch="load"
					class:list={[
						'text-xs sm:text-sm transition-colors',
						isActive ? 'text-white underline underline-offset-4' : 'text-white/70 hover:text-white',
					]}
				>
					{label}
				</a>
			);
		})}
	</div>
</nav>

<style>
	.homepage-navigation {
		position: absolute;
		left: 0;
		right: 0;
		padding-top: calc(0.5rem + env(safe-area-inset-top));
		padding-right: calc(0.5rem + env(safe-area-inset-right));
		padding-left: calc(0.5rem + env(safe-area-inset-left));
	}

	/* Admin routes follow the admin theme rather than the public dark chrome. */
	:global(html.admin-page) nav {
		background: var(--admin-bg);
	}

	:global(html.admin-page) [data-home-logo] {
		font-size: 1.25rem;
		letter-spacing: normal;
		color: var(--admin-text);
	}

	:global(html.admin-page) nav > div {
		text-transform: none;
		letter-spacing: normal;
		background: var(--admin-surface);
		border-color: var(--admin-border);
		box-shadow: none;
	}

	:global(html.admin-page) nav > div a {
		padding: 0.5rem 0.25rem;
		font-size: 0.875rem;
		color: var(--admin-muted);
	}

	:global(html.admin-page) nav > div a:hover {
		color: var(--admin-text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>

<script>
	const logo = document.querySelector<HTMLAnchorElement>('[data-home-logo]');
	if (location.pathname === '/' && logo) {
		let taps = 0;
		let lastTap = 0;
		logo.addEventListener('click', (event) => {
			if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
			event.preventDefault();
			const now = performance.now();
			taps = now - lastTap > 1500 ? 1 : taps + 1;
			lastTap = now;
			if (taps === 5) location.assign('/admin');
		});
	}
</script>
