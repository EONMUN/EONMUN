<script>
	const start = () => {
		const connection = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
		if (connection?.saveData) return;

		const links = document.querySelectorAll<HTMLAnchorElement>('[data-detail-image-src]');
		if (!links.length) return;

		const pending: HTMLAnchorElement[] = [];
		const images: HTMLImageElement[] = [];
		let remaining = 2;
		let loading = false;

		const loadNext = () => {
			if (loading) return;
			const link = pending.shift();
			if (!link) return;
			loading = true;
			const image = new Image();
			images.push(image);
			image.fetchPriority = 'low';
			image.decoding = 'async';
			if (link.dataset.detailImageSizes) image.sizes = link.dataset.detailImageSizes;
			if (link.dataset.detailImageSrcset) image.srcset = link.dataset.detailImageSrcset;
			image.onload = image.onerror = () => {
				loading = false;
				loadNext();
			};
			image.src = link.dataset.detailImageSrc!;
		};

		const observer = new IntersectionObserver((entries) => {
			for (const entry of entries) {
				if (!entry.isIntersecting || remaining === 0) continue;
				remaining--;
				observer.unobserve(entry.target);
				pending.push(entry.target as HTMLAnchorElement);
			}
			if (remaining === 0) observer.disconnect();
			loadNext();
		});
		links.forEach((link) => observer.observe(link));
	};

	if (document.readyState === 'complete') start();
	else window.addEventListener('load', start, { once: true });
</script>
