---
// The state badge both card types wear. It sits over user-uploaded artwork, so
// its ground is the opaque theme surface and the tone colour is checked against
// that surface rather than against the image.
export type StatusTone = 'live' | 'draft' | 'sold';

interface Props {
	label: string;
	tone: StatusTone;
}

const { label, tone } = Astro.props;
---
<span class:list={['status', `is-${tone}`]}>{label}</span>

<style>
	.status {
		position: absolute;
		top: 0.75rem;
		left: 0.75rem;
		z-index: 4;
		padding: 0.3rem 0.6rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--admin-muted);
		background: var(--admin-surface);
		border: 1px solid var(--admin-border-strong);
		border-radius: 0.35rem;
	}

	.status.is-live { color: var(--admin-success); border-color: var(--admin-success); }
	.status.is-draft { color: var(--admin-warning); border-color: var(--admin-warning); }
</style>
