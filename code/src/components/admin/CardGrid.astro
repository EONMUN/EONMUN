---
// The console's one grid rhythm, shared by every section that lists items.
---
<ul class="grid"><slot /></ul>

<style>
	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
		gap: clamp(1rem, 2.5vw, 2rem);
		margin: 1.75rem 0 0;
		padding: 0;
		list-style: none;
	}
</style>
