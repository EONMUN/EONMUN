---
// A titled band of the console: numbered heading, a tally line, and the links
// that act on that entity. The section owns the grid its slot content sits in.
interface Props {
	id?: string;
	index?: string;
	title: string;
	tally?: string;
	links?: { href: string; label: string }[];
}

const { id, index, title, tally, links = [] } = Astro.props;
---
<section class="entity" id={id}>
	<div class="entity-head">
		<h2>{index && <span class="index">{index}</span>}{title}</h2>
		{tally && <p class="tally">{tally}</p>}
		{links.length > 0 && (
			<div class="entity-links">
				{links.map((link) => <a class:list={['ghost', { create: link.href.endsWith('/new') }]} href={link.href}>{link.label}</a>)}
			</div>
		)}
	</div>
	<slot />
</section>

<style>
	.entity {
		margin-bottom: 4rem;
		scroll-margin-top: 5.5rem;
	}

	.entity-head {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.75rem 1.5rem;
		padding-bottom: 1rem;
		border-bottom: 1px solid var(--admin-border);
	}

	.entity-head h2 {
		margin: 0;
		font-size: 1.5rem;
	}

	.index {
		margin-right: 0.75rem;
		font-size: 0.875rem;
		color: var(--admin-gold);
		vertical-align: 0.35em;
	}

	.tally {
		margin: 0;
		font-size: 0.875rem;
		color: var(--admin-muted);
	}

	.entity-links {
		display: flex;
		gap: 1.25rem;
		margin-left: auto;
	}

	.ghost {
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--admin-muted);
		transition: color 200ms;
	}

	.create { display: inline-flex; align-items: center; min-height: 2.75rem; padding: .6rem 1rem; border: 1px solid var(--admin-border-strong); border-radius: .4rem; color: var(--admin-text); background: var(--admin-surface); }
	.create:hover { background: var(--admin-surface-muted); }

	.ghost:hover {
		color: var(--admin-gold);
	}

</style>
