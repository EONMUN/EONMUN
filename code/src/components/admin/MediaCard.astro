---
// One catalog item: a framed image, a status pill, and its caption. An item
// with nowhere to go renders as a div rather than a dead link. The frame,
// hatching and placeholder come from ConsoleShell so every card type shares
// one chrome.
import CardCaption from './CardCaption.astro';
import StatusPill, { type StatusTone } from './StatusPill.astro';
import { Image } from 'astro:assets';

interface Props {
	href?: string | null;
	title: string;
	meta?: string | null;
	metaTone?: 'default' | 'seal';
	imageUrl?: string | null;
	imageAlt?: string;
	placeholder?: string;
	shape?: 'portrait' | 'landscape';
	status?: { label: string; tone: StatusTone } | null;
	compact?: boolean;
	saleLabel?: string;
}

const {
	href,
	title,
	meta,
	metaTone = 'default',
	imageUrl,
	imageAlt = '',
	placeholder = 'No image',
	shape = 'portrait',
	status,
	compact = false,
	saleLabel,
} = Astro.props;

const Card = href ? 'a' : 'div';
---
<Card class:list={['card', { compact }]} href={href ?? undefined}>
	<span class:list={['frame', shape, { 'is-empty': !imageUrl }]}>
		{imageUrl ? (
			<Image data-fallback-src={imageUrl} format="webp" quality={75} fit="scale-down" src={imageUrl} alt={imageAlt} width={960} height={1200} widths={[480, 960]} sizes="(min-width: 1280px) 20vw, (min-width: 768px) 33vw, 50vw" />
		) : (
			<span class="no-image">{placeholder}</span>
		)}
		{status && !compact && <StatusPill label={status.label} tone={status.tone} />}
	</span>
	<span class="caption"><CardCaption title={title} meta={meta} metaTone={metaTone} />
		{compact && <span class="item-states"><span>{status?.label}</span><span>{saleLabel}</span></span>}
	</span>
</Card>

<style>
	.card { display: block; }

	.caption { display: block; min-width: 0; }
	.compact { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 1rem; align-items: center; padding: .9rem 0; }
	.compact .frame { height: 5rem; aspect-ratio: 1; }
	.compact :global(.card-body) { padding-top: 0; }
	.compact :global(.card-title) { overflow-wrap: anywhere; }
	.item-states { display: flex; gap: .6rem 1rem; flex-wrap: wrap; margin-top: .4rem; font-size: .875rem; color: var(--admin-muted); }
	@media (max-width: 480px) { .compact :global(.card-body) { align-items: start; flex-direction: column; gap: .3rem; } }
	.portrait { aspect-ratio: 4 / 5; }
	.landscape { aspect-ratio: 3 / 2; }

	.frame :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	a.card:hover .frame :global(img) {
		transform: scale(1.04);
	}

	@media (prefers-reduced-motion: reduce) {
		.frame :global(img) { transition: none; }
	}
</style>
