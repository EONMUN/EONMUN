---
// The admin console's frame: the themed workspace, the shared console control
// styles, and the masthead with the theme picker.
// Pages supply their own sections through the default slot.
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdminTheme from './AdminTheme.astro';

interface Props {
	title: string;
	eyebrow?: string;
	heading: string;
	email?: string;
	description?: string;
	backHref?: string;
	backLabel?: string;
	privateData?: boolean;
}

const {
	title,
	eyebrow = 'Studio console',
	heading,
	email,
	description = 'EONMUN studio console.',
	backHref,
	backLabel,
	privateData = false,
} = Astro.props;
---
<BaseLayout title={title} description={description} themeColor="#f5f3ee" privateData={privateData} adminAppearance>
	<AdminTheme slot="head" />
	{email && <script is:inline>
		// This shell is rendered after server-side admin authorization.
		if (window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true) {
			try { localStorage.setItem('eonmun.pwa.admin-start', '1'); } catch {}
		}
	</script>}
	<div class="console">
		<div class="wrap">
			<header class="masthead">
				<div>
					{backHref ? (
						<a class="back" href={backHref}>&larr; {backLabel ?? 'Back'}</a>
					) : (
						<p class="eyebrow">{eyebrow}</p>
					)}
					<h1 class="title">{heading}</h1>
				</div>
				<div class="identity">
					{email && <span class="email">{email}</span>}
					<label class="theme">
						Theme
						<select data-admin-theme-picker>
							<option value="system">System</option>
							<option value="light">Light</option>
							<option value="dark">Dark</option>
						</select>
					</label>
					<button class="signout" type="button" data-sign-out>Sign out</button>
				</div>
			</header>
			<slot />
		</div>
	</div>
</BaseLayout>

<style is:global>
	.console .secondary-button {
		min-height: 2.75rem;
		padding: .7rem 1.2rem;
		border: 1px solid var(--admin-border-strong);
		border-radius: .35rem;
		background: var(--admin-surface);
		color: var(--admin-text);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.console .secondary-button:hover {
		border-color: var(--admin-accent);
		color: var(--admin-accent-hover);
	}

	/* The framed surface a card sits in, shared by every card type so the
	   chrome cannot drift between them. */
	.console .frame {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--admin-surface);
		border: 1px solid var(--admin-border);
	}

	/* An empty frame is common for posts, which usually carry no cover.
	   Hatching reads as a prepared surface rather than a hole in the page. */
	.console .frame.is-empty {
		background-image: repeating-linear-gradient(-45deg, var(--admin-surface-muted) 0 1px, transparent 1px 9px);
	}

	.console a.card:hover .frame {
		border-color: var(--admin-accent);
	}

	.console .no-image {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.875rem;
		color: var(--admin-muted);
	}

	/* Form chrome is global rather than scoped because ArtworkForm builds its
	   image rows in a script, and script-created elements carry no scope id. */
	.console form {
		max-width: 56rem;
	}

	.console label {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--admin-muted);
	}

	.console .admin-input {
		display: block;
		width: 100%;
		margin-top: 0.5rem;
		min-height: 2.75rem;
		padding: 0.7rem 0.85rem;
		font: inherit;
		/* iOS zooms into any focused field set below 16px. */
		font-size: 1rem;
		font-weight: normal;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-text);
		background: var(--admin-surface);
		border: 1px solid var(--admin-border-strong);
		border-radius: 0.35rem;
		transition: border-color 200ms;
	}

	.console .admin-input:hover {
		border-color: var(--admin-text);
	}

	.console .admin-input:focus-visible {
		border-color: var(--admin-accent);
	}

	.console textarea.admin-input {
		min-height: 8rem;
		resize: vertical;
	}

	.console fieldset {
		margin: 0;
		padding: clamp(1rem, 2.5vw, 1.75rem);
		border: 1px solid var(--admin-border);
		background: var(--admin-surface);
	}

	.console legend {
		padding: 0 0.75rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--admin-accent);
	}

	/* A label wrapping a checkbox or radio reads as one line with its control;
	   a label wrapping a text field stacks above it. */
	.console label:has(input[type="checkbox"]),
	.console label:has(input[type="radio"]),
	.console .inline-label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1rem;
		font-weight: normal;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-text);
	}

	.console input[type="checkbox"],
	.console input[type="radio"] {
		accent-color: var(--admin-accent);
		width: 1.15rem;
		height: 1.15rem;
		flex: none;
	}

	.console input[type="file"] {
		font-size: 0.875rem;
		font-weight: normal;
		color: var(--admin-muted);
		text-transform: none;
		letter-spacing: normal;
	}

	.console .primary-button {
		min-height: 2.75rem;
		padding: 0.75rem 1.4rem;
		font-size: 1rem;
	}

	.console .error-banner {
		padding: 0.9rem 1.1rem;
		font-size: 0.95rem;
		color: var(--admin-text);
		background: var(--admin-danger-soft);
		border: 1px solid var(--admin-danger);
	}

	/* A form mid-save (lib/admin-form-save.ts). Disabled fields keep their text
	   colour, so they stay readable in both themes; the muted fill shows the lock. */
	.console form[aria-busy="true"],
	.console form[aria-busy="true"] :disabled,
	.console form[aria-busy="true"] [aria-disabled="true"] {
		cursor: progress;
	}

	.console form[aria-busy="true"] .admin-input {
		background: var(--admin-surface-muted);
	}

	.console form[aria-busy="true"] .primary-button:hover {
		background: var(--button-bg);
		color: var(--button-text);
	}

	.console .form-status {
		margin: 1rem 0 0;
	}

	/* WCAG 3.3.2: mark required fields visibly and say what the mark means once,
	   at the top of the form. The `required` attribute already carries the fact
	   to assistive technology, so the glyph is decorative. */
	.console .req {
		color: var(--admin-danger);
		font-size: 0.9em;
	}

	.console .required-note {
		font-size: 0.875rem;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-muted);
	}

	/* :user-invalid, not :invalid -- an empty required field is invalid from the
	   moment it renders, and flagging it before the user has touched it reads as
	   an error they have not made yet. */
	.console .admin-input:user-invalid {
		border-color: var(--admin-danger);
	}

	.console .hint {
		font-size: 0.875rem;
		font-weight: normal;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-muted);
	}

	/* A hint inside a label sits under its control, not beside the label text. */
	.console label .hint {
		display: block;
		margin-top: 0.4rem;
	}

	/* One row per stored image, built by ArtworkForm's script. */
	.console .image-row {
		display: grid;
		grid-template-columns: 5rem 1fr auto auto;
		gap: 1rem;
		align-items: center;
	}

	.console .image-thumb {
		width: 5rem;
		height: 5rem;
		object-fit: cover;
		border: 1px solid var(--admin-border-strong);
	}

	.console .link-button {
		font: inherit;
		min-height: 2.75rem;
		padding: 0.55rem 0.75rem;
		font-size: 0.875rem;
		color: var(--admin-muted);
		background: none;
		border: 0;
		cursor: pointer;
		transition: color 200ms;
	}

	.console .link-button:hover {
		color: var(--admin-accent);
	}

	.console a:not(.primary-button) {
		text-underline-offset: 0.2em;
	}

	/* Page alerts report a saved change whose follow-up step needs attention;
	   form errors use .error-banner. */
	.console [role="alert"]:not(.error-banner) {
		padding: 0.9rem 1rem;
		color: var(--admin-text);
		background: var(--admin-warning-soft);
		border-left: 4px solid var(--admin-warning);
	}

	.console [role="status"]:not(:empty) {
		color: var(--admin-text);
		padding: 0.75rem 1rem;
		background: var(--admin-accent-soft);
		border-left: 4px solid var(--admin-accent);
	}

	.console [role="alert"] a,
	.console [role="status"] a {
		color: inherit;
		font-weight: 600;
		text-decoration: underline;
	}
</style>

<style>
	.console {
		position: relative;
		min-height: calc(100vh - 4.5rem);
		margin-top: -4.5rem;
		padding: 4.5rem 0 6rem;
		color: var(--admin-text);
		background: var(--admin-bg);
	}

	.wrap {
		width: min(88rem, 100%);
		margin: 0 auto;
		padding: 0 clamp(1rem, 4vw, 3.5rem);
	}

	.masthead {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		padding: clamp(2rem, 5vw, 3.5rem) 0 1.5rem;
		border-bottom: 1px solid var(--admin-border);
	}

	.eyebrow,
	.back {
		display: inline-block;
		margin: 0 0 0.75rem;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--admin-accent);
	}

	.back {
		letter-spacing: normal;
		transition: color 200ms;
	}

	.back:hover {
		color: var(--admin-text);
	}

	.title {
		margin: 0;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.05;
		letter-spacing: -0.025em;
	}

	.identity {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		font-size: 0.875rem;
	}

	.theme {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.theme select {
		min-height: 2.75rem;
		padding: 0.5rem 0.75rem;
		font: inherit;
		font-size: 1rem;
		font-weight: normal;
		color: var(--admin-text);
		background: var(--admin-surface);
		border: 1px solid var(--admin-border-strong);
		border-radius: 0.35rem;
	}

	.email {
		color: var(--admin-muted);
	}

	.signout {
		min-height: 2.75rem;
		padding: 0.55rem 1rem;
		border: 1px solid var(--admin-border-strong);
		border-radius: 0.35rem;
		color: var(--admin-text);
		transition: border-color 200ms, color 200ms;
	}

	.signout:hover {
		border-color: var(--admin-accent);
		color: var(--admin-accent-hover);
	}
</style>

<script>
	document.querySelector('[data-sign-out]')?.addEventListener('click', async () => {
		const response = await fetch('/api/auth/sign-out', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
		if (response.ok) location.assign('/');
		else alert('Sign out failed. Please try again.');
	});
</script>
