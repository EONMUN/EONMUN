---
// Shared admin navigation and workspace; pages supply their own sections.
import AdminLayout from '../../layouts/AdminLayout.astro';

interface Props {
	title: string;
	eyebrow?: string;
	heading: string;
	email?: string;
	description?: string;
	backHref?: string;
	backLabel?: string;
	privateData?: boolean;
}

const {
	title,
	eyebrow = 'Studio console',
	heading,
	email,
	description = 'EONMUN studio console.',
	backHref,
	backLabel,
	privateData = false,
} = Astro.props;
const links = [
	{ href: '/admin', label: 'Overview' },
	{ href: '/admin/artworks', label: 'Artwork' },
	{ href: '/admin/collections', label: 'Collections' },
	{ href: '/admin/orders', label: 'Orders' },
	{ href: '/admin/settings', label: 'Settings' },
];
const path = Astro.url.pathname.replace(/\/$/, '');
const active = (href: string) => href === '/admin' ? path === href : path === href || path.startsWith(`${href}/`);
---
<AdminLayout title={title} description={description} privateData={privateData}>
	{email && <script is:inline>
		// This shell is rendered after server-side admin authorization.
		if (window.matchMedia('(display-mode: standalone)').matches || navigator.standalone === true) {
			try { localStorage.setItem('eonmun.pwa.admin-start', '1'); } catch {}
		}
	</script>}
	<div class="console">
		<a class="skip-link" href="#console-content">Skip to content</a>
		<aside class="sidebar" aria-label="Studio sidebar">
			<a class="brand" href="/admin">EONMUN <span>Studio</span></a>
			<nav aria-label="Admin navigation">
				{links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
			</nav>
			<a class="website" href="/">View website ↗</a>
		</aside>
		<div class="workspace">
			<header class="topbar">
				<button class="menu-button" type="button" data-open-navigation disabled aria-haspopup="dialog" aria-controls="mobile-navigation">Menu</button>
				<nav class="breadcrumb" aria-label="Breadcrumb">
					{backHref && <><a href={backHref}>{backLabel ?? 'Back'}</a><span aria-hidden="true">/</span></>}
					<span aria-current="page">{heading}</span>
				</nav>
				<details class="account">
					<summary>Account</summary>
					<div class="account-panel">
						<label class="theme" for="admin-theme">Theme</label>
						<select id="admin-theme" data-admin-theme-picker>
							<option value="system">System</option>
							<option value="light">Light</option>
							<option value="dark">Dark</option>
						</select>
						{email && <button class="signout" type="button" data-sign-out>Sign out</button>}
						<p class="account-error" role="alert" hidden></p>
					</div>
				</details>
			</header>
			<main class="wrap" id="console-content" tabindex="-1">
				<header class="masthead">
					<p class="eyebrow">{eyebrow}</p>
					<h1 class="title">{heading}</h1>
				</header>
				<slot />
			</main>
		</div>
		<dialog id="mobile-navigation" class="mobile-navigation" aria-label="Admin navigation">
			<div class="drawer-heading">
				<span class="brand">EONMUN <span>Studio</span></span>
				<button type="button" data-close-navigation aria-label="Close navigation">Close</button>
			</div>
			<nav aria-label="Mobile admin navigation">
				{links.map(link => <a href={link.href} aria-current={active(link.href) ? 'page' : undefined}>{link.label}</a>)}
			</nav>
			<a class="website" href="/">View website ↗</a>
		</dialog>
	</div>
</AdminLayout>

<style is:global>
	.console .secondary-button {
		min-height: 2.75rem;
		padding: .7rem 1.2rem;
		border: 1px solid var(--admin-border-strong);
		border-radius: .35rem;
		background: var(--admin-surface);
		color: var(--admin-text);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.console .secondary-button:hover {
		border-color: var(--admin-accent);
		color: var(--admin-accent-hover);
	}

	/* The framed surface a card sits in, shared by every card type so the
	   chrome cannot drift between them. */
	.console .frame {
		position: relative;
		display: block;
		overflow: hidden;
		background: var(--admin-surface);
		border: 1px solid var(--admin-border);
	}

	/* An empty frame is common for posts, which usually carry no cover.
	   Hatching reads as a prepared surface rather than a hole in the page. */
	.console .frame.is-empty {
		background-image: repeating-linear-gradient(-45deg, var(--admin-surface-muted) 0 1px, transparent 1px 9px);
	}

	.console a.card:hover .frame {
		border-color: var(--admin-accent);
	}

	.console .no-image {
		position: absolute;
		inset: 0;
		display: grid;
		place-items: center;
		font-size: 0.875rem;
		color: var(--admin-muted);
	}

	/* Form chrome is global rather than scoped because ArtworkForm builds its
	   image rows in a script, and script-created elements carry no scope id. */
	.console form {
		max-width: 56rem;
	}

	.console label {
		display: block;
		font-size: 0.875rem;
		font-weight: 600;
		color: var(--admin-muted);
	}

	.console .admin-input {
		display: block;
		width: 100%;
		margin-top: 0.5rem;
		min-height: 2.75rem;
		padding: 0.7rem 0.85rem;
		font: inherit;
		/* iOS zooms into any focused field set below 16px. */
		font-size: 1rem;
		font-weight: normal;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-text);
		background: var(--admin-surface);
		border: 1px solid var(--admin-border-strong);
		border-radius: 0.35rem;
		transition: border-color 200ms;
	}

	.console .admin-input:hover {
		border-color: var(--admin-text);
	}

	.console .admin-input:focus-visible {
		border-color: var(--admin-accent);
	}

	.console textarea.admin-input {
		min-height: 8rem;
		resize: vertical;
	}

	.console fieldset {
		margin: 0;
		padding: clamp(1rem, 2.5vw, 1.75rem);
		border: 1px solid var(--admin-border);
		background: var(--admin-surface);
	}

	.console legend {
		padding: 0 0.75rem;
		font-size: 0.875rem;
		font-weight: 700;
		color: var(--admin-accent);
	}

	/* A label wrapping a checkbox or radio reads as one line with its control;
	   a label wrapping a text field stacks above it. */
	.console label:has(input[type="checkbox"]),
	.console label:has(input[type="radio"]),
	.console .inline-label {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		font-size: 1rem;
		font-weight: normal;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-text);
	}

	.console input[type="checkbox"],
	.console input[type="radio"] {
		accent-color: var(--admin-accent);
		width: 1.15rem;
		height: 1.15rem;
		flex: none;
	}

	.console input[type="file"] {
		font-size: 0.875rem;
		font-weight: normal;
		color: var(--admin-muted);
		text-transform: none;
		letter-spacing: normal;
	}

	.console .primary-button {
		min-height: 2.75rem;
		padding: 0.75rem 1.4rem;
		font-size: 1rem;
	}

	.console .error-banner {
		padding: 0.9rem 1.1rem;
		font-size: 0.95rem;
		color: var(--admin-text);
		background: var(--admin-danger-soft);
		border: 1px solid var(--admin-danger);
	}

	/* A form mid-save (lib/admin-form-save.ts). Disabled fields keep their text
	   colour, so they stay readable in both themes; the muted fill shows the lock. */
	.console form[aria-busy="true"],
	.console form[aria-busy="true"] :disabled,
	.console form[aria-busy="true"] [aria-disabled="true"] {
		cursor: progress;
	}

	/* iOS Safari fades disabled controls through text fill and opacity, which
	   `color` alone does not override. */
	.console form[aria-busy="true"] :disabled {
		-webkit-text-fill-color: currentColor;
		opacity: 1;
	}

	.console form[aria-busy="true"] .admin-input {
		background: var(--admin-surface-muted);
	}

	.console form[aria-busy="true"] .primary-button:hover {
		background: var(--button-bg);
		color: var(--button-text);
	}

	.console .form-status {
		margin: 1rem 0 0;
	}

	/* WCAG 3.3.2: mark required fields visibly and say what the mark means once,
	   at the top of the form. The `required` attribute already carries the fact
	   to assistive technology, so the glyph is decorative. */
	.console .req {
		color: var(--admin-danger);
		font-size: 0.9em;
	}

	.console .required-note {
		font-size: 0.875rem;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-muted);
	}

	/* :user-invalid, not :invalid -- an empty required field is invalid from the
	   moment it renders, and flagging it before the user has touched it reads as
	   an error they have not made yet. */
	.console .admin-input:user-invalid {
		border-color: var(--admin-danger);
	}

	.console .hint {
		font-size: 0.875rem;
		font-weight: normal;
		letter-spacing: normal;
		text-transform: none;
		color: var(--admin-muted);
	}

	/* A hint inside a label sits under its control, not beside the label text. */
	.console label .hint {
		display: block;
		margin-top: 0.4rem;
	}

	/* One row per stored image, built by ArtworkForm's script. */
	.console .image-row {
		display: grid;
		grid-template-columns: 5rem 1fr auto auto;
		gap: 1rem;
		align-items: center;
	}

	.console .image-thumb {
		width: 5rem;
		height: 5rem;
		object-fit: cover;
		border: 1px solid var(--admin-border-strong);
	}

	.console .link-button {
		font: inherit;
		min-height: 2.75rem;
		padding: 0.55rem 0.75rem;
		font-size: 0.875rem;
		color: var(--admin-muted);
		background: none;
		border: 0;
		cursor: pointer;
		transition: color 200ms;
	}

	.console .link-button:hover {
		color: var(--admin-accent);
	}

	.console a:not(.primary-button) {
		text-underline-offset: 0.2em;
	}

	/* Page alerts report a saved change whose follow-up step needs attention;
	   form errors use .error-banner. */
	.console [role="alert"]:not(.error-banner) {
		padding: 0.9rem 1rem;
		color: var(--admin-text);
		background: var(--admin-warning-soft);
		border-left: 4px solid var(--admin-warning);
	}

	.console [role="status"]:not(:empty) {
		color: var(--admin-text);
		padding: 0.75rem 1rem;
		background: var(--admin-accent-soft);
		border-left: 4px solid var(--admin-accent);
	}

	.console [role="alert"] a,
	.console [role="status"] a {
		color: inherit;
		font-weight: 600;
		text-decoration: underline;
	}
</style>

<style>
	.console {
		min-height: 100dvh;
		color: var(--admin-text);
		background: var(--admin-bg);
	}
	.sidebar {
		overflow-y: auto;
		position: fixed;
		inset: 0 auto 0 0;
		width: 15rem;
		padding: 2rem 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		border-right: 1px solid var(--admin-border);
		background: var(--admin-surface);
	}
	.sidebar > * {
		flex-shrink: 0;
	}
	.brand {
		font-size: 1.15rem;
		font-weight: 700;
		letter-spacing: .08em;
	}
	.brand span {
		display: block;
		margin-top: .35rem;
		font-size: .75rem;
		font-weight: 500;
		letter-spacing: .04em;
		color: var(--admin-muted);
	}
	nav:not(.breadcrumb) {
		display: grid;
		gap: .35rem;
	}
	nav:not(.breadcrumb) a {
		padding: .8rem 1rem;
		border-radius: .45rem;
		font-weight: 500;
	}
	nav:not(.breadcrumb) a:hover {
		background: var(--admin-surface-muted);
	}
	nav:not(.breadcrumb) a[aria-current="page"] {
		background: var(--admin-accent-soft);
		color: var(--admin-accent);
		font-weight: 650;
	}
	.website {
		margin-top: auto;
		padding: .8rem 1rem;
		font-size: .875rem;
		color: var(--admin-muted);
	}
	.workspace {
		margin-left: 15rem;
		min-width: 0;
	}
	.topbar {
		position: sticky;
		top: 0;
		z-index: 20;
		display: flex;
		align-items: center;
		gap: 1rem;
		min-height: 4.5rem;
		padding: .75rem clamp(1rem, 3vw, 2.5rem);
		background: var(--admin-surface);
		border-bottom: 1px solid var(--admin-border);
	}
	.breadcrumb {
		display: flex;
		align-items: center;
		gap: .65rem;
		min-width: 0;
		font-size: .875rem;
		color: var(--admin-muted);
	}
	.breadcrumb [aria-current] {
		color: var(--admin-text);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.breadcrumb a {
		flex-shrink: 0;
	}
	.account {
		margin-left: auto;
		position: relative;
		flex-shrink: 0;
	}
	summary, .menu-button, .signout, .drawer-heading button {
		min-height: 2.75rem;
		padding: .6rem .85rem;
		border: 1px solid var(--admin-border);
		border-radius: .45rem;
		font: inherit;
		font-size: .875rem;
		background: var(--admin-surface);
		cursor: pointer;
	}
	summary {
		display: block;
		list-style: none;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: ' ▾';
	}
	.account-panel {
		position: absolute;
		right: 0;
		top: calc(100% + .5rem);
		width: 15rem;
		padding: 1rem;
		display: grid;
		gap: 1rem;
		border: 1px solid var(--admin-border);
		border-radius: .6rem;
		background: var(--admin-surface);
		box-shadow: 0 .5rem 1.5rem #0002;
	}
	.account-panel select {
		display: block;
		margin-top: .5rem;
		width: 100%;
		min-height: 2.75rem;
		padding: .5rem;
		font: inherit;
		font-size: 1rem;
		border: 1px solid var(--admin-border-strong);
		border-radius: .35rem;
		background: var(--admin-surface);
		color: var(--admin-text);
	}
	.account-error {
		font-size: .875rem;
	}
	.account-error[hidden] {
		display: none;
	}
	.wrap {
		width: min(88rem, 100%);
		margin: 0 auto;
		padding: 2rem clamp(1rem, 3vw, 2.5rem) 5rem;
	}
	.masthead {
		margin-bottom: 2rem;
	}
	.eyebrow {
		margin: 0 0 .5rem;
		font-size: .75rem;
		font-weight: 600;
		color: var(--admin-muted);
	}
	.title {
		margin: 0;
		font-size: clamp(1.75rem, 3vw, 2.5rem);
		line-height: 1.2;
		letter-spacing: -.025em;
		overflow-wrap: anywhere;
	}
	.menu-button {
		display: none;
	}
	.skip-link {
		position: fixed;
		top: .5rem;
		left: .5rem;
		z-index: 50;
		padding: .75rem;
		background: var(--admin-surface);
		transform: translateY(-200%);
	}
	.skip-link:focus {
		transform: none;
	}
	.mobile-navigation {
		position: fixed;
		inset: 0 auto 0 0;
		margin: 0;
		width: min(20rem, 90vw);
		max-width: none;
		max-height: none;
		height: 100dvh;
		padding: 1.5rem;
		border: 0;
		border-right: 1px solid var(--admin-border);
		background: var(--admin-surface);
		color: var(--admin-text);
	}
	.mobile-navigation::backdrop {
		background: #0007;
	}
	.drawer-heading {
		display: flex;
		justify-content: space-between;
		align-items: center;
		margin-bottom: 2rem;
		gap: 1rem;
	}
	.mobile-navigation .website {
		display: block;
		margin-top: 2rem;
	}
	@media (max-width: 1023px) {
		.sidebar {
			display: none;
		}
		.workspace {
			margin-left: 0;
		}
		.menu-button {
			display: block;
		}
		.breadcrumb a, .breadcrumb > span[aria-hidden] {
			display: none;
		}
		.topbar {
			gap: .65rem;
		}
	}
</style>
<script>
	const drawer = document.querySelector<HTMLDialogElement>('#mobile-navigation');
	const opener = document.querySelector<HTMLButtonElement>('[data-open-navigation]');
	opener?.addEventListener('click', () => {
		drawer?.showModal();
		document.body.style.overflow = 'hidden';
	});
	document.querySelector('[data-close-navigation]')?.addEventListener('click', () => drawer?.close());
	if (opener) opener.disabled = false;
	drawer?.addEventListener('click', event => { if (event.target === drawer && event.clientX > drawer.getBoundingClientRect().right) drawer.close(); });
	drawer?.addEventListener('keydown', event => {
		if (event.key !== 'Tab') return;
		const controls = Array.from(drawer.querySelectorAll<HTMLElement>('button, a[href]'));
		const first = controls[0];
		const last = controls.at(-1);
		if (event.shiftKey && document.activeElement === first) {
			event.preventDefault();
			last?.focus();
		} else if (!event.shiftKey && document.activeElement === last) {
			event.preventDefault();
			first?.focus();
		}
	});
	drawer?.addEventListener('close', () => { document.body.style.overflow = ''; opener?.focus(); });
	window.matchMedia('(min-width: 1024px)').addEventListener('change', event => { if (event.matches) drawer?.close(); });
	const account = document.querySelector<HTMLDetailsElement>('.account');
	document.addEventListener('keydown', event => { if (event.key === 'Escape' && account?.open) { account.open = false; account.querySelector('summary')?.focus(); } });
	document.addEventListener('click', event => { if (event.target instanceof Node && account?.open && !account.contains(event.target)) account.open = false; });
	document.querySelector<HTMLButtonElement>('[data-sign-out]')?.addEventListener('click', async event => {
		const button = event.currentTarget as HTMLButtonElement;
		const error = document.querySelector<HTMLElement>('.account-error');
		button.disabled = true;
		if (error) error.hidden = true;
		try {
			const response = await fetch('/api/auth/sign-out', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
			if (!response.ok) throw new Error('Sign out failed');
			location.assign('/');
		} catch {
			if (error) { error.textContent = 'Sign out failed. Please try again.'; error.hidden = false; }
			button.disabled = false;
		}
	});
</script>
