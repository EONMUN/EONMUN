---
import ErrorBanner from './ErrorBanner.astro';
import RequiredMark from './RequiredMark.astro';
import RequiredNote from './RequiredNote.astro';
import FormFieldset from './FormFieldset.astro';
import SubmitButton from './SubmitButton.astro';
import type { SelectArtwork, SelectArtworkImage, SelectCollection, SelectFacet, SelectProduct } from '../../db';

interface Props {
	action: string;
	artwork?: SelectArtwork & { images: SelectArtworkImage[]; collectionIds: number[]; facetIds: number[]; tags: string[]; product: SelectProduct | null };
	collections: SelectCollection[];
	facets: SelectFacet[];
}

const { action, artwork, collections, facets } = Astro.props;
const images = artwork?.images.map(({ url, caption, altText, isDefault }) => ({ url, caption, altText, isDefault })) ?? [];
---
<form data-admin-artwork-form data-action={action} data-images={JSON.stringify(images)}>
	<ErrorBanner />
	<RequiredNote />

	<FormFieldset legend="Piece" layout="columns">
		<label>Title <RequiredMark /> <input class="admin-input" name="title" required value={artwork?.title ?? ''} /></label>
		<label>Slug <RequiredMark />
			<input
				class="admin-input"
				name="slug"
				required
				pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
				title="Lowercase letters, numbers, and single hyphens between them."
				aria-describedby="slug-format"
				value={artwork?.slug ?? ''}
			/>
			<span id="slug-format" class="hint" aria-hidden="true">Lowercase letters, numbers, and hyphens. It becomes the page address.</span>
		</label>
		<label>Artist <input class="admin-input" name="artist" value={artwork?.artist ?? 'EONMUN'} /></label>
		<label>Year <input class="admin-input" name="year" type="number" min="1000" max="9999" value={artwork?.year ?? ''} /></label>
		<label class="span-all">Description <textarea class="admin-input" name="description">{artwork?.description ?? ''}</textarea></label>
		<label class="span-all">Tags <input class="admin-input" name="tags" value={artwork?.tags.join(', ') ?? ''} aria-describedby="tags-hint" /></label>
		<p class="hint span-all" id="tags-hint">Separate tags with commas.</p>
	</FormFieldset>

	<FormFieldset legend="Other facets">
		<p class="hint">Select existing attributes or add one for this artwork. For measurements, use width, height, or depth with a numeric value, and dimension-unit with in or cm. Uncheck an old measurement before adding its replacement. Size and orientation are calculated from width and height.</p>
		<div class="collection-list">
			{facets.filter((facet) => !(facet.namespace === 'artwork' && facet.key === 'tag')).map((facet) => (
				<label><input type="checkbox" name="facetIds" value={facet.id} checked={artwork?.facetIds.includes(facet.id)} /> {facet.namespace === 'artwork' ? '' : facet.namespace + '/'}{facet.key}: {facet.value}</label>
			))}
		</div>
		<div class="new-collection-row">
			<input class="admin-input" data-new-facet-namespace aria-label="Facet namespace" value="artwork" placeholder="Namespace" />
			<input class="admin-input" data-new-facet-key aria-label="Facet key" list="facet-keys" placeholder="Key, e.g. material" />
			<datalist id="facet-keys">
				{[...new Set(['width', 'height', 'depth', 'dimension-unit', 'material', 'support', 'medium', 'style', 'subject', 'color', ...facets.map((facet) => facet.key)])].filter((key) => key !== 'tag').map((key) => <option value={key} />)}
			</datalist>
			<input class="admin-input" data-new-facet-value aria-label="Facet value" placeholder="Value, e.g. Watercolor" />
			<button type="button" class="add-collection" data-add-facet>Add facet</button>
		</div>
		<div data-new-facet-list class="collection-list"></div>
	</FormFieldset>

	<FormFieldset legend="Writing assistant">
		<p class="hint">Add a cover image and title, then ask for a description, tags, and cover image alt text. Suggestions stay in this editor until you apply and save them.</p>
		<label>What should the assistant focus on? <textarea class="admin-input" name="aiInstructions" placeholder="For example: emphasize the warm colors and quiet mood"></textarea></label>
		<button type="button" class="add-collection" data-suggest>Suggest copy</button>
		<p class="hint" data-suggest-status role="status" aria-live="polite"></p>
		<div data-suggestion hidden>
			<label>Suggested description <textarea class="admin-input" data-suggest-description></textarea></label>
			<label>Suggested tags <input class="admin-input" data-suggest-tags /></label>
			<label>Suggested cover image alt text <textarea class="admin-input" data-suggest-alt></textarea></label>
			<button type="button" class="add-collection" data-apply-suggestion>Use these suggestions</button>
		</div>
	</FormFieldset>

	<FormFieldset legend="Images">
		<label class="upload">Add images
			<input class="admin-input" name="imageFiles" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
		</label>
		<p class="hint">JPEG, PNG, WebP, GIF, or AVIF. Maximum 10 MB each. The piece marked Default is the cover shown everywhere else.</p>
		<div data-image-list class="image-list"></div>
	</FormFieldset>

	<FormFieldset legend="Collections">
		<div class="collection-list" data-collection-list>
			{collections.length === 0 ? (
				<p class="hint" data-collection-empty>No collections yet.</p>
			) : (
				collections.map((collection) => (
					<label><input type="checkbox" name="collectionIds" value={collection.id} checked={artwork?.collectionIds.includes(collection.id)} /> {collection.name}</label>
				))
			)}
		</div>
		<div class="new-collection">
			<label for="new-collection-name">New collection</label>
			<div class="new-collection-row">
				<input
					class="admin-input"
					id="new-collection-name"
					type="text"
					autocomplete="off"
					placeholder="Collection name"
					data-new-collection-name
				/>
				<button type="button" class="add-collection" data-new-collection-add>+ New</button>
			</div>
			<p id="new-collection-status" class="hint" role="status" aria-live="polite" data-new-collection-status></p>
		</div>
	</FormFieldset>

	<FormFieldset legend="Sale">
		<label class="inline-label"><input type="checkbox" name="available" checked={(artwork?.product?.quantity ?? 0) > 0 && artwork?.product?.soldAt === null} /> Available for purchase</label>
		<label>Price (USD)
			<input
				class="admin-input"
				name="priceDollars"
				type="number"
				min="0.01"
				step="0.01"
				aria-describedby="price-note"
				value={artwork?.product?.price == null ? '' : (artwork.product.price / 100).toFixed(2)}
			/>
		</label>
		<p id="price-note" class="hint">Required when the piece is available for purchase. The price appears publicly only while the piece is available.</p>
	</FormFieldset>

	{artwork ? (
		<label class="inline-label"><input type="checkbox" name="published" checked={artwork.publishedAt !== null} /> Published</label>
	) : (
		<p class="hint">A new artwork is saved as a draft.</p>
	)}

	<SubmitButton label="Save artwork" />
</form>

<script is:inline>
	const form = document.querySelector('[data-admin-artwork-form]');
	if (form) {
		let images = JSON.parse(form.dataset.images || '[]');
		const newFacets = [];
		const list = form.querySelector('[data-image-list]');
		const errorBox = form.querySelector('[data-error]');
		const showError = (message) => { errorBox.hidden = false; errorBox.textContent = message; };
		// parseArtworkInput rejects an available piece with no price. Mirror that
		// here so the requirement is caught before a round trip, and so the field
		// is only marked required while it actually is.
		const available = form.elements.available;
		const price = form.elements.priceDollars;
		const syncPriceRequirement = () => { price.required = available.checked; };
		available.addEventListener('change', syncPriceRequirement);
		syncPriceRequirement();

		const renderImages = () => {
			list.replaceChildren();
			images.forEach((image, index) => {
				const row = document.createElement('div');
				row.className = 'image-row';
				const preview = document.createElement('img'); preview.src = image.url; preview.alt = ''; preview.className = 'image-thumb';
				const caption = document.createElement('input'); caption.className = 'admin-input'; caption.placeholder = 'Caption (optional)'; caption.value = image.caption || '';
				caption.addEventListener('input', () => { image.caption = caption.value || null; });
				const alt = document.createElement('input'); alt.className = 'admin-input'; alt.placeholder = 'Describe this image for alt text'; alt.setAttribute('aria-label', 'Image alt text'); alt.value = image.altText || '';
				alt.addEventListener('input', () => { image.altText = alt.value || null; });
				const label = document.createElement('label'); const radio = document.createElement('input'); radio.type = 'radio'; radio.name = 'defaultImage'; radio.checked = image.isDefault;
				radio.addEventListener('change', () => { images.forEach((entry, i) => entry.isDefault = i === index); renderImages(); });
				label.append(radio, ' Default');
				const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Remove'; remove.className = 'link-button';
				remove.addEventListener('click', () => { images.splice(index, 1); if (images.length && !images.some((entry) => entry.isDefault)) images[0].isDefault = true; renderImages(); });
				row.append(preview, alt, caption, label, remove); list.append(row);
			});
		};
		const uploadSelected = async () => {
			const input = form.elements.imageFiles;
			if (!input.files.length) return;
			const body = new FormData();
			for (const file of input.files) body.append('images', file);
			const response = await fetch('/api/admin/media', { method: 'POST', body });
			const payload = await response.json();
			if (!response.ok) throw new Error(payload.error || 'Upload failed');
			for (const uploaded of payload.images) images.push({ url: uploaded.url, caption: null, altText: null, isDefault: images.length === 0 });
			input.value = ''; renderImages();
		};
		const suggest = form.querySelector('[data-suggest]');
		const suggestion = form.querySelector('[data-suggestion]');
		const status = form.querySelector('[data-suggest-status]');
		const newFacetList = form.querySelector('[data-new-facet-list]');
		const renderNewFacets = () => newFacetList.replaceChildren(...newFacets.map((facet, index) => {
			const row = document.createElement('span'); row.textContent = `${facet.namespace}/${facet.key}: ${facet.value} `;
			const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Remove'; remove.className = 'link-button';
			remove.addEventListener('click', () => { newFacets.splice(index, 1); renderNewFacets(); });
			row.append(remove); return row;
		}));
		form.querySelector('[data-add-facet]').addEventListener('click', () => {
			const namespace = form.querySelector('[data-new-facet-namespace]').value.trim();
			const key = form.querySelector('[data-new-facet-key]').value.trim();
			const valueInput = form.querySelector('[data-new-facet-value]');
			const value = valueInput.value.trim();
			if (!namespace || !key || !value) return;
			if (!newFacets.some((facet) => facet.namespace === namespace && facet.key === key && facet.value.toLowerCase() === value.toLowerCase())) newFacets.push({ namespace, key, value });
			valueInput.value = '';
			renderNewFacets();
		});
		let suggestedCoverUrl = null;
		suggest.addEventListener('click', async () => {
			if (suggest.disabled) return;
			suggest.disabled = true; status.textContent = 'Generating suggestions…'; suggestion.hidden = true;
			try {
				await uploadSelected();
				const cover = images.find((image) => image.isDefault) || images[0];
				if (!cover) throw new Error('Add a cover image first.');
				const response = await fetch('/api/admin/artworks/suggest', {
					method: 'POST', headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ title: form.elements.title.value, artist: form.elements.artist.value, year: form.elements.year.value, description: form.elements.description.value, instructions: form.elements.aiInstructions.value, images: [{ url: cover.url, altText: cover.altText }] }),
				});
				const payload = await response.json();
				if (!response.ok) throw new Error(payload.error || 'Suggestions failed');
				form.querySelector('[data-suggest-description]').value = payload.suggestion.description;
				form.querySelector('[data-suggest-tags]').value = payload.suggestion.tags.join(', ');
				form.querySelector('[data-suggest-alt]').value = payload.suggestion.altText;
				suggestedCoverUrl = cover.url;
				suggestion.hidden = false; status.textContent = 'Review and edit the suggestions, then apply them.';
			} catch (error) { status.textContent = error instanceof Error ? error.message : 'Suggestions failed'; }
			finally { suggest.disabled = false; }
		});
		form.querySelector('[data-apply-suggestion]').addEventListener('click', () => {
			const cover = images.find((image) => image.url === suggestedCoverUrl);
			if (!cover) { status.textContent = 'The cover image changed. Generate fresh suggestions.'; return; }
			form.elements.description.value = form.querySelector('[data-suggest-description]').value;
			form.elements.tags.value = form.querySelector('[data-suggest-tags]').value;
			cover.altText = form.querySelector('[data-suggest-alt]').value || null;
			renderImages(); suggestion.hidden = true; status.textContent = 'Suggestions applied. Review the fields and save when ready.';
		});
		form.addEventListener('submit', async (event) => {
			event.preventDefault(); errorBox.hidden = true;
			try {
				await uploadSelected();
				const data = new FormData(form);
				const payload = Object.fromEntries(data);
				payload.published = data.has('published'); payload.available = data.has('available');
				payload.priceCents = price.value === '' ? '' : Math.round(Number(price.value) * 100);
				delete payload.priceDollars;
				payload.tags = form.elements.tags.value.split(',').map((tag) => tag.trim()).filter(Boolean);
				payload.facetIds = data.getAll('facetIds').map(Number); payload.newFacets = newFacets;
				payload.collectionIds = data.getAll('collectionIds').map(Number); payload.images = images;
				delete payload.imageFiles; delete payload.defaultImage; delete payload.aiInstructions;
				const response = await fetch(form.dataset.action, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(payload) });
				const result = await response.json();
				if (!response.ok) throw new Error(result.error || 'Save failed');
				window.location.assign(result.redirect);
			} catch (error) { showError(error instanceof Error ? error.message : 'Save failed'); }
		});
		renderImages();
	}
</script>

<script>
	// Bundled, not `is:inline`: an inline script cannot import, and the inline
	// collection creator is covered by a test that imports the same module.
	import { attachInlineCollectionCreator } from '../../lib/inline-collection-creator';

	const artworkForm = document.querySelector('[data-admin-artwork-form]');
	if (artworkForm instanceof HTMLFormElement) attachInlineCollectionCreator(artworkForm);
</script>

<style>
	form {
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
		margin-top: 2.5rem;
	}

	.span-all {
		grid-column: 1 / -1;
	}

	/* Matches FormFieldset's `columns` layout. The checkboxes need a container of
	   their own so the script has one insertion point on both the populated and
	   the empty state. */
	.collection-list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
		gap: 1rem;
	}

	.new-collection-row {
		display: flex;
		align-items: stretch;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}

	.new-collection-row .admin-input {
		margin-top: 0;
	}

	.add-collection {
		flex: none;
		padding: 0 1.1rem;
		font: inherit;
		font-size: 0.72rem;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		white-space: nowrap;
		color: var(--paper);
		background: transparent;
		/* A control boundary owes 3:1 against the console ground; --hair does not
		   reach it. */
		border: 1px solid rgba(236, 231, 221, 0.45);
		cursor: pointer;
		transition: background 200ms, border-color 200ms, color 200ms;
	}

	.add-collection:hover:not([aria-disabled='true']) {
		background: var(--seal-fill);
		border-color: var(--seal-fill);
	}

	/* The in-flight state is `aria-disabled`, not `disabled`, so the button keeps
	   its place in the focus order. The handler refuses the second activation. */
	.add-collection[aria-disabled='true'] {
		color: var(--muted);
		cursor: progress;
	}

	/* The live region stays in the layout at all times. A region that is hidden
	   until it has text is not reliably announced when the text arrives. */
	.new-collection .hint {
		min-height: 1.2em;
		margin-top: 0.5rem;
	}

	.new-collection .hint.is-error {
		color: var(--seal-text);
	}

	.image-list {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.image-list:empty::after {
		content: 'No images yet.';
		font-size: 0.8rem;
		color: var(--muted);
	}

	.upload :global(.admin-input) {
		padding: 0.6rem 0;
		background: none;
		border: 0;
	}
</style>
