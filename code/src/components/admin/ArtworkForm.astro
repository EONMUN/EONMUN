---
import { artworkAttributes, type ArtworkFacet } from '../../lib/artwork-facets';
import ErrorBanner from './ErrorBanner.astro';
import FacetPicker from './FacetPicker.astro';
import FormFieldset from './FormFieldset.astro';
import type { SelectArtwork, SelectArtworkImage, SelectCollection, SelectFacet, SelectProduct } from '../../db';

interface Props {
	action: string;
	artwork?: SelectArtwork & { images: SelectArtworkImage[]; collectionIds: number[]; attributes: ArtworkFacet[]; tags: string[]; product: SelectProduct | null };
	collections: SelectCollection[];
	facets: SelectFacet[];
}

const { action, artwork, collections, facets } = Astro.props;
const values = (key: string) => artwork?.attributes.filter(f => f.namespace === 'artwork' && f.key === key).map(f => f.value) ?? [];
const options = (key: string) => [...new Set(facets.filter(f => f.namespace === 'artwork' && f.key === key).map(f => f.value))].sort();
const images = artwork?.images.map(({ url, caption, altText, isDefault }) => ({ url, caption, altText, isDefault })) ?? [];
---
<form id="artwork-editor" data-admin-artwork-form data-action={action} data-images={JSON.stringify(images)} data-attributes={JSON.stringify(artworkAttributes.map(field => field.name))}>
	<ErrorBanner />
	<div class="editor-columns"><div class="editor-main">


	<FormFieldset legend="Piece" layout="columns">
		<label>Title <span class="hint">Required</span> <input class="admin-input" name="title" aria-label="Title" required value={artwork?.title ?? ''} /></label>
		<label>Slug {artwork && <span class="hint">Required</span>}
			<input
				class="admin-input"
				name="slug" aria-label="Slug"
				required={Boolean(artwork)}
				pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
				title="Lowercase letters, numbers, and single hyphens between them."
				aria-describedby="slug-format"
				value={artwork?.slug ?? ''}
			/>
			<span id="slug-format" class="hint" aria-hidden="true">{artwork ? 'Lowercase letters, numbers, and hyphens. It becomes the page address.' : 'Leave blank to generate from the title, or enter lowercase letters, numbers, and hyphens.'}</span>
		</label>
		<label>Artist <input class="admin-input" name="artist" value={artwork?.artist ?? 'EONMUN'} /></label>
		<label>Year <input class="admin-input" name="year" type="number" min="1000" max="9999" value={artwork?.year ?? ''} /></label>
		<label class="span-all">Description <textarea class="admin-input" name="description">{artwork?.description ?? ''}</textarea></label>

	</FormFieldset>

	<details class="writing-assistant"><summary>Suggest copy</summary><FormFieldset legend="Writing assistant">
		<p class="hint">Add a cover image and title, then ask for a description, tags, and cover image alt text. Suggestions stay in this editor until you apply and save them.</p>
		<label>What should the assistant focus on? <textarea class="admin-input" name="aiInstructions" placeholder="For example: emphasize the warm colors and quiet mood"></textarea></label>
		<button type="button" class="add-collection" data-suggest>Suggest copy</button>
		<p class="hint" data-suggest-status role="status" aria-live="polite"></p>
		<div data-suggestion hidden>
			<label>Suggested description <textarea class="admin-input" data-suggest-description></textarea></label>
			<label>Suggested tags <input class="admin-input" data-suggest-tags /></label>
			<label>Suggested cover image alt text <textarea class="admin-input" data-suggest-alt></textarea></label>
			<button type="button" class="add-collection" data-apply-suggestion>Use these suggestions</button>
		</div>
	</FormFieldset></details>

	<FormFieldset legend="Images">
		<div data-image-list class="image-list"></div>
		<label class="upload">Add images
			<input class="admin-input" name="imageFiles" type="file" accept="image/jpeg,image/png,image/webp,image/gif,image/avif" multiple />
		</label>
		<p class="hint">JPEG, PNG, WebP, GIF, or AVIF. Maximum 10 MB each. The image marked Cover is the cover shown everywhere else.</p>
	</FormFieldset>


    <FormFieldset legend="Dimensions" layout="columns">
        <p class="hint span-all">Physical measurements of the artwork. Leave unknown measurements blank.</p>
        <label>Width <input class="admin-input" name="width" type="number" min="0" step="any" value={artwork?.width ?? ''} /></label>
        <label>Height <input class="admin-input" name="height" type="number" min="0" step="any" value={artwork?.height ?? ''} /></label>
        <label>Depth <input class="admin-input" name="depth" type="number" min="0" step="any" value={artwork?.depth ?? ''} /></label>
        <label>Unit <select class="admin-input" name="dimensionUnit"><option value="in" selected={artwork?.dimensionUnit !== 'cm'}>Inches</option><option value="cm" selected={artwork?.dimensionUnit === 'cm'}>Centimeters</option></select></label>
        <label>Orientation <select class="admin-input" name="orientation"><option value="">Not specified</option>{[...new Set([...values('orientation'), 'Portrait','Landscape','Square'])].map(value => <option value={value} selected={values('orientation').includes(value)}>{value}</option>)}</select></label>
        <p class="hint span-all" data-dimension-summary>Orientation is calculated when width and height are known.</p>
    </FormFieldset>

    <FormFieldset legend="Attributes" layout="columns">
        <a class="span-all" href="/admin/facets">Manage facets →</a>
        {artworkAttributes.map(({name,key,label}) => <FacetPicker name={name} label={label} values={values(key)} options={options(key)} />)}
        <FacetPicker name="tags" label="Tags" values={artwork?.tags ?? []} options={options('tag')} />
    </FormFieldset>


	</div><aside class="editor-sidebar">
	<FormFieldset legend="Collections">
		<div class="collection-list" data-collection-list>
			{collections.length === 0 ? (
				<p class="hint" data-collection-empty>No collections yet.</p>
			) : (
				collections.map((collection) => (
					<label><input type="checkbox" name="collectionIds" value={collection.id} checked={artwork?.collectionIds.includes(collection.id)} /> {collection.name}</label>
				))
			)}
		</div>
		<div class="new-collection">
			<label for="new-collection-name">New collection</label>
			<div class="new-collection-row">
				<input
					class="admin-input"
					id="new-collection-name"
					type="text"
					autocomplete="off"
					placeholder="Collection name"
					data-new-collection-name
				/>
				<button type="button" class="add-collection" data-new-collection-add>+ New</button>
			</div>
			<p id="new-collection-status" class="hint" role="status" aria-live="polite" data-new-collection-status></p>
		</div>
	</FormFieldset>

	<FormFieldset legend="Sale">
		<label class="inline-label"><input type="checkbox" name="available" checked={(artwork?.product?.quantity ?? 0) > 0 && artwork?.product?.soldAt === null} /> Available for purchase</label>
		<label>Price (USD)
			<input
				class="admin-input"
				name="priceDollars"
				type="number"
				min="0.01"
				step="0.01"
				aria-describedby="price-note"
				value={artwork?.product?.price == null ? '' : (artwork.product.price / 100).toFixed(2)}
			/>
		</label>
		<p id="price-note" class="hint">Required when the piece is available for purchase. The price appears publicly only while the piece is available.</p>
	</FormFieldset>

    <slot name="listings" />
    </aside></div>
</form>
    <div class="editor-actions">
        <p class="hint" data-editor-dirty role="status"></p>
        <p class="hint" data-editor-save role="status" aria-live="polite"></p>
        {artwork ? <label>Publication <select class="admin-input" name="published" form="artwork-editor"><option value="draft" selected={artwork.publishedAt === null}>Draft</option><option value="published" selected={artwork.publishedAt !== null}>Published</option></select></label> : <p class="hint">A new artwork is saved as a draft.</p>}
        <button type="submit" form="artwork-editor" class="primary-button">{artwork ? 'Save artwork' : 'Save draft'}</button>
    </div>

<script>
	// Bundled, not `is:inline`: an inline script cannot import, and the inline
	// collection creator is covered by a test that imports the same module.
	import { attachAdminFormSave, attachUnsavedChanges, postAdminJson } from '../../lib/admin-form-save';
	import { attachInlineCollectionCreator } from '../../lib/inline-collection-creator';

	import { attachFacetPickers, setFacetValues } from '../../lib/facet-picker';
	type EditorImage = { url: string; caption: string | null; altText: string | null; isDefault: boolean };

	const form = document.querySelector<HTMLFormElement>('[data-admin-artwork-form]');
	if (form) {
		const field = <T extends Element = HTMLInputElement>(name: string) => form.elements.namedItem(name) as unknown as T;
		attachFacetPickers(form);
		const dirty = attachUnsavedChanges(form, document.querySelector<HTMLElement>('[data-editor-dirty]')!);
		new MutationObserver(() => dirty.mark()).observe(form.querySelector('[data-collection-list]')!, { childList: true });
		let selectedImage = 0;
		const images: EditorImage[] = JSON.parse(form.dataset.images || '[]');
		const attributeNames: string[] = JSON.parse(form.dataset.attributes || '[]');
		const list = form.querySelector<HTMLElement>('[data-image-list]')!;
		const fileInput = field('imageFiles');
		// parseArtworkInput rejects an available piece with no price. Mirror that
		// here so the requirement is caught before a round trip, and so the field
		// is only marked required while it actually is.
		const available = field('available');
		const price = field('priceDollars');
		const syncPriceRequirement = () => { price.required = available.checked; };
		available.addEventListener('change', syncPriceRequirement);
		syncPriceRequirement();

		const renderImages = () => {
			list.replaceChildren();
			let selectedDetails: HTMLElement | undefined;
			images.map((image, index) => ({ image, index })).sort((a, b) => Number(b.image.isDefault) - Number(a.image.isDefault)).forEach(({ image, index }) => {
				const row = document.createElement('div');
				row.className = 'artwork-image-row';
				const select = document.createElement('button'); select.type = 'button'; select.className = 'image-tile'; select.setAttribute('aria-label', `Edit image ${index + 1}${image.isDefault ? ', cover' : ''}`); select.setAttribute('aria-pressed', String(selectedImage === index));
				select.addEventListener('click', () => { selectedImage = index; renderImages(); });
				const preview = document.createElement('img'); preview.src = image.url; preview.alt = image.altText || ''; preview.className = 'artwork-image-preview';
				const caption = document.createElement('input'); caption.className = 'admin-input'; caption.placeholder = 'Caption (optional)'; caption.value = image.caption || '';
				caption.addEventListener('input', () => { image.caption = caption.value || null; dirty.mark(); });
				const alt = document.createElement('textarea'); alt.rows = 4; alt.className = 'admin-input'; alt.placeholder = 'Describe this image for alt text'; alt.setAttribute('aria-label', 'Image alt text'); alt.value = image.altText || '';
				alt.addEventListener('input', () => { image.altText = alt.value || null; preview.alt = alt.value; dirty.mark(); });
				const label = document.createElement('label'); const radio = document.createElement('input'); radio.type = 'radio'; radio.name = 'defaultImage'; radio.checked = image.isDefault;
				radio.addEventListener('change', () => { images.forEach((entry, i) => entry.isDefault = i === index); dirty.mark(); renderImages(); });
				label.append(radio, ' Cover image');
				const remove = document.createElement('button'); remove.type = 'button'; remove.textContent = 'Remove'; remove.className = 'link-button';
				remove.addEventListener('click', () => { images.splice(index, 1); selectedImage = Math.min(selectedImage, images.length - 1); dirty.mark(); if (images.length && !images.some((entry) => entry.isDefault)) images[0].isDefault = true; renderImages(); });
				const details = document.createElement('div'); details.className = 'artwork-image-details';
				const altLabel = document.createElement('label'); altLabel.append('Alt text', alt);
				const altHint = document.createElement('p'); altHint.className = 'hint'; altHint.textContent = 'Describe the artwork for people using screen readers.';
				const captionLabel = document.createElement('label'); captionLabel.append('Caption (optional)', caption);
				const actions = document.createElement('div'); actions.className = 'artwork-image-actions'; actions.append(label, remove);
				details.append(altLabel, altHint, captionLabel, actions);
				details.hidden = index !== selectedImage; select.append(preview); if (image.isDefault) { const badge = document.createElement('span'); badge.textContent = 'Cover'; select.append(badge); } row.append(select); list.append(row); if (index === selectedImage) selectedDetails = details;
			});
			if (selectedDetails) list.append(selectedDetails);
		};
		// Adds uploaded files to the image list model and clears the picker, so a
		// retry after a failed save does not upload the same files again.
		const uploadFiles = async (files: File[]) => {
			if (!files.length) return false;
			const body = new FormData();
			for (const file of files) body.append('images', file);
			const response = await fetch('/api/admin/media', { method: 'POST', body });
			const payload = await response.json();
			if (!response.ok) throw new Error(payload.error || 'Upload failed');
			for (const uploaded of payload.images as Array<{ url: string }>) images.push({ url: uploaded.url, caption: null, altText: null, isDefault: images.length === 0 });
			fileInput.value = '';
			return true;
		};
		const suggest = form.querySelector<HTMLButtonElement>('[data-suggest]')!;
		const suggestion = form.querySelector<HTMLElement>('[data-suggestion]')!;
		const status = form.querySelector<HTMLElement>('[data-suggest-status]')!;
		const suggested = (name: string) => form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-suggest-${name}]`)!;
		let suggestedCoverUrl: string | null = null;
		let suggesting = false;
		suggest.addEventListener('click', async () => {
			if (suggesting) return;
			suggesting = true; suggest.disabled = true; status.textContent = 'Generating suggestions…'; suggestion.hidden = true;
			try {
				if (await uploadFiles(Array.from(fileInput.files ?? []))) renderImages();
				const cover = images.find((image) => image.isDefault) || images[0];
				if (!cover) throw new Error('Add a cover image first.');
				const response = await fetch('/api/admin/artwork-suggestions', {
					method: 'POST', headers: { 'content-type': 'application/json' },
					body: JSON.stringify({ title: field('title').value, artist: field('artist').value, year: field('year').value, description: field('description').value, instructions: field('aiInstructions').value, images: [{ url: cover.url, altText: cover.altText }] }),
				});
				const payload = await response.json();
				if (!response.ok) throw new Error(payload.error || 'Suggestions failed');
				suggested('description').value = payload.suggestion.description;
				suggested('tags').value = payload.suggestion.tags.join(', ');
				suggested('alt').value = payload.suggestion.altText;
				suggestedCoverUrl = cover.url;
				suggestion.hidden = false; status.textContent = 'Review and edit the suggestions, then apply them.';
			} catch (error) { status.textContent = error instanceof Error ? error.message : 'Suggestions failed'; }
			finally { suggesting = false; suggest.disabled = false; }
		});
		form.querySelector('[data-apply-suggestion]')!.addEventListener('click', () => {
			const cover = images.find((image) => image.url === suggestedCoverUrl);
			if (!cover) { status.textContent = 'The cover image changed. Generate fresh suggestions.'; return; }
			field('description').value = suggested('description').value;
			setFacetValues(form, 'tags', suggested('tags').value.split(',').map(value => value.trim()).filter(Boolean));
			dirty.mark();
			cover.altText = suggested('alt').value || null;
			renderImages(); suggestion.hidden = true; status.textContent = 'Suggestions applied. Review the fields and save when ready.';
		});

		const collections = attachInlineCollectionCreator(form);
		// The image rows are rebuilt only after a failed save has unlocked the
		// form; rows built while locked would be editable mid-save.
		let imagesChanged = false;
		attachAdminFormSave(form, {
			statusElement: document.querySelector<HTMLElement>('[data-editor-save]')!,
			// Suggestions and a new collection each finish by editing this form.
			// Saving first would send a payload without that edit, then let it land
			// on a locked form.
			blockedReason: () => suggesting ? 'Wait for the suggestions to finish, then save.'
				: collections?.busy() ? 'Wait for the new collection to be added, then save.'
				: null,
			onFailure: () => { if (imagesChanged) renderImages(); imagesChanged = false; },
			save: async (data) => {
				const payload: Record<string, unknown> = Object.fromEntries(data);
				payload.published = data.get('published') === 'published'; payload.available = data.has('available');
				const priceDollars = String(data.get('priceDollars') ?? '');
				payload.priceCents = priceDollars === '' ? '' : Math.round(Number(priceDollars) * 100);
				payload.tags = data.getAll('tags');
				payload.editorVersion = 2;
				// Read from the control: a derived orientation disables the select,
				// and FormData leaves disabled controls out.
				payload.orientation = field<HTMLSelectElement>('orientation').value;
				for (const name of attributeNames) {
					payload[name] = [...data.getAll(name), ...String(data.get(`${name}New`) ?? '').split(',').map((value) => value.trim()).filter(Boolean)];
					delete payload[`${name}New`];
				}
				payload.collectionIds = data.getAll('collectionIds').map(Number);
				delete payload.priceDollars; delete payload.imageFiles; delete payload.defaultImage; delete payload.aiInstructions;
				// An empty file picker still submits one nameless file.
				const files = data.getAll('imageFiles').filter((file): file is File => file instanceof File && file.name !== '');
				if (await uploadFiles(files)) imagesChanged = true;
				payload.images = images;
				const { redirect } = await postAdminJson<{ redirect: string }>(form.dataset.action!, payload);
				dirty.clear();
				return { redirect };
			},
		});
		renderImages();
	}
</script>

<script>
    import { dimensionOrientation } from '../../lib/artwork-facets';
    const form = document.querySelector<HTMLFormElement>('[data-admin-artwork-form]');
    if (form) {
        const input = (name: string) => form.elements.namedItem(name) as HTMLInputElement | HTMLSelectElement;
        const syncDimensions = () => {
            const number = (name: string) => input(name).value === '' ? null : Number(input(name).value);
            const orientation = dimensionOrientation({width:number('width'),height:number('height')});
            input('orientation').disabled = Boolean(orientation);
            if (orientation) input('orientation').value = orientation;
            form.querySelector('[data-dimension-summary]')!.textContent = orientation
                ? `Orientation: ${orientation}.`
                : 'Add width and height to calculate orientation, or choose it manually.';
        };
        for (const name of ['width','height']) input(name).addEventListener('input',syncDimensions);
        syncDimensions();
    }
</script>

<style>
form[data-admin-artwork-form] { margin-top: 1.5rem; max-width: none; }
.editor-columns { display: grid; grid-template-columns: minmax(0, 2fr) minmax(18rem, 1fr); gap: 1.5rem; align-items: start; }
.editor-main, .editor-sidebar { display:flex; flex-direction:column; gap:1.5rem; min-width:0; }
.span-all { grid-column:1 / -1; }
.editor-actions { position:sticky; bottom:0; z-index:10; display:flex; justify-content:flex-end; align-items:center; gap:1rem; padding:1rem; margin-top:1.5rem; background:var(--admin-surface); border:1px solid var(--admin-border); border-radius:.5rem; }
.editor-actions [role="status"] { margin:0; padding:0; border:0; background:none; }
.editor-actions [role="status"]:empty { flex:0; }
.editor-actions label { display:flex; align-items:center; gap:.75rem; }
.editor-actions .admin-input { margin:0; width:auto; }
.collection-list { display:grid; gap:.75rem; }
.new-collection-row { display:flex; gap:.5rem; margin-top:.5rem; }
.add-collection { padding:.65rem 1rem; background:var(--admin-surface); border:1px solid var(--admin-border-strong); border-radius:.35rem; font:inherit; cursor:pointer; }
.new-collection .hint { min-height:1.2em; }
.writing-assistant summary { cursor:pointer; font-weight:600; margin-bottom:.75rem; }
.image-list { display:grid; grid-template-columns:repeat(auto-fill,minmax(7rem,1fr)); gap:.75rem; }
.image-list :global(.image-tile) { position:relative; width:100%; padding:.35rem; border:2px solid var(--admin-border); background:var(--admin-surface); border-radius:.5rem; cursor:pointer; }
.image-list :global(.image-tile[aria-pressed=true]) { border-color:var(--admin-accent); }
.image-list :global(.image-tile span) { position:absolute; bottom:.5rem; left:.5rem; padding:.15rem .4rem; background:var(--admin-surface); border-radius:.25rem; font-size:.75rem; }
.image-list :global(.artwork-image-preview) { width:100%; aspect-ratio:1; object-fit:contain; display:block; }
.image-list :global(.artwork-image-details) { grid-column:1 / -1; display:flex; flex-direction:column; gap:.75rem; padding:1rem; background:var(--admin-surface); border:1px solid var(--admin-border); border-radius:.5rem; }
.image-list :global(.artwork-image-details[hidden]) { display:none; }
.image-list :global(.artwork-image-actions) { display:flex; justify-content:space-between; gap:1rem; }
.image-list:empty::after { content:'No images yet.'; color:var(--admin-muted); }
.upload :global(.admin-input) { padding:.6rem 0; border:0; background:none; }
@media(max-width:64rem) { .editor-columns { grid-template-columns:minmax(0,1fr); } }
@media(max-width:30rem) {
 .editor-actions { display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:end; gap:.5rem; padding:.75rem; }
 .editor-actions [role="status"]:not(:empty) { grid-column:1 / -1; }
 .editor-actions [role="status"]:empty { position:absolute; width:0; height:0; overflow:hidden; }
 .editor-actions label { display:grid; gap:.2rem; }
 .editor-actions .primary-button { padding:.75rem 1rem; }
 .new-collection-row { flex-wrap:wrap; }
}
</style>
