---
// Rendered only by the admin settings page, after its admin guard.
import { listAdminPushDevices, listRecentOrderNotifications } from '../../../db/admin-push';
import { getVapidPublicKey } from '../../../lib/push/config';
import { formatOrderAmount, MAX_ATTEMPTS, type AdminPushEnv } from '../../../lib/push/dispatch';
import { isAllowedAdminEmail } from '../../../lib/auth';
import { getRuntimeEnv } from '../../../lib/runtime-env';

interface Props {
	ownerId: string;
}

const { ownerId } = Astro.props;
const env = getRuntimeEnv() as AdminPushEnv;
const publicKey = getVapidPublicKey(env);
let devices: Awaited<ReturnType<typeof listAdminPushDevices>> = [];
let recipients: typeof devices = [];
let alerts: Awaited<ReturnType<typeof listRecentOrderNotifications>> = [];
let loadError = false;
try {
	[devices, alerts, recipients] = await Promise.all([listAdminPushDevices(env, ownerId), listRecentOrderNotifications(env), listAdminPushDevices(env, undefined)]);
	// Matches order alert recipients: every device of a currently allowed admin.
	recipients = recipients.filter((device) => isAllowedAdminEmail(device.ownerEmail, env));
} catch {
	// Keeps the page usable before the push migration is applied.
	loadError = true;
}
const time = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'UTC' });
const at = (value: Date | null) => (value ? `${time.format(value)} UTC` : '—');
const statusLabels: Record<string, string> = {
	sent: 'sent', pending: 'retrying', failed: 'failed', expired: 'device expired', revoked: 'access removed', stale: 'old key', cancelled: 'device removed',
};
function summarize(deliveries: (typeof alerts)[number]['deliveries']) {
	if (!deliveries.length) return 'No devices were enabled when this order was paid.';
	const counts = new Map<string, number>();
	for (const delivery of deliveries) counts.set(delivery.status, (counts.get(delivery.status) ?? 0) + 1);
	return [...counts].map(([status, count]) => `${count} ${statusLabels[status] ?? status}`).join(' · ');
}
---
<div data-push-settings data-push-public-key={publicKey ?? ''} data-push-worker="/push-sw.js" data-push-scope="/admin/">
	<section class="push-panel">
		<p>Get an alert on this device when an order is paid. Alerts show the artwork and amount only, never buyer details, and open the order in the admin console.</p>
		<p class="push-state" role="status" aria-live="polite" data-push-status>Checking this device…</p>
		<div class="push-actions">
			<button type="button" class="primary-button" data-push-enable hidden disabled>Enable notifications</button>
			<button type="button" class="secondary-button" data-push-disable hidden>Turn off on this device</button>
		</div>
		<div class="guide" data-push-guide="install" hidden>
			<p>On iPhone and iPad (iOS 16.4 or later), notifications work only from the Home Screen app:</p>
			<ol>
				<li>In Safari, tap Share, then Add to Home Screen.</li>
				<li>Open EONMUN from the Home Screen and sign in to admin there; it does not share Safari’s sign-in.</li>
				<li>Return to Admin → Settings → Notifications and tap Enable notifications.</li>
			</ol>
		</div>
		<div class="guide" data-push-guide="denied" hidden>
			<p>On iPhone or iPad, open Settings → Notifications → EONMUN and allow notifications. In a desktop browser, allow notifications in this site’s settings. Then reload this page.</p>
		</div>
		<div class="guide" data-push-guide="unsupported" hidden>
			<p>Use a current version of Safari, Chrome, Edge, or Firefox. On iPhone and iPad, add EONMUN to the Home Screen first.</p>
		</div>
		<div class="guide" data-push-guide="not-configured" hidden>
			<p>An administrator must set the VAPID keys described in the contributor guide.</p>
		</div>
	</section>

	{loadError ? <p role="alert">Notification records are unavailable. Apply the latest database migration.</p> : <>
		<section class="push-section" aria-labelledby="devices-heading">
			<h3 id="devices-heading">Your devices</h3>
			{devices.length === 0 ? <p class="hint">No devices are enabled for your account.</p> : (
				<ul class="push-list">
					{devices.map((device) => (
						<li>
							<span>{device.deviceLabel ?? 'Device'}</span>
							<span class="hint">Enabled {at(device.createdAt)} · last delivered {at(device.lastSuccessAt)}{device.lastFailureAt && ` · last failure ${at(device.lastFailureAt)}`}</span>
							<button type="button" class="link-button" data-push-remove-id={device.id}>Remove</button>
						</li>
					))}
				</ul>
			)}
		</section>

		<section class="push-section" aria-labelledby="test-heading">
			<h3 id="test-heading">Test notifications</h3>
			<p>Send a sample notification to every device that receives paid-order alerts, for all admins. Each device can receive one test per minute.</p>
			<button type="button" class="primary-button" data-admin-test-all disabled={!publicKey}>Send test notification to all admins</button>
			<p role="status" aria-live="polite" data-admin-test-result></p>
			{recipients.length === 0 ? <p class="hint">No admin devices are enabled yet.</p> : <ul class="push-list" aria-label="Devices that receive alerts">
				{recipients.map((device) => <li><span>{device.ownerEmail} · {device.deviceLabel ?? 'Device'}</span></li>)}
			</ul>}
		</section>

		<section class="push-section" aria-labelledby="alerts-heading">
			<h3 id="alerts-heading">Recent order alerts</h3>
			{alerts.length === 0 ? <p class="hint">No paid-order alerts yet.</p> : (
				<ul class="push-list">
					{alerts.map((alert) => {
						const retrying = alert.deliveries.filter((delivery) => delivery.status === 'pending' && delivery.attempts > 0);
						const lastError = alert.deliveries.find((delivery) => delivery.lastError && delivery.status !== 'sent')?.lastError;
						return (
							<li>
								<a href={`/admin/orders/${encodeURIComponent(alert.orderId)}`}>{alert.artworkTitle} · {formatOrderAmount(alert.amountTotal, alert.currency)}</a>
								<span class="hint">{at(alert.createdAt)} · {summarize(alert.deliveries)}</span>
								{retrying.map((delivery) => <span class="hint">Attempt {delivery.attempts} of {MAX_ATTEMPTS}; next try {at(delivery.nextAttemptAt)}</span>)}
								{lastError && <span class="hint">Last error: {lastError}</span>}
							</li>
						);
					})}
				</ul>
			)}
		</section>
	</>}
</div>
<script>
	import { attachPushSettings } from '../../../lib/push-client';
	const root = document.querySelector<HTMLElement>('[data-push-settings]');
	if (root) attachPushSettings(root, { navigator, window, fetchImpl: fetch.bind(window) });
	const testAll = document.querySelector<HTMLButtonElement>('[data-admin-test-all]');
	const testResult = document.querySelector<HTMLElement>('[data-admin-test-result]');
	const devices = (count: number) => `${count} device${count === 1 ? '' : 's'}`;
	testAll?.addEventListener('click', async () => {
		if (!testResult) return;
		testAll.disabled = true;
		testResult.textContent = 'Sending test notifications…';
		try {
			const response = await fetch('/api/admin/push/test-all', { method: 'POST', headers: { 'content-type': 'application/json' }, body: '{}' });
			const result = await response.json() as Partial<Record<'eligible' | 'accepted' | 'rateLimited' | 'removed' | 'failed' | 'notAttempted', number>> & { error?: string };
			if (!response.ok || result.eligible === undefined) {
				testResult.textContent = result.error ?? 'Could not send test notifications.';
			} else if (result.eligible === 0) {
				testResult.textContent = 'No admin devices have notifications enabled. Each admin must enable them on their own device first.';
			} else {
				// Push-service acceptance is not proof the device displayed the alert.
				const parts = [`Push service accepted the test for ${result.accepted ?? 0} of ${devices(result.eligible)}.`];
				if (result.rateLimited) parts.push(`${devices(result.rateLimited)} already tested in the last minute; try again shortly.`);
				if (result.removed) parts.push(`${devices(result.removed)} removed (expired or old key); enable notifications on them again.`);
				if (result.failed) parts.push(`${devices(result.failed)} failed.`);
				if (result.notAttempted) parts.push(`${devices(result.notAttempted)} not attempted; send again to reach them.`);
				testResult.textContent = parts.join(' ');
			}
		} catch { testResult.textContent = 'Could not send test notifications. Check your connection.'; }
		finally { testAll.disabled = false; }
	});
</script>
<style>
	.push-panel, .push-section { max-width: 48rem; margin: 2rem 0; }
	.push-state { font-size: 1.1rem; }
	.push-actions { display: flex; flex-wrap: wrap; gap: 1rem; margin: 1.5rem 0; }
	button:disabled { cursor: wait; opacity: .6; }
	.guide { padding: 1rem 1.25rem; border: 1px solid var(--admin-border); background: var(--admin-surface); }
	.guide ol { margin: .5rem 0 0; padding-left: 1.25rem; }
	h3 { font-size: 1.25rem; color: var(--admin-text); }
	.push-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--admin-border); }
	.push-list li { display: flex; flex-wrap: wrap; align-items: baseline; gap: .4rem 1rem; padding: .9rem; border-bottom: 1px solid var(--admin-border); background: var(--admin-surface); overflow-wrap: anywhere; }
	.push-list .hint { flex-basis: 100%; }
</style>
