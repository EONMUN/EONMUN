---
// Rendered only by the admin settings page, after its admin guard.
import { getRuntimeEnv } from '../../../lib/runtime-env';
import { readPinterestConnection } from "../../../lib/pinterest-connection";
import { getDb } from "../../../db";
import { sql } from "drizzle-orm";
import { isPinterestConfigured } from '../../../lib/pinterest-sync';

let connection: Awaited<ReturnType<typeof readPinterestConnection>> = null;
let connectionAvailable = true;
try { connection = await readPinterestConnection(getRuntimeEnv()); }
catch { connectionAvailable = false; }
const boardConfigured = Boolean(connection?.board_id);
const boardPins = boardConfigured ? await getDb(getRuntimeEnv()).all<{ state: string; count: number }>(sql`SELECT state, count(*) AS count FROM pinterest_artwork_pins GROUP BY state`) : [];
const configured = isPinterestConfigured(getRuntimeEnv());
---
<div class="pinterest-sync">
 <h3>Board posting</h3>
 <p>Recommended board: EONMUN — Original Art. Published artwork available for sale is posted once, with a link to its artwork page. Existing saleable artworks are backfilled automatically, one per minute.</p>
 <button type="button" class="primary-button" data-pinterest-connect disabled={!connectionAvailable}>{connection ? 'Reconnect Pinterest' : 'Connect Pinterest'}</button>
 {!connectionAvailable && <p role="alert">Pinterest connection settings are unavailable. New connection setup becomes available after deployment; if already deployed, try again later.</p>}
 {Astro.url.searchParams.get('pinterestConnection') === 'failed' && <p role="alert">Pinterest connection failed or was cancelled. Try connecting again.</p>}
 {connection && <div data-board-picker><label>Pinterest board <select class="admin-input" data-pinterest-board><option value="">Load your public boards…</option></select></label><button type="button" class="primary-button" data-save-board>Use this board</button><button type="button" data-disconnect-pinterest>Disconnect Pinterest</button></div>}
 <p role="status" data-board-status>{connection?.board_name ? `Posting to ${connection.board_name}.` : connection ? 'Choose a public board to enable posting and automatic backfill.' : 'Connect Pinterest to authorize posting, then choose a public board.'}</p>
 {boardConfigured ? <><p>Automatic board posting is configured.</p>{boardPins.map(row => <p>{row.state === 'published' ? 'Published' : 'Needs review before retrying'}: {row.count}</p>)}</> : null}
 <p>Uncertain posting attempts pause to prevent duplicates. Review the board before clearing a paused record. Pins remain as portfolio posts when artwork sells; the linked site shows current availability.</p>
 <h3>Shopping catalog</h3>
	<p>When Pinterest is connected, saving a published artwork marked available for sale submits it to the catalog automatically. Prices are sent in USD. When an artwork sells, its listing is submitted for removal.</p>
	<p>Website collections are not yet mirrored to Pinterest product groups. No extra step is needed to list their saleable artworks.</p>
	{configured ? (
		<>
			<button type="button" class="primary-button" data-pinterest-sync>Retry all artwork listings</button>
			<p class="hint">Use this if Pinterest missed a change or to backfill existing listings. Pinterest processes changes asynchronously; this page checks each item's result.</p>
		</>
	) : (
		<p role="status">Pinterest is not connected yet. Configure the app secret on the production Worker to enable syncing.</p>
	)}
	<p role="status" aria-live="polite" data-pinterest-status></p>
	<ul data-pinterest-items></ul>
</div>

<script>
 const connectionStatus = document.querySelector<HTMLElement>('[data-board-status]')!;
 const boardSelect = document.querySelector<HTMLSelectElement>('[data-pinterest-board]');
 const connectionCall = async (body: unknown) => {
  const response = await fetch('/api/admin/pinterest-connect', {method: 'POST', headers: {'content-type': 'application/json'}, body: JSON.stringify(body)});
  const result = await response.json(); if (!response.ok) throw new Error(result.error ?? 'Pinterest connection failed'); return result;
 };
 document.querySelector('[data-pinterest-connect]')?.addEventListener('click', async () => {
  try { const result = await connectionCall({action: 'connect'}); location.assign(result.url); }
  catch (error) { connectionStatus.textContent = error instanceof Error ? error.message : 'Connection failed'; }
 });
 document.querySelector('[data-disconnect-pinterest]')?.addEventListener('click', async () => {
  try { await connectionCall({action: 'disconnect'}); location.reload(); }
  catch { connectionStatus.textContent = 'Could not disconnect Pinterest.'; }
 });
 if (boardSelect) {
  (async () => {
   try {
    const response = await fetch('/api/admin/pinterest-connect'); const result = await response.json();
    if (!response.ok) throw new Error(result.error);
    boardSelect.replaceChildren(new Option('Choose a public board', ''));
    for (const board of result.boards) boardSelect.add(new Option(board.name, board.id));
    boardSelect.value = result.selectedBoardId ?? "";
    if (!result.boards.length) connectionStatus.textContent = "Create a public board in Pinterest, then reload this page to select it.";
   } catch { connectionStatus.textContent = 'Could not load boards. Reconnect Pinterest or try again.'; }
  })();
  document.querySelector('[data-save-board]')?.addEventListener('click', async () => {
   try { await connectionCall({action: 'select', boardId: boardSelect.value}); location.reload(); }
   catch (error) { connectionStatus.textContent = error instanceof Error ? error.message : 'Could not save board'; }
  });
 }

	const button = document.querySelector<HTMLButtonElement>('[data-pinterest-sync]');
	const status = document.querySelector<HTMLElement>('[data-pinterest-status]');
	const items = document.querySelector<HTMLUListElement>('[data-pinterest-items]');
	if (button && status && items) {
		const call = async (body: object) => {
			const response = await fetch('/api/admin/pinterest', {
				method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body),
			});
			const result = await response.json() as {
				error?: string; status?: string; failed: boolean; batch_id?: string | null; deletionIds?: string[];
				items?: Array<{ item_id?: string; status: string; errors: string[] }>;
			};
			if (!response.ok) throw new Error(result.error ?? 'Pinterest sync failed');
			return result;
		};
		button.addEventListener('click', async () => {
			button.disabled = true;
			status.textContent = 'Submitting catalog changes…';
			items.replaceChildren();
			try {
				let result = await call({});
				for (let attempt = 0; result.status === 'PROCESSING' && result.batch_id && attempt < 12; attempt++) {
					status.textContent = 'Pinterest is processing the batch…';
					await new Promise((resolve) => setTimeout(resolve, 5000));
					result = await call({ batchId: result.batch_id, deletionIds: result.deletionIds });
				}
				const failed = result.items?.filter((item) => item.status === 'FAILURE') ?? [];
				const absent = result.items?.filter((item) => item.status === 'ALREADY_ABSENT').length ?? 0;
				const submitted = result.items?.filter((item) => item.status === 'SUCCESS' && !result.deletionIds?.includes(item.item_id ?? '')).length ?? 0;
				status.textContent = result.status === 'NOTHING_TO_SYNC' ? 'No catalog changes to submit.'
					: result.status === 'PROCESSING' ? `Pinterest is still processing batch ${result.batch_id}. Check the catalog later.`
					: result.status === 'COMPLETED' && !result.failed ? `Pinterest accepted ${submitted} artwork listing(s). ${absent} unavailable artwork(s) were already absent. No item failures.`
					: `Pinterest batch ${result.status ?? 'UNKNOWN'}; ${failed.length} item(s) failed.`;
				for (const item of failed) {
					const row = document.createElement('li');
					row.textContent = `${item.item_id ?? 'Item'}: ${item.errors.join('; ') || 'Pinterest rejected this item'}`;
					items.append(row);
				}
			} catch (error) {
				status.textContent = error instanceof Error ? error.message : 'Pinterest sync failed';
			} finally { button.disabled = false; }
		});
	}
</script>

<style>
	.pinterest-sync { max-width: 56rem; margin: 1.25rem 0 0; padding: clamp(1rem, 2.5vw, 1.75rem); border: 1px solid var(--admin-border); border-radius: .5rem; background: var(--admin-surface); line-height: 1.6; }
	button { min-height: 2.75rem; padding: .8rem 1.2rem; cursor: pointer; }
	button:disabled { cursor: wait; opacity: .6; }
	.hint { color: var(--admin-muted); }
	[data-pinterest-items] { padding-left: 1.25rem; color: var(--admin-danger); }
	p:first-child { margin-top: 0; }
	p:last-child:empty, ul:empty { margin: 0; }
	[role="status"] { overflow-wrap: anywhere; }
</style>
