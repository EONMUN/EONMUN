---
const year = new Date().getFullYear();
---
<footer class="w-full mt-16 border-t border-gray-700/40 py-8 text-sm text-gray-500 dark:text-gray-400">
	<div class="container mx-auto px-4 flex flex-col sm:flex-row justify-between gap-4">
		<p>&copy; {year} EONMUN. All rights reserved.</p>
		<div class="flex gap-4">
			<a href="/shipping" class="hover:text-white">Shipping</a>
			<a href="/returns" class="hover:text-white">Returns</a>
			<a href="/privacy" class="hover:text-white">Privacy</a>
			<a href="/contact" class="hover:text-white">Contact</a>
			<a href="https://x.com/E0NMUN" target="_blank" rel="noopener noreferrer" class="hover:text-white">Twitter</a>
			<a href="https://instagram.com/eon.mun/" target="_blank" rel="noopener noreferrer" class="hover:text-white">Instagram</a>
		</div>
	</div>
</footer>

<style>
	:global(html.admin-page) footer {
		color: var(--admin-muted);
		border-color: var(--admin-border);
	}

	/* The system font is wider than Abel, so the links need to wrap on phones. */
	:global(html.admin-page) footer > div > div {
		flex-wrap: wrap;
	}

	:global(html.admin-page) footer a:hover {
		color: var(--admin-text);
		text-decoration: underline;
		text-underline-offset: 0.2em;
	}
</style>
