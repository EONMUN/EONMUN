---
interface Props {
	productSlug: string;
	variant: "artwork" | "store";
}

const { productSlug, variant } = Astro.props;
const endpoint = `/api/inventory/${productSlug}.json`;
const storeHref = `/store/${productSlug}`;
---
<div
	data-inventory-widget
	data-endpoint={endpoint}
	data-variant={variant}
	data-store-href={storeHref}
	class="space-y-2"
>
	{variant === "artwork" ? (
		<>
			<a
				data-available-link
				href={storeHref}
				hidden
				class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:opacity-90 transition-opacity font-medium"
			>
				View in Store
			</a>
			<p data-status class="text-sm text-gray-500 dark:text-gray-400">Checking availability...</p>
		</>
	) : (
		<>
			<p data-status class="text-sm text-gray-500 dark:text-gray-400">Checking availability...</p>
			<form method="POST" action="/api/checkout" class="space-y-2" data-purchase-form hidden>
				<input type="hidden" name="slug" value={productSlug} />
				{/* SECURITY: keep inventory reads separate from checkout so a slow stock
				    query never forces the whole page back onto SSR. */}
				<button
					type="submit"
					class="w-full py-3 px-6 bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold uppercase tracking-wider rounded-lg hover:opacity-90 transition-opacity"
				>
					Buy now
				</button>
				<p class="text-xs text-gray-500 text-center">
					Checkout integration is in progress — clicking will return a stub response for now.
				</p>
			</form>
		</>
	)}
</div>

<script is:inline>
	const initInventoryWidgets = () => {
		for (const root of document.querySelectorAll("[data-inventory-widget]")) {
			if (root.dataset.inventoryReady === "true") continue;
			root.dataset.inventoryReady = "true";

			const endpoint = root.dataset.endpoint;
			const variant = root.dataset.variant;
			const storeHref = root.dataset.storeHref;
			const status = root.querySelector("[data-status]");
			const link = root.querySelector("[data-available-link]");
			const form = root.querySelector("[data-purchase-form]");

			const setStatus = (message) => {
				if (status) status.textContent = message;
			};

			fetch(endpoint, { headers: { accept: "application/json" } })
				.then(async (response) => {
					if (!response.ok) {
						throw new Error(`Inventory request failed with ${response.status}`);
					}

					return response.json();
				})
				.then((payload) => {
					if (payload.available) {
						if (variant === "artwork") {
							if (link && storeHref) {
								link.hidden = false;
								link.href = storeHref;
							}
							if (status) status.hidden = true;
							return;
						}

						if (form) form.hidden = false;
						setStatus("Available now");
						return;
					}

					const unavailableMessage =
						payload.status === "sold"
							? "Sold"
							: "Not currently available for purchase.";

					if (link) link.hidden = true;
					if (form) form.hidden = true;
					setStatus(unavailableMessage);
				})
				.catch(() => {
					if (variant === "artwork" && link && storeHref) {
						link.hidden = false;
						link.href = storeHref;
						setStatus("Live availability is temporarily unavailable.");
						return;
					}

					setStatus("Live availability is temporarily unavailable.");
				});
		}
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initInventoryWidgets, {
			once: true,
		});
	} else {
		initInventoryWidgets();
	}
</script>
