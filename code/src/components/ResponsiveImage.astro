---
import { getResponsiveImageSource, type ResponsiveImageOptions } from '../lib/responsive-image';

interface Props extends ResponsiveImageOptions {
	src: string;
	alt: string;
	class?: string;
	loading?: 'eager' | 'lazy';
	fetchpriority?: 'high' | 'low' | 'auto';
	reserveDimensions?: boolean;
}

const { src, alt, class: className, loading = 'lazy', fetchpriority, reserveDimensions = true, ...options } = Astro.props;
const image = await getResponsiveImageSource(src, options);
---
<img
	src={image.src}
	srcset={image.srcset}
	sizes={image.sizes}
	width={reserveDimensions ? image.width : undefined}
	height={reserveDimensions ? image.height : undefined}
	data-fallback-src={image.fallback}
	alt={alt}
	class={className}
	loading={loading}
	fetchpriority={fetchpriority}
	decoding="async"
/>

<script>
	document.addEventListener('error', (event) => {
		const image = event.target;
		if (!(image instanceof HTMLImageElement) || image.closest('[data-hero-carousel]')) return;
		const fallback = image.dataset.fallbackSrc;
		if (!fallback || image.src === fallback) return;
		image.removeAttribute('srcset');
		image.src = fallback;
	}, true);
</script>
