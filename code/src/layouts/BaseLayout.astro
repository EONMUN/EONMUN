---
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
}

const { title, description, image, type, publishedTime } = Astro.props;
---
<!doctype html>
<html lang="en" class="dark:bg-gray-900 dark:text-white">
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
		/>
	</head>
	<body class="bg-white text-gray-900 dark:bg-gray-900 dark:text-white min-h-screen flex flex-col">
		<Navbar />
		<main class="flex-1 w-full">
			<slot />
		</main>
		<Footer />
	</body>
</html>
