---
import Analytics from '../components/Analytics.astro';
import PinterestTag from '../components/PinterestTag.astro';
import BaseHead from '../components/BaseHead.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: string;
	themeColor?: string;
	iosEdgeToEdge?: boolean;
	// SECURITY: pages that render buyer contact details set this so PostHog
	// autocapture and session recording, and the Pinterest tag, never load on
	// them. Navigation is full-page, so no tracker carries over from a public page.
	privateData?: boolean;
	// Admin routes supply their own light and dark themes through the head slot.
	adminAppearance?: boolean;
}

const { title, description, image, type, publishedTime, themeColor, iosEdgeToEdge, privateData = false, adminAppearance = false } = Astro.props;
---
<!doctype html>
<html lang="en" class={adminAppearance ? 'admin-page' : 'dark:bg-gray-900 dark:text-white'} style={iosEdgeToEdge && themeColor ? `--homepage-tint: ${themeColor}` : undefined}>
	<head>
		<BaseHead
			title={title}
			description={description}
			image={image}
			type={type}
			publishedTime={publishedTime}
			themeColor={themeColor}
			iosEdgeToEdge={iosEdgeToEdge}
		/>
		<slot name="head" />
		{!privateData && <PinterestTag />}
	</head>
	<body class:list={['min-h-screen flex flex-col', !adminAppearance && 'bg-white text-gray-900 dark:bg-gray-900 dark:text-white']}>
		<Navbar />
		<main class="flex-1 w-full">
			<slot />
		</main>
		<Footer />
		{!privateData && <Analytics />}
		<script>
			document.addEventListener('error', (event) => {
				const image = event.target;
				if (!(image instanceof HTMLImageElement) || image.closest('[data-hero-carousel]')) return;
				const fallback = image.dataset.fallbackSrc;
				if (!fallback || image.src === fallback) return;
				image.removeAttribute('srcset');
				image.src = fallback;
			}, true);
		</script>
	</body>
</html>
