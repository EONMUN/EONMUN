---
import ConsoleShell from '../../components/admin/ConsoleShell.astro';
import { requireAdminPage } from '../../lib/admin-guard';
import { getRuntimeEnv } from '../../lib/runtime-env';
import { hasGoogleMerchantAccess, isGoogleMerchantConfigured } from '../../lib/google-merchant';

export const prerender = false;
const env = getRuntimeEnv();
const access = await requireAdminPage(Astro.request, env, '/admin/google');
if ('response' in access) return access.response;
const configured = isGoogleMerchantConfigured(env);
const connected = await hasGoogleMerchantAccess(env);
const error = Astro.url.searchParams.get('error');
const connectionMessage = error === 'google_merchant_account_changed'
	? 'Choose the same Google account you used to sign in to this admin site.'
	: error === 'google_merchant_permission_missing'
		? 'Allow Merchant Center access on the Google consent screen, then try again.'
		: error === 'google_merchant_connect_failed'
			? Astro.url.searchParams.get('error_description') ?? 'Google Merchant connection failed. Please retry.'
			: error ? 'Google authorization was not completed. Please try again.' : null;
---
<ConsoleShell title="Google Merchant — EONMUN admin" heading="Google Merchant sync" email={access.session.user.email} backHref="/admin" backLabel="Admin">
	<p>Saleable artwork is sent to Google Merchant Center when saved and removed after a confirmed Stripe sale. Google reviews submitted products before they can appear in listings.</p>
	{connectionMessage && <p role="alert">{connectionMessage}</p>}
	{connected && <p role="status">Google Merchant account access is verified. Use the retry button to sync existing artwork.</p>}
	{configured ? <>
		{!connected && <p>For initial setup, connect using the Google account that administers Merchant Center. Afterwards, syncing continues even when you are signed out.</p>}
		<button type="button" data-google-connect>{connected ? 'Reconnect Google Merchant' : 'Connect Google Merchant'}</button>
		<button type="button" data-google-sync>Retry all artwork listings</button>
	</> : <p role="status">Google Merchant API is not configured yet.</p>}
	<p role="status" aria-live="polite" data-google-status></p>
</ConsoleShell>
<script>
	const button = document.querySelector<HTMLButtonElement>('[data-google-sync]');
	const status = document.querySelector<HTMLElement>('[data-google-status]');
	const connect = document.querySelector<HTMLButtonElement>('[data-google-connect]');
	connect?.addEventListener('click', async () => {
		if (!status) return;
		connect.disabled = true;
		status.textContent = 'Opening Google authorization…';
		try {
			const response = await fetch('/api/auth/sign-in/social', {
				method: 'POST', headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ provider: 'google', additionalData: { googleMerchantSetup: true } }),
			});
			const result = await response.json() as { url?: string; message?: string };
			if (!response.ok || !result.url) throw new Error(result.message ?? 'Could not connect Google Merchant.');
			location.assign(result.url);
		} catch (error) {
			status.textContent = error instanceof Error ? error.message : 'Could not connect Google Merchant.';
			connect.disabled = false;
		}
	});
	button?.addEventListener('click', async () => {
		if (!status) return;
		button.disabled = true;
		status.textContent = 'Submitting artwork changes…';
		try {
			const response = await fetch('/api/admin/google', { method: 'POST' });
			const result = await response.json() as { submitted?: number; removed?: number; error?: string };
			status.textContent = response.ok
				? `Submitted ${result.submitted} saleable artwork(s); removed ${result.removed} unavailable artwork(s) from the API source.`
				: result.error ?? 'Google Merchant sync failed';
		} catch { status.textContent = 'Google Merchant sync failed'; }
		finally { button.disabled = false; }
	});
</script>
