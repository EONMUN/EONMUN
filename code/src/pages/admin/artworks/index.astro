---
import ActionBar from '../../../components/admin/ActionBar.astro';
import CardGrid from '../../../components/admin/CardGrid.astro';
import ConsoleSection from '../../../components/admin/ConsoleSection.astro';
import ConsoleShell from '../../../components/admin/ConsoleShell.astro';
import CreateAction from '../../../components/admin/CreateAction.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import MediaCard from '../../../components/admin/MediaCard.astro';
import { getAdminArtworkCards, getPricedUnavailableArtworks } from '../../../db/admin';
import { requireAdminPage } from '../../../lib/admin-guard';
import { getRuntimeEnv } from '../../../lib/runtime-env';

export const prerender = false;

const env = getRuntimeEnv();
const access = await requireAdminPage(Astro.request, env, '/admin/artworks');
if ('response' in access) return access.response;
const { session } = access;

const [artworks, pricedUnavailable] = await Promise.all([getAdminArtworkCards(env), getPricedUnavailableArtworks(env)]);
const published = artworks.filter((artwork) => artwork.publishedAt !== null).length;
const tally = `${artworks.length} total · ${published} published · ${artworks.length - published} draft`;
---
<ConsoleShell
	title="Artwork — EONMUN admin"
	heading="Artwork"
	email={session.user.email}
	backHref="/admin"
	backLabel="Console"
>
	<ActionBar>
		<CreateAction
			href="/admin/artworks/new"
			title="New artwork"
			note="Images, dimensions, collections, private price."
		/>
	</ActionBar>
	{pricedUnavailable.length > 0 && (
		<div class="mb-10 border border-gray-700/40 p-5 space-y-3">
			<h2 class="text-lg font-semibold">Priced artwork not yet for sale</h2>
			<p>{pricedUnavailable.length} published, unsold {pricedUnavailable.length === 1 ? 'piece has' : 'pieces have'} a price but {pricedUnavailable.length === 1 ? 'is' : 'are'} marked unavailable: {pricedUnavailable.map((artwork) => artwork.title).join(', ')}.</p>
			<button type="button" class="primary-button" data-enable-priced>Make all priced pieces available</button>
			<p class="text-sm" role="status" aria-live="polite" data-enable-priced-status></p>
		</div>
	)}

	<ConsoleSection title="Every piece" tally={tally} links={[{ href: '/admin/collections', label: 'Collections →' }]}>
		{artworks.length === 0 ? (
			<EmptyState href="/admin/artworks/new" label="No artwork yet. Add the first piece →" />
		) : (
			<CardGrid>
				{artworks.map((artwork) => (
					<li>
						<MediaCard
							href={`/admin/artworks/${artwork.slug}`}
							title={artwork.title}
							meta={artwork.year ? String(artwork.year) : 'Year unset'}
							imageUrl={artwork.imageUrl}
							status={{
								label: artwork.publishedAt ? 'Published' : 'Draft',
								tone: artwork.publishedAt ? 'live' : 'draft',
							}}
						/>
					</li>
				))}
			</CardGrid>
		)}
	</ConsoleSection>
</ConsoleShell>

<script>
	const button = document.querySelector<HTMLButtonElement>('[data-enable-priced]');
	button?.addEventListener('click', async () => {
		const status = document.querySelector<HTMLElement>('[data-enable-priced-status]');
		button.disabled = true;
		if (status) status.textContent = 'Updating availability…';
		try {
			const response = await fetch('/api/admin/artworks/enable-priced', { method: 'POST' });
			if (!response.ok) throw new Error('Could not update availability. Please try again.');
			location.reload();
		} catch (error) {
			if (status) status.textContent = error instanceof Error ? error.message : 'Could not update availability.';
			button.disabled = false;
		}
	});
</script>
