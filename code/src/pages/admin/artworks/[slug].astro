---
import ArtworkForm from '../../../components/admin/ArtworkForm.astro';
import ConsoleShell from '../../../components/admin/ConsoleShell.astro';
import { getAdminArtwork, getAdminCollections, getAdminFacets } from '../../../db/admin';
import { requireAdminPage } from '../../../lib/admin-guard';
import { getRuntimeEnv } from '../../../lib/runtime-env';

export const prerender = false;

const env = getRuntimeEnv();
const access = await requireAdminPage(Astro.request, env, Astro.url.pathname);
if ('response' in access) return access.response;
const { session } = access;
const slug = Astro.params.slug;
if (!slug) return new Response('Not found', { status: 404 });
const [artwork, collections, facets] = await Promise.all([getAdminArtwork(env, slug), getAdminCollections(env), getAdminFacets(env)]);
if (!artwork) return new Response('Not found', { status: 404 });
const pinterestState = Astro.url.searchParams.get('pinterest');
const rawBatchId = Astro.url.searchParams.get('pinterestBatch');
const pinterestBatchId = rawBatchId && /^[a-zA-Z0-9_-]{1,64}$/.test(rawBatchId) ? rawBatchId : null;
---
<ConsoleShell
	title={`Edit ${artwork.title} — EONMUN admin`}
	heading={artwork.title}
	email={session.user.email}
	backHref="/admin/artworks"
	backLabel="Artwork"
>
	{pinterestState === 'not-connected' && <p role="alert">Artwork saved. Pinterest is not connected yet. <a href="/admin/pinterest">View Pinterest setup →</a></p>}
	{pinterestState === 'failed' && <p role="alert">Artwork saved, but Pinterest sync failed. <a href="/admin/pinterest">Retry the catalog sync →</a></p>}
	{pinterestBatchId && <p role="status" data-pinterest-batch={pinterestBatchId}>Artwork saved. Pinterest is processing the catalog update…</p>}
	<ArtworkForm action={`/api/admin/artworks/${slug}`} artwork={artwork} collections={collections} facets={facets} />
</ConsoleShell>

<script>
	const status = document.querySelector<HTMLElement>('[data-pinterest-batch]');
	if (status) {
		const batchId = status.dataset.pinterestBatch;
		const check = async () => {
			const response = await fetch('/api/admin/pinterest', {
				method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ batchId }),
			});
			if (!response.ok) throw new Error('Could not check Pinterest status');
			return response.json() as Promise<{ status: string; items: Array<{ status: string }> }>;
		};
		(async () => {
			try {
				for (let attempt = 0; attempt < 12; attempt++) {
					const result = await check();
					if (result.status === 'COMPLETED' || result.status === 'FAILED') {
						const failed = result.items.some((item) => item.status === 'FAILURE');
						status.textContent = result.status === 'COMPLETED' && !failed
							? 'Pinterest reported the artwork update complete.'
							: 'Pinterest rejected the artwork update. Use the Pinterest catalog page to retry.';
						return;
					}
					await new Promise((resolve) => setTimeout(resolve, 5000));
				}
				status.textContent = 'Pinterest is still processing the artwork update. Check the catalog later.';
			} catch { status.textContent = 'Artwork saved, but Pinterest status could not be checked. Use the Pinterest catalog page to retry.'; }
		})();
	}
</script>
