---
import ArtworkForm from '../../../components/admin/ArtworkForm.astro';
import ArtworkListings from '../../../components/admin/ArtworkListings.astro';
import ConsoleShell from '../../../components/admin/ConsoleShell.astro';
import { getAdminArtwork, getAdminCollections, getAdminFacets } from '../../../db/admin';
import { requireAdminPage } from '../../../lib/admin-guard';
import { getRuntimeEnv } from '../../../lib/runtime-env';

export const prerender = false;

const env = getRuntimeEnv();
const access = await requireAdminPage(Astro.request, env, Astro.url.pathname);
if ('response' in access) return access.response;
const { session } = access;
const slug = Astro.params.slug;
if (!slug) return new Response('Not found', { status: 404 });
const [artwork, collections, facets] = await Promise.all([getAdminArtwork(env, slug), getAdminCollections(env), getAdminFacets(env)]);
if (!artwork) return new Response('Not found', { status: 404 });
const pinterestState = Astro.url.searchParams.get('pinterest');
const googleState = Astro.url.searchParams.get('google');
const rawBatchId = Astro.url.searchParams.get('pinterestBatch');
const pinterestBatchId = rawBatchId && /^[a-zA-Z0-9_-]{1,64}$/.test(rawBatchId) ? rawBatchId : null;
const pinterestDeletion = Astro.url.searchParams.get('pinterestDeletion') === `artwork-${artwork.id}` ? `artwork-${artwork.id}` : undefined;
---
<ConsoleShell
	title={`Edit ${artwork.title} — EONMUN admin`}
	heading={artwork.title}
	email={session.user.email}
	backHref="/admin/artworks"
	backLabel="Artwork"
>
	{pinterestState === 'not-connected' && <p role="alert">Artwork saved. Pinterest is not connected yet. <a href="/admin/settings#pinterest">View Pinterest setup →</a></p>}
	{googleState === 'not-connected' && <p role="alert">Artwork saved. Google Merchant API is not connected yet.</p>}
	{googleState === 'failed' && <p role="alert">Artwork saved, but Google Merchant sync failed. Check Worker logs before retrying.</p>}
	{googleState === 'submitted' && <p role="status">Artwork saved and submitted to Google Merchant Center for processing.</p>}
	{googleState === 'removed' && <p role="status">Artwork saved and removed from the Google Merchant API source.</p>}
	{pinterestState === 'failed' && <p role="alert">Artwork saved, but Pinterest sync failed. <a href="/admin/settings#pinterest">Retry the catalog sync →</a></p>}
	<ArtworkForm action={`/api/admin/artworks/${slug}`} artwork={artwork} collections={collections} facets={facets}>
		<ArtworkListings slot="listings" slug={artwork.slug} pinterestBatchId={pinterestBatchId} pinterestDeletion={Boolean(pinterestDeletion)} />
	</ArtworkForm>
</ConsoleShell>
