---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---
<BaseLayout title="Shipping — EONMUN" description="Shipping terms for original artwork from EONMUN.">
	<div class="container mx-auto max-w-2xl px-4 py-16 space-y-6 leading-relaxed">
		<h1 class="text-4xl font-bold">Shipping</h1>
		<p>Shipping to addresses in the United States is included in the listed artwork price. Online checkout currently accepts U.S. shipping addresses only.</p>
		<p>We prepare and dispatch artwork within 10 business days after payment. Delivery time after dispatch depends on the carrier and destination. We will send shipment details when available.</p>
		<p>If we cannot dispatch within that period, we will contact you with an updated date and the option to cancel for a full refund.</p>
		<p>For delivery outside the United States, email <a class="underline" href="mailto:contact@eonmun.com?subject=International%20artwork%20shipping">contact@eonmun.com</a> before placing an order. We can discuss availability, shipping costs, and arrangements individually.</p>
	</div>
</BaseLayout>
