---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---
<BaseLayout title="Returns and refunds — EONMUN" description="Return and refund terms for original artwork from EONMUN.">
	<div class="container mx-auto max-w-2xl px-4 py-16 space-y-6 leading-relaxed">
		<h1 class="text-4xl font-bold">Returns and refunds</h1>
		<p>Original artwork sales are final. We do not accept returns or offer refunds for a change of mind.</p>
		<p>If your artwork arrives damaged, you receive the wrong artwork, or we cannot fulfill your order, email <a class="underline" href="mailto:contact@eonmun.com?subject=Artwork%20order%20issue">contact@eonmun.com</a> with your order details. For damage, please keep the packaging and include photographs if possible. We will review the issue and provide a remedy, including a refund when required by applicable law.</p>
		<p>See our <a class="underline" href="/shipping">shipping terms</a> for dispatch timing and what happens if an order is delayed.</p>
	</div>
</BaseLayout>
