---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPostBySlug } from '../../db/queries';
import { setEdgeCache } from '../../lib/cache';
import type { PostType } from '../../db';
import { getRuntimeEnv } from '../../lib/runtime-env';

const TYPE_LABELS: Record<PostType, string> = {
	announcement: 'Announcement',
	educational: 'Educational',
	behind_the_scenes: 'Behind the Scenes',
	general: 'General',
};

const { slug } = Astro.params;
if (!slug) {
	return new Response('Not found', { status: 404 });
}

const env = getRuntimeEnv();
const post = await getPostBySlug(env, slug);

if (!post) {
	return new Response('Not found', { status: 404 });
}

setEdgeCache(Astro);

const publishedDate = post.publishedAt
	? new Date(post.publishedAt).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	})
	: null;
---
<BaseLayout
	title={`${post.title} — EONMUN`}
	description={post.excerpt ?? `Read "${post.title}" on EONMUN`}
	type="article"
	image={post.coverImageUrl ?? undefined}
	publishedTime={post.publishedAt ? new Date(post.publishedAt).toISOString() : undefined}
>
	<article class="container mx-auto px-4 py-8 max-w-3xl">
		<nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-8">
			<a href="/" class="hover:underline">Home</a>
			<span>/</span>
			<a href="/posts" class="hover:underline">Posts</a>
			<span>/</span>
			<span class="truncate">{post.title}</span>
		</nav>

		<header class="mb-8">
			<div class="flex items-center gap-2 mb-4">
				<span class="inline-block px-2 py-0.5 border border-gray-300 dark:border-gray-600 rounded text-xs uppercase tracking-wider">
					{TYPE_LABELS[post.postType as PostType] ?? post.postType}
				</span>
				{publishedDate && (
					<span class="text-sm text-gray-500 dark:text-gray-400">{publishedDate}</span>
				)}
			</div>
			<h1 class="text-3xl sm:text-4xl font-bold mb-4">{post.title}</h1>
			{post.excerpt && (
				<p class="text-lg text-gray-600 dark:text-gray-400">{post.excerpt}</p>
			)}
		</header>

		{post.coverImageUrl && (
			<div class="mb-8 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
				<img src={post.coverImageUrl} alt={post.title} class="w-full h-auto object-cover" />
			</div>
		)}

		{/*
			TODO: Body is stored as markdown. The legacy app renders it via
			react-markdown + rehype-sanitize. For this PR we render the raw
			text inside a `<pre>` so links/images don't render as HTML strings
			and so we avoid pulling a markdown lib + sanitizer into the worker
			bundle until the data-dump PR replaces this with MDX content
			collections.
		*/}
		<div class="prose prose-lg dark:prose-invert max-w-none whitespace-pre-wrap">{post.body}</div>

		{post.artworks.length > 0 && (
			<section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
				<h2 class="text-2xl font-bold mb-6">Featured Artworks</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
					{post.artworks.map((a) => (
						<a href={`/artworks/${a.slug}`} class="group block">
							<div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 mb-2">
								{a.defaultImageUrl ? (
									<img src={a.defaultImageUrl} alt={a.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
								) : (
									<div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">No Image</div>
								)}
							</div>
							<p class="text-sm font-medium text-center">{a.title}</p>
						</a>
					))}
				</div>
			</section>
		)}

		{post.collections.length > 0 && (
			<section class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
				<h2 class="text-2xl font-bold mb-4">Related Collections</h2>
				<div class="flex flex-wrap gap-2">
					{post.collections.map((c) => (
						<a
							href={`/collections/${c.slug}`}
							class="inline-block px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-full text-sm font-medium hover:border-gray-500"
						>
							{c.name}
						</a>
					))}
				</div>
			</section>
		)}

		<div class="mt-12 text-center">
			<a href="/posts" class="inline-flex items-center gap-2 hover:underline">
				&larr; Back to Posts
			</a>
		</div>
	</article>
</BaseLayout>
