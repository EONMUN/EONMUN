---
import { render } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArtworkCollectionHref } from '../../lib/paths';
import type { PostType } from '../../db';
import {
	getPostPublishedTime,
	getPublishedPostDetailBySlug,
	TYPE_LABELS,
} from '../../lib/post-content';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug) return new Response('Not found', { status: 404 });
const postDetail = await getPublishedPostDetailBySlug(slug);
if (!postDetail) {
	return new Response('Not found', { status: 404 });
}

const { post, artworks, collections } = postDetail;
const { Content } = await render(post);
const coverImage = post.data.coverImageUrl ?? artworks[0]?.defaultImageUrl ?? null;

const publishedDateValue = post.data.publishedAt ?? post.data.scheduledAt;
const publishedDate = publishedDateValue
	? new Date(publishedDateValue).toLocaleDateString('en-US', {
		year: 'numeric',
		month: 'long',
		day: 'numeric',
	})
	: null;
---
<BaseLayout
	title={`${post.data.title} — EONMUN`}
	description={post.data.excerpt ?? `Read "${post.data.title}" on EONMUN`}
	type="article"
	image={coverImage ?? undefined}
	publishedTime={getPostPublishedTime(post)}
>
	<article class="container mx-auto px-4 py-8 max-w-3xl">
		<nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-8">
			<a href="/" class="hover:underline">Home</a>
			<span>/</span>
			<a href="/posts" class="hover:underline">Posts</a>
			<span>/</span>
			<span class="truncate">{post.data.title}</span>
		</nav>

		<header class="mb-8">
			<div class="flex items-center gap-2 mb-4">
				<span class="inline-block px-2 py-0.5 border border-gray-300 dark:border-gray-600 rounded text-xs uppercase tracking-wider">
					{TYPE_LABELS[post.data.postType as PostType] ?? post.data.postType}
				</span>
				{publishedDate && (
					<span class="text-sm text-gray-500 dark:text-gray-400">{publishedDate}</span>
				)}
			</div>
			<h1 class="text-3xl sm:text-4xl font-bold mb-4">{post.data.title}</h1>
			{post.data.excerpt && (
				<p class="text-lg text-gray-600 dark:text-gray-400">{post.data.excerpt}</p>
			)}
		</header>

		{coverImage && (
			<div class="mb-8 rounded-lg overflow-hidden border border-gray-200 dark:border-gray-700">
				<img src={coverImage} alt={post.data.title} class="w-full h-auto object-cover" />
			</div>
		)}

		<div class="prose prose-lg dark:prose-invert max-w-none">
			<Content />
		</div>

		{artworks.length > 0 && (
			<section class="mt-12 pt-8 border-t border-gray-200 dark:border-gray-700">
				<h2 class="text-2xl font-bold mb-6">Featured Artworks</h2>
				<div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
					{artworks.map((a) => (
						<a href={`/artworks/${a.artwork.id}`} class="group block">
							<div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 mb-2">
								{a.defaultImageUrl ? (
									<img src={a.defaultImageUrl} alt={a.artwork.data.title} loading="lazy" class="w-full h-full object-cover group-hover:scale-105 transition-transform" />
								) : (
									<div class="w-full h-full flex items-center justify-center text-gray-400 text-sm">No Image</div>
								)}
							</div>
							<p class="text-sm font-medium text-center">{a.artwork.data.title}</p>
						</a>
					))}
				</div>
			</section>
		)}

		{collections.length > 0 && (
			<section class="mt-8 pt-8 border-t border-gray-200 dark:border-gray-700">
				<h2 class="text-2xl font-bold mb-4">Related Collections</h2>
				<div class="flex flex-wrap gap-2">
					{collections.map((c) => (
						<a
							href={getArtworkCollectionHref(c.slug)}
							class="inline-block px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-full text-sm font-medium hover:border-gray-500"
						>
							{c.name}
						</a>
					))}
				</div>
			</section>
		)}

		<div class="mt-12 text-center">
			<a href="/posts" class="inline-flex items-center gap-2 hover:underline">
				&larr; Back to Posts
			</a>
		</div>
	</article>
</BaseLayout>
