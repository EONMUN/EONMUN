---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import { getPublishedCollectionRefs } from '../../lib/collection-content';
import { getPublishedArtworkEntries } from '../../lib/artwork-content';
import { getCollectionHref } from '../../lib/paths';

export const prerender = false;
const [collections, artworks] = await Promise.all([getPublishedCollectionRefs(), getPublishedArtworkEntries()]);
const cards = collections.map((collection) => {
	const members = artworks.filter((entry) => entry.collections.some((item) => item.slug === collection.slug));
	return { collection, count: members.length, image: members.find((entry) => entry.defaultImageUrl)?.defaultImageUrl };
});
---
<BaseLayout title="Collections — EONMUN" description="Explore artwork collections from the EONMUN studio." image={cards.find((card) => card.image)?.image}>
	<div class="container mx-auto px-4 py-8">
		<div class="mb-8">
			<h1 class="text-4xl font-bold mb-2 uppercase tracking-wider">Collections</h1>
			<p class="text-gray-600 dark:text-gray-400">Explore artwork by collection.</p>
		</div>
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
			{cards.map(({ collection, count, image }) => (
				<a href={getCollectionHref(collection.slug)} class="group block" data-collection-card>
					<div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 mb-4">
						{image ? (
							<Image src={image} data-fallback-src={image} alt={collection.name} format="webp" quality={75} fit="cover" width={960} height={960} widths={[480, 960]} sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw" loading="lazy" class="w-full h-full object-cover transition-transform group-hover:scale-105" />
						) : <div class="w-full h-full flex items-center justify-center text-gray-500">{collection.name}</div>}
					</div>
					<h2 class="text-xl font-medium mb-1">{collection.name}</h2>
					<p class="text-sm text-gray-500">{count} artwork{count !== 1 ? 's' : ''}</p>
					{collection.description && <p class="mt-2 text-gray-600 dark:text-gray-400 line-clamp-3">{collection.description}</p>}
				</a>
			))}
		</div>
		{cards.length === 0 && <p class="py-12 text-center text-gray-500">No collections published yet.</p>}
	</div>
</BaseLayout>
