---
import AdminTheme from '../../../components/admin/AdminTheme.astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
export const prerender = false;
const requestedPath = Astro.url.searchParams.get('callbackUrl') ?? '/admin';
const callback = new URL(requestedPath, Astro.url);
const callbackURL = callback.origin === Astro.url.origin ? callback.href : new URL('/admin', Astro.url).href;
const errorCallback = new URL('/api/auth/signin', Astro.url);
errorCallback.searchParams.set('callbackUrl', new URL(callbackURL).pathname + new URL(callbackURL).search);
const signInError = Astro.url.searchParams.get('error');
const errorMessage = signInError === 'admin_access_denied'
	? 'This Google account does not have admin access. Continue with Google and choose your authorized admin account.'
	: signInError ? 'Sign in could not be completed. Please try again.' : '';
---
<BaseLayout title="Admin sign in" description="Sign in to the EONMUN studio console." themeColor="#f5f3ee" adminAppearance>
	<AdminTheme slot="head" />
	<section class="mx-auto max-w-lg px-6 py-20">
		<h1 class="text-3xl mb-6">Admin sign in</h1>
		<button type="button" class="primary-button" data-google-signin data-callback={callbackURL} data-error-callback={errorCallback.href}>Continue with Google</button>
		<p role="status" class="mt-4">{errorMessage}</p>
	</section>
</BaseLayout>
<script>
	const button = document.querySelector<HTMLButtonElement>('[data-google-signin]');
	button?.addEventListener('click', async () => {
		button.disabled = true;
		try {
			const response = await fetch('/api/auth/sign-in/social', {
				method: 'POST', headers: { 'content-type': 'application/json' },
				body: JSON.stringify({ provider: 'google', callbackURL: button.dataset.callback, errorCallbackURL: button.dataset.errorCallback }),
			});
			if (!response.ok) throw new Error('Sign in failed');
			const { url } = await response.json();
			if (!url) throw new Error('Missing redirect');
			location.assign(url);
		} catch {
			document.querySelector('[role="status"]')!.textContent = 'Sign in is unavailable. Please try again.';
			button.disabled = false;
		}
	});
</script>

<style>
	button { min-height: 2.75rem; }
	button:disabled { cursor: wait; opacity: .65; }
	/* The only message this page reports is a sign-in failure. */
	[role="status"]:not(:empty) { padding: .9rem 1rem; color: var(--admin-text); background: var(--admin-danger-soft); border-left: 4px solid var(--admin-danger); }
</style>
