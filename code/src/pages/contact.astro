---
import BaseLayout from '../layouts/BaseLayout.astro';

export const prerender = true;
---

<BaseLayout title="Contact — EONMUN" description="Get in touch with EONMUN about artwork and orders.">
	<div class="container mx-auto px-4 py-16 max-w-2xl text-center space-y-6">
		<h1 class="text-4xl md:text-5xl font-bold tracking-wider uppercase">Contact</h1>
		<p class="text-lg text-gray-600 dark:text-gray-400">For artwork, order, or international shipping questions, email us directly.</p>
		<p><a href="mailto:contact@eonmun.com" class="text-lg underline hover:no-underline">contact@eonmun.com</a></p>
		<p class="text-sm text-gray-600 dark:text-gray-400">For information requests, see our <a href="/privacy" class="underline hover:no-underline">privacy policy</a>.</p>
	</div>
</BaseLayout>
