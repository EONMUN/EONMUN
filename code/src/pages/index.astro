---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getHomepageSlides } from '../lib/homepage-content';
import { getCollectionHref } from '../lib/paths';
import { getResponsiveImageSource } from '../lib/responsive-image';

export const prerender = false;

const slides = await getHomepageSlides();
const images = await Promise.all(slides.map((slide) => getResponsiveImageSource(slide.defaultImageUrl!, {
	width: 1920,
	height: 1200,
	widths: [480, 960, 1920],
	sizes: '100vw',
})));
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} themeColor="#f5f1e8" image={slides[0]?.defaultImageUrl ?? undefined}>
	<div class="loading-screen" data-loading-screen data-min-ms="1200" role="status" aria-label="Loading EON MUN" aria-hidden="true" hidden>
		<span class="loading-wordmark" aria-hidden="true">EON<br />MUN</span>
		<a class="loading-fallback" data-loading-fallback href="/artworks" hidden>View artworks</a>
	</div>
	<div class="hero-carousel" data-hero-carousel data-slide-ms="8000" data-fade-ms="1600">
		{slides.map((slide, i) => (
			<figure
				class:list={['slide', { 'is-current': i === 0 }]}
				aria-hidden={i === 0 ? undefined : 'true'}
				inert={i === 0 ? undefined : true}
			>
				<img
					src={i === 0 ? images[i].src : undefined}
					srcset={i === 0 ? images[i].srcset : undefined}
					sizes={i === 0 ? images[i].sizes : undefined}
					data-src={i > 0 ? images[i].src : undefined}
					data-srcset={i > 0 ? images[i].srcset : undefined}
					data-sizes={i > 0 ? images[i].sizes : undefined}
					data-fallback-src={images[i].fallback}
					width={images[i].width}
					height={images[i].height}
					alt={slide.defaultImageAltText || slide.artwork.data.description?.split('.')[0] || slide.artwork.data.title}
					loading="eager"
					fetchpriority={i === 0 ? 'high' : 'low'}
					decoding="async"
				/>
				<figcaption class="artwork-info">
					<div class="field">
						<div class="label">Name</div>
						<div class="value">{slide.artwork.data.title}</div>
					</div>
					<div class="field">
						<div class="label">Year</div>
						<div class="value">{slide.artwork.data.year ?? 'Untitled'}</div>
					</div>
					<div class="field">
						<div class="label">{slide.collections.length > 1 ? 'Collections' : 'Collection'}</div>
						<div class="values">
							{slide.collections.map((c) => (
								<a href={getCollectionHref(c.slug)}>{c.name}</a>
							))}
						</div>
					</div>
				</figcaption>
			</figure>
		))}
	</div>
	<script is:inline>
		requestAnimationFrame(() => {
			const image = document.querySelector('[data-hero-carousel] .slide.is-current img');
			if (!image || (image.complete && image.naturalWidth > 0)) return;
			const loadingScreen = document.querySelector('[data-loading-screen]');
			if (!loadingScreen) return;
			loadingScreen.hidden = false;
			loadingScreen.removeAttribute('aria-hidden');
			loadingScreen.dataset.startedAt = String(performance.now());
		});
	</script>
</BaseLayout>

<script>
	const root = document.querySelector<HTMLElement>('[data-hero-carousel]');
	if (root) {
		const loadingScreen = document.querySelector<HTMLElement>('[data-loading-screen]');
		const minLoadingMs = Number(loadingScreen?.dataset.minMs ?? 0);
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
		const pictures = slides.map((slide) => slide.querySelector('img')!);
		const slideMs = Number(root.dataset.slideMs);
		const fadeMs = Number(root.dataset.fadeMs);
		let current = 0;
		let timer: number | undefined;
		const pending = new Map<number, Promise<boolean>>();

		const load = (index: number): Promise<boolean> => {
			if (pending.has(index)) return pending.get(index)!;
			const image = pictures[index];
			if (!image) return Promise.resolve(false);
			const promise = (async () => {
				if (image.dataset.src) {
					if (image.dataset.srcset) image.srcset = image.dataset.srcset;
					if (image.dataset.sizes) image.sizes = image.dataset.sizes;
					image.src = image.dataset.src;
					delete image.dataset.src;
				}
				try {
					await image.decode();
					return image.naturalWidth > 0;
				} catch {
					const original = image.dataset.fallbackSrc;
					if (!original || image.currentSrc === original) return false;
					image.removeAttribute('srcset');
					image.src = original;
					try { await image.decode(); return image.naturalWidth > 0; } catch { return false; }
				}
			})();
			pending.set(index, promise);
			return promise;
		};

		const schedule = () => {
			if (reducedMotion || document.hidden || slides.length < 2) return;
			window.clearTimeout(timer);
			timer = window.setTimeout(async () => {
				for (let offset = 1; offset < slides.length; offset++) {
					const next = (current + offset) % slides.length;
					if (!(await load(next))) continue;
					if (document.hidden) return;
					const previous = slides[current];
					const incoming = slides[next];
					incoming.classList.add('is-entering');
					incoming.removeAttribute('inert');
					incoming.removeAttribute('aria-hidden');
					window.setTimeout(() => {
						previous.classList.remove('is-current');
						previous.setAttribute('inert', '');
						previous.setAttribute('aria-hidden', 'true');
						incoming.classList.remove('is-entering');
						incoming.classList.add('is-current');
					}, fadeMs);
					current = next;
					void load((next + 1) % slides.length);
					schedule();
					return;
				}
			}, slideMs);
		};

		void load(0).then(async (ready) => {
			if (ready && !reducedMotion && slides.length > 1) void load(1);
			const shownAt = Number(loadingScreen?.dataset.startedAt ?? 0);
			const remaining = shownAt ? Math.max(0, minLoadingMs - (performance.now() - shownAt)) : 0;
			if (remaining) await new Promise<void>((resolve) => window.setTimeout(resolve, remaining));
			if (!ready) {
				if (loadingScreen) {
					loadingScreen.hidden = false;
					loadingScreen.removeAttribute('aria-hidden');
				}
				loadingScreen?.querySelector<HTMLElement>('[data-loading-fallback]')?.removeAttribute('hidden');
				return;
			}
			loadingScreen?.classList.add('is-hidden');
			loadingScreen?.setAttribute('aria-hidden', 'true');
			if (reducedMotion) return;
			schedule();
			document.addEventListener('visibilitychange', () => {
				window.clearTimeout(timer);
				if (!document.hidden) schedule();
			});
		});
	}
</script>

<style is:global>
	/* Homepage is a fullscreen carousel — the page is itself the hero. Hide
	   the layout footer here only; other routes keep theirs. */
	body > footer { display: none; }
	html, body { background: #f5f1e8 !important; }
</style>

<style>
	.loading-screen {
		position: fixed;
		inset: 0;
		z-index: 100;
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2rem;
		background: #f5f1e8;
		color: #292524;
		transition: opacity 550ms ease, visibility 0s 550ms;
	}
	.loading-screen[hidden] { display: none; }
	.loading-screen.is-hidden {
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}
	.loading-wordmark {
		font-size: clamp(3.5rem, 14vw, 8rem);
		line-height: 0.9;
		letter-spacing: 0.18em;
		padding-left: 0.18em;
		text-align: center;
	}
	.loading-fallback { color: inherit; text-decoration: underline; text-underline-offset: 0.25em; }
	.loading-fallback[hidden] { display: none; }
	.hero-carousel {
		position: fixed;
		inset: 0;
		z-index: 0;
		background: #f5f1e8;
	}
	.slide {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		transition: opacity 1.6s linear;
	}
	.slide.is-current { opacity: 1; z-index: 1; }
	.slide.is-entering { opacity: 1; z-index: 2; }
	.slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	/* Keep artwork details legible over the image. */
	.artwork-info {
		position: absolute;
		right: 1rem;
		bottom: 1.25rem;
		z-index: 50;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		padding: 0.75rem;
		text-align: right;
		color: #fff;
		background: rgba(0, 0, 0, 0.3);
		border: 1px solid rgba(107, 114, 128, 0.3);
		border-radius: 0.5rem;
		backdrop-filter: blur(16px);
		box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
		letter-spacing: 0.025em;
	}
	.artwork-info .label {
		font-size: 0.75rem;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.7);
		font-weight: 500;
	}
	.artwork-info .value,
	.artwork-info .values a {
		display: block;
		font-size: 1rem;
		font-weight: 500;
		color: #fff;
	}
	.artwork-info .values a {
		text-decoration: none;
		transition: color 150ms;
	}
	.artwork-info .values a:hover {
		color: rgb(229, 231, 235);
	}
	@media (prefers-reduced-motion: reduce) {
		.loading-screen, .slide { transition: none; }
	}
</style>
