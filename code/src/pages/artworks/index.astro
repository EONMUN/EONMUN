---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllArtworks, getAllCollections } from '../../db/queries';
import { setEdgeCache } from '../../lib/cache';
import { getArtworkCollectionHref } from '../../lib/paths';
import { getRuntimeEnv } from '../../lib/runtime-env';

const env = getRuntimeEnv();
const [artworks, collections] = await Promise.all([
	getAllArtworks(env),
	getAllCollections(env),
]);

const requestedCollectionSlug = Astro.url.searchParams.get('collection')?.trim() ?? null;
const activeCollection = requestedCollectionSlug
	? collections.find((collection) => collection.slug === requestedCollectionSlug) ?? null
	: null;
const hasUnknownCollectionFilter = Boolean(requestedCollectionSlug && !activeCollection);
const filteredArtworks = hasUnknownCollectionFilter
	? []
	: activeCollection
		? artworks.filter((artwork) =>
			artwork.collections.some((collection) => collection.slug === activeCollection.slug),
		)
		: artworks;
const title = activeCollection ? `${activeCollection.name} Artwork — EONMUN` : 'Artworks — EONMUN';
const description = activeCollection
	? `Browse ${filteredArtworks.length} work${filteredArtworks.length !== 1 ? 's' : ''} in the ${activeCollection.name} collection.`
	: `Browse ${artworks.length} artworks from the EONMUN studio.`;

setEdgeCache(Astro);
---
<BaseLayout title={title} description={description}>
	<div class="container mx-auto px-4 py-8">
		<div class="mb-8 space-y-4">
			<h1 class="text-4xl font-bold mb-2 uppercase tracking-wider">Artworks</h1>
			<p class="text-gray-600 dark:text-gray-400">
				{activeCollection
					? `Filtered to ${activeCollection.name}.`
					: 'Explore the complete collection of artworks.'}
			</p>
			<div class="flex flex-wrap gap-2">
				<a
					href="/artworks"
					class:list={[
						'inline-flex items-center rounded-full border px-3 py-1 text-sm transition-colors',
						!requestedCollectionSlug
							? 'border-white bg-white text-gray-900'
							: 'border-gray-300 text-gray-600 hover:border-gray-500 dark:border-gray-600 dark:text-gray-300',
					]}
				>
					All
				</a>
				{collections.map((collection) => (
					<a
						href={getArtworkCollectionHref(collection.slug)}
						class:list={[
							'inline-flex items-center rounded-full border px-3 py-1 text-sm transition-colors',
							activeCollection?.slug === collection.slug
								? 'border-white bg-white text-gray-900'
								: 'border-gray-300 text-gray-600 hover:border-gray-500 dark:border-gray-600 dark:text-gray-300',
						]}
					>
						{collection.name}
					</a>
				))}
			</div>
			{filteredArtworks.length > 0 && (
				<p class="text-sm text-gray-500 mt-2">
					{filteredArtworks.length} artwork{filteredArtworks.length !== 1 ? 's' : ''}
					{activeCollection && ` in ${activeCollection.name}`}
				</p>
			)}
		</div>

		{filteredArtworks.length > 0 ? (
			<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6">
				{filteredArtworks.map((artwork) => (
					<a href={`/artworks/${artwork.slug}`} class="group block">
						<div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 mb-4">
							{artwork.defaultImageUrl ? (
								<img
									src={artwork.defaultImageUrl}
									alt={artwork.title}
									loading="lazy"
									class="w-full h-full object-cover transition-transform group-hover:scale-105"
								/>
							) : (
								<div class="w-full h-full flex items-center justify-center text-gray-400">No Image</div>
							)}
						</div>
						<div class="text-center">
							<h3 class="text-lg font-medium mb-1">{artwork.title}</h3>
							{artwork.year && <p class="text-sm text-gray-500">{artwork.year}</p>}
						</div>
					</a>
				))}
			</div>
		) : (
			<div class="text-center py-12">
				<p class="text-gray-600 dark:text-gray-400 text-lg">
					{hasUnknownCollectionFilter
						? `No published collection matches “${requestedCollectionSlug}”.`
						: activeCollection
							? `No artworks found in ${activeCollection.name}.`
							: 'No artworks found.'}
				</p>
				{requestedCollectionSlug && (
					<p class="mt-4">
						<a href="/artworks" class="underline">Clear filter</a>
					</p>
				)}
			</div>
		)}
	</div>
</BaseLayout>
