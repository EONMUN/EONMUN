---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArtworkGrid from '../../components/ArtworkGrid.astro';
import FilterChip from '../../components/FilterChip.astro';
import { getPublishedArtworkEntries } from '../../lib/artwork-content';
import { getPublishedCollectionRefs } from '../../lib/collection-content';
import { getCollectionHref } from '../../lib/paths';
export const prerender = false;
const [artworks, collections] = await Promise.all([getPublishedArtworkEntries(), getPublishedCollectionRefs()]);
---
<BaseLayout title="Artworks — EONMUN" description={`Browse ${artworks.length} artworks from the EONMUN studio.`} image={artworks.find((entry) => entry.defaultImageUrl)?.defaultImageUrl ?? undefined}>
	<div class="container mx-auto px-4 py-8">
		<div class="mb-8 space-y-4">
			<h1 class="text-4xl font-bold mb-2 uppercase tracking-wider">Artworks</h1>
			<p class="text-gray-600 dark:text-gray-400">Explore the complete collection of artworks.</p>
			<div class="flex flex-wrap gap-2">
				<FilterChip href="/artworks" active>All</FilterChip>
				{collections.map((collection) => <FilterChip href={getCollectionHref(collection.slug)}>{collection.name}</FilterChip>)}
			</div>
			<p class="text-sm text-gray-500">{artworks.length} artwork{artworks.length !== 1 ? 's' : ''}</p>
		</div>
		<ArtworkGrid artworks={artworks} />
	</div>
</BaseLayout>
<script>
	import { getCollectionHref } from '../../lib/paths';
	// Public gallery HTML is shared by the cache, so resolve legacy query links in the browser.
	const collection = new URLSearchParams(location.search).get('collection');
	if (collection) location.replace(getCollectionHref(collection));
</script>
