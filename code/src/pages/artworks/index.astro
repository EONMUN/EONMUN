---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FilterChip from '../../components/FilterChip.astro';
import DetailImagePrefetch from '../../components/DetailImagePrefetch.astro';
import { Image } from 'astro:assets';
import {
	getArtworkCollectionFilterOptions,
	getPublishedArtworkEntries,
} from '../../lib/artwork-content';
import { getArtworkCollectionHref } from '../../lib/paths';
import { ARTWORK_DETAIL_IMAGE, getResponsiveImageSource } from '../../lib/responsive-image';

export const prerender = false;

const artworks = await getPublishedArtworkEntries();
const collections = getArtworkCollectionFilterOptions(artworks);
const description = `Browse ${artworks.length} artworks from the EONMUN studio.`;
const cards = await Promise.all(artworks.map(async (entry) => ({
	...entry,
	detailImage: entry.defaultImageUrl
		? await getResponsiveImageSource(entry.defaultImageUrl, ARTWORK_DETAIL_IMAGE)
		: null,
})));
---
<BaseLayout title="Artworks — EONMUN" description={description}>
	<DetailImagePrefetch />
	<div class="container mx-auto px-4 py-8" data-artworks-root>
		<div class="mb-8 space-y-4">
			<h1 class="text-4xl font-bold mb-2 uppercase tracking-wider">Artworks</h1>
			<p class="text-gray-600 dark:text-gray-400" data-filter-description>
				Explore the complete collection of artworks.
			</p>
			<div class="flex flex-wrap gap-2">
				<FilterChip
					href="/artworks"
					active
					filterValue=""
					filterName="All"
				>
					All
				</FilterChip>
				{collections.map((collection) => (
					<FilterChip
						href={getArtworkCollectionHref(collection.slug)}
						filterValue={collection.slug}
						filterName={collection.name}
					>
						{collection.name}
					</FilterChip>
				))}
			</div>
			<p class="text-sm text-gray-500 mt-2" data-filter-count>
				{artworks.length} artwork{artworks.length !== 1 ? 's' : ''}
			</p>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-6" data-artwork-grid>
			{cards.map(({ artwork, collections: artworkCollections, defaultImageUrl, detailImage }) => (
					<a
						href={`/artworks/${artwork.id}`}
						data-astro-prefetch="viewport"
						data-detail-image-src={detailImage?.fallback ? detailImage.src : undefined}
						data-detail-image-srcset={detailImage?.srcset}
						data-detail-image-sizes={detailImage?.sizes}
						class="group block"
						data-artwork-card
						data-collection-slugs={artworkCollections.map((collection) => collection.slug).join(',')}
					>
						<div class="aspect-square overflow-hidden rounded-lg bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 mb-4">
							{defaultImageUrl ? (
								<Image
									data-fallback-src={defaultImageUrl}
									format="webp" quality={75} fit="scale-down"
									src={defaultImageUrl}
									alt={artwork.data.title}
									width={960}
									height={960}
									widths={[480, 960]}
									sizes="(min-width: 1280px) 20vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
									class="w-full h-full object-cover transition-transform group-hover:scale-105"
								/>
							) : (
								<div class="w-full h-full flex items-center justify-center text-gray-400">No Image</div>
							)}
						</div>
						<div class="text-center">
							<h3 class="text-lg font-medium mb-1">{artwork.data.title}</h3>
							{artwork.data.year && <p class="text-sm text-gray-500">{artwork.data.year}</p>}
						</div>
					</a>
			))}
		</div>

		<div class="text-center py-12" data-empty-state hidden>
			<p class="text-gray-600 dark:text-gray-400 text-lg" data-empty-message>No artworks found.</p>
			<p class="mt-4">
				<a href="/artworks" class="underline">Clear filter</a>
			</p>
		</div>
	</div>
</BaseLayout>

<script is:inline>
	const initArtworkFilters = () => {
		const root = document.querySelector("[data-artworks-root]");
		if (!root || root.dataset.filtersReady === "true") return;
		root.dataset.filtersReady = "true";

		const cards = Array.from(root.querySelectorAll("[data-artwork-card]"));
		const links = Array.from(root.querySelectorAll("[data-filter-link]"));
		const description = root.querySelector("[data-filter-description]");
		const count = root.querySelector("[data-filter-count]");
		const emptyState = root.querySelector("[data-empty-state]");
		const emptyMessage = root.querySelector("[data-empty-message]");

		const updateFilterState = () => {
			const requestedCollectionSlug =
				new URL(window.location.href).searchParams.get("collection")?.trim() ?? "";
			const activeLink =
				links.find((link) => link.dataset.filterValue === requestedCollectionSlug) ?? null;
			const hasUnknownCollectionFilter =
				Boolean(requestedCollectionSlug) && activeLink === null;
			const activeCollectionName =
				hasUnknownCollectionFilter || !activeLink || !requestedCollectionSlug
					? null
					: activeLink.dataset.filterName ?? null;

			let visibleCount = 0;

			for (const link of links) {
				const isActive = requestedCollectionSlug === ""
					? link.dataset.filterValue === ""
					: link === activeLink;
				link.classList.toggle("is-active", isActive);
				if (isActive) link.setAttribute("aria-current", "page");
				else link.removeAttribute("aria-current");
			}

			for (const card of cards) {
				const cardCollectionSlugs = (card.dataset.collectionSlugs ?? "")
					.split(",")
					.map((value) => value.trim())
					.filter(Boolean);
				const matchesCollection = requestedCollectionSlug === ""
					? true
					: hasUnknownCollectionFilter
						? false
						: cardCollectionSlugs.includes(requestedCollectionSlug);

				card.hidden = !matchesCollection;
				if (matchesCollection) {
					visibleCount += 1;
				}
			}

			if (description) {
				description.textContent = hasUnknownCollectionFilter
					? `No published collection matches "${requestedCollectionSlug}".`
					: activeCollectionName
						? `Filtered to ${activeCollectionName}.`
						: "Explore the complete collection of artworks.";
			}

			if (count) {
				count.textContent = visibleCount === 0 && hasUnknownCollectionFilter
					? "0 artworks"
					: `${visibleCount} artwork${visibleCount === 1 ? "" : "s"}${activeCollectionName ? ` in ${activeCollectionName}` : ""}`;
			}

			if (emptyState) {
				emptyState.hidden = visibleCount > 0;
			}

			if (emptyMessage) {
				emptyMessage.textContent = hasUnknownCollectionFilter
					? `No published collection matches "${requestedCollectionSlug}".`
					: activeCollectionName
						? `No artworks found in ${activeCollectionName}.`
						: "No artworks found.";
			}
		};

		updateFilterState();
		window.addEventListener("popstate", updateFilterState);

		for (const link of links) {
			link.addEventListener("click", () => {
				queueMicrotask(updateFilterState);
			});
		}
	};

	if (document.readyState === "loading") {
		document.addEventListener("DOMContentLoaded", initArtworkFilters, {
			once: true,
		});
	} else {
		initArtworkFilters();
	}
</script>
