---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getArtworkBySlug } from '../../db/queries';
import { setEdgeCache } from '../../lib/cache';
import { getArtworkCollectionHref } from '../../lib/paths';
import { getRuntimeEnv } from '../../lib/runtime-env';

const { slug } = Astro.params;
if (!slug) {
	return new Response('Not found', { status: 404 });
}

const env = getRuntimeEnv();
const artwork = await getArtworkBySlug(env, slug);

if (!artwork) {
	return new Response('Not found', { status: 404 });
}

setEdgeCache(Astro);

const defaultImage = artwork.images.find((i) => i.isDefault) ?? artwork.images[0];
const mainImage = defaultImage?.url ?? artwork.defaultImageUrl;
const price = artwork.product ? artwork.product.price / 100 : null;
const dimensions = [artwork.width, artwork.height, artwork.depth].filter(Boolean);
---
<BaseLayout
	title={`${artwork.title} — EONMUN`}
	description={artwork.description ?? `View ${artwork.title}${artwork.year ? ` from ${artwork.year}` : ''}`}
	image={mainImage ?? undefined}
>
	<div class="container mx-auto px-4 py-8">
		<nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-8">
			<a href="/" class="hover:underline">Home</a>
			<span>/</span>
			<a href="/artworks" class="hover:underline">Artworks</a>
			<span>/</span>
			<span>{artwork.title}</span>
		</nav>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
			<div class="space-y-4">
				{mainImage ? (
					<div class="w-full rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden bg-gray-100 dark:bg-gray-800">
						<img src={mainImage} alt={artwork.title} class="w-full h-auto object-contain" />
					</div>
				) : (
					<div class="aspect-square bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg flex items-center justify-center text-gray-400">
						No Image Available
					</div>
				)}
				{artwork.images.length > 1 && (
					<div class="grid grid-cols-4 gap-4">
						{artwork.images.map((img) => (
							<div
								class:list={[
									'aspect-square rounded-md overflow-hidden border',
									img.url === mainImage ? 'border-current ring-2 ring-current/20' : 'border-gray-200 dark:border-gray-700',
								]}
							>
								<img src={img.url} alt={img.caption ?? artwork.title} loading="lazy" class="w-full h-full object-cover" />
							</div>
						))}
					</div>
				)}
			</div>

			<div class="space-y-6">
				<div>
					<h1 class="text-4xl font-bold mb-2">{artwork.title}</h1>
					{artwork.year && <p class="text-xl text-gray-500 dark:text-gray-400">{artwork.year}</p>}
				</div>

				<div class="border-t border-b border-gray-200 dark:border-gray-700 py-6">
					{artwork.product ? (
						<a
							href={`/store/${artwork.product.slug}`}
							class="inline-flex items-center justify-center px-6 py-3 bg-gray-900 dark:bg-white text-white dark:text-gray-900 rounded-lg hover:opacity-90 transition-opacity font-medium"
						>
							View in Store {price !== null && `— $${price.toLocaleString()}`}
						</a>
					) : (
						<p class="text-sm text-gray-500 dark:text-gray-400">Not currently available for purchase.</p>
					)}
				</div>

				{artwork.description && (
					<div>
						<h2 class="text-lg font-semibold mb-3">Description</h2>
						<p class="leading-relaxed whitespace-pre-line text-gray-700 dark:text-gray-300">{artwork.description}</p>
					</div>
				)}

				{artwork.collections.length > 0 && (
					<div>
						<h2 class="text-lg font-semibold mb-3">Collection{artwork.collections.length > 1 ? 's' : ''}</h2>
						<div class="flex flex-wrap gap-2">
							{artwork.collections.map((c) => (
								<a
									href={getArtworkCollectionHref(c.slug)}
									class="inline-block px-3 py-1 text-sm border border-gray-300 dark:border-gray-600 rounded-full hover:border-gray-500"
								>
									{c.name}
								</a>
							))}
						</div>
					</div>
				)}

				<div class="pt-6 border-t border-gray-200 dark:border-gray-700">
					<h2 class="text-lg font-semibold mb-3">Details</h2>
					<dl class="space-y-2 text-sm">
						{artwork.artist && (
							<div class="flex justify-between"><dt class="text-gray-500">Artist</dt><dd>{artwork.artist}</dd></div>
						)}
						{dimensions.length > 0 && (
							<div class="flex justify-between">
								<dt class="text-gray-500">Dimensions</dt>
								<dd>{dimensions.join(' x ')} {artwork.dimensionUnit ?? 'in'}</dd>
							</div>
						)}
					</dl>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
