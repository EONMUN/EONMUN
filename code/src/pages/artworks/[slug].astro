---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PurchaseState from '../../components/PurchaseState.astro';
import TagLink from '../../components/TagLink.astro';
import { Image } from 'astro:assets';
import {
	getPublishedArtworkDetailBySlug,
} from '../../lib/artwork-content';
import { getCollectionHref } from '../../lib/paths';
import { ARTWORK_DETAIL_IMAGE } from '../../lib/responsive-image';

export const prerender = false;

const slug = Astro.params.slug;

if (!slug) {
	return new Response('Not found', { status: 404 });
}

const artworkDetail = await getPublishedArtworkDetailBySlug(slug);
if (!artworkDetail) {
	Astro.cache.set(false);
	return new Response('Not found', { status: 404 });
}

const { artwork, collections, defaultImageUrl, offer } = artworkDetail;
// CRITICAL: product price and stock can change independently of artwork content.
// Shopping crawlers must receive the current offer in the initial HTML.
Astro.cache.set(false);
const images = artwork.data.images;
const defaultImage = images.find((image) => image.isDefault) ?? images[0];
const mainImage = defaultImage?.url ?? defaultImageUrl;
const mainAlt = defaultImage?.altText || defaultImage?.caption || artwork.data.description?.split('\n')[0] || artwork.data.title;
const saleOffer = offer?.available ? offer : null;
const price = saleOffer ? (saleOffer.priceCents / 100).toFixed(2) : null;
const formattedPrice = saleOffer ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }).format(saleOffer.priceCents / 100) : null;
const productJsonLd = saleOffer ? JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Product',
	name: artwork.data.title,
	...(artwork.data.description ? { description: artwork.data.description } : {}),
	...(mainImage ? { image: [mainImage] } : {}),
	offers: {
		'@type': 'Offer',
		url: new URL(`/artworks/${artwork.id}`, Astro.site).toString(),
		priceCurrency: 'USD',
		price,
		availability: 'https://schema.org/InStock',
	},
}).replace(/</g, '\\u003c') : null;
---
<BaseLayout
	title={`${artwork.data.title} — EONMUN`}
	description={artwork.data.description ?? `View ${artwork.data.title}${artwork.data.year ? ` from ${artwork.data.year}` : ''}`}
	image={mainImage ?? undefined}
>
	{productJsonLd && <script type="application/ld+json" set:html={productJsonLd} />}
	<div class="container mx-auto px-4 py-8">
		<nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-8">
			<a href="/" class="hover:underline">Home</a>
			<span>/</span>
			<a href="/artworks" class="hover:underline">Artworks</a>
			<span>/</span>
			<span>{artwork.data.title}</span>
		</nav>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
			<div class="space-y-4">
				{mainImage ? (
					<div class="w-full rounded-lg border border-gray-200 dark:border-gray-700 overflow-hidden bg-gray-100 dark:bg-gray-800">
						<Image data-fallback-src={mainImage} format="webp" quality={75} fit="scale-down" src={mainImage} alt={mainAlt} {...ARTWORK_DETAIL_IMAGE} loading="eager" fetchpriority="high" class="w-full h-auto object-contain" />
					</div>
				) : (
					<div class="aspect-square bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg flex items-center justify-center text-gray-400">
						No Image Available
					</div>
				)}
				{images.length > 1 && (
					<div class="grid grid-cols-4 gap-4">
						{images.map((img) => (
							<div
								class:list={[
									'aspect-square rounded-md overflow-hidden border',
									img.url === mainImage ? 'border-current ring-2 ring-current/20' : 'border-gray-200 dark:border-gray-700',
								]}
							>
								<Image data-fallback-src={img.url} format="webp" quality={75} fit="cover" src={img.url} alt={img.altText || img.caption || artwork.data.title} width={480} height={480} widths={[480]} sizes="25vw" class="w-full h-full object-cover" />
							</div>
						))}
					</div>
				)}
			</div>

			<div class="space-y-6">
				<div>
					<h1 class="text-4xl font-bold mb-2">{artwork.data.title}</h1>
					{artwork.data.year && <p class="text-xl text-gray-500 dark:text-gray-400">{artwork.data.year}</p>}
				</div>

				<div class="border-t border-b border-gray-200 dark:border-gray-700 py-6">
					{formattedPrice && <p class="mb-4 text-2xl font-semibold" data-artwork-price>{formattedPrice} USD</p>}
					<PurchaseState artworkSlug={artwork.id} available={offer?.available ?? false} sold={offer?.sold ?? false} />
					{saleOffer && <p class="mt-3 text-sm text-gray-600 dark:text-gray-400">U.S. shipping included. All sales final. <a class="underline" href="/shipping">Shipping</a> · <a class="underline" href="/returns">Returns</a></p>}
				</div>

				{artwork.data.description && (
					<div>
						<h2 class="text-lg font-semibold mb-3">Description</h2>
						<p class="leading-relaxed whitespace-pre-line text-gray-700 dark:text-gray-300">{artwork.data.description}</p>
					</div>
				)}
				{artwork.data.tags.length > 0 && (
					<div class="flex flex-wrap gap-2" aria-label="Artwork tags">
						{artwork.data.tags.map((tag) => <span class="rounded-full border border-gray-200 px-3 py-1 text-sm text-gray-600 dark:border-gray-700 dark:text-gray-300">{tag}</span>)}
					</div>
				)}

				{collections.length > 0 && (
					<div>
						<h2 class="text-lg font-semibold mb-3">Collection{collections.length > 1 ? 's' : ''}</h2>
						<div class="flex flex-wrap gap-2">
							{collections.map((c) => (
								<TagLink href={getCollectionHref(c.slug)}>
									{c.name}
								</TagLink>
							))}
						</div>
					</div>
				)}

				<div class="pt-6 border-t border-gray-200 dark:border-gray-700">
					<h2 class="text-lg font-semibold mb-3">Details</h2>
					<dl class="space-y-2 text-sm">
						{artwork.data.artist && (
							<div class="flex justify-between"><dt class="text-gray-500">Artist</dt><dd>{artwork.data.artist}</dd></div>
						)}
					</dl>
				</div>
			</div>
		</div>
	</div>
</BaseLayout>
