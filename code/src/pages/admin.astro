---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getSession, getSignInUrl } from '../lib/auth';
import { getRuntimeEnv } from '../lib/runtime-env';

export const prerender = false;

const session = await getSession(Astro.request, getRuntimeEnv());

if (!session) {
	return Astro.redirect(getSignInUrl(Astro.request).toString(), 302);
}
---
<BaseLayout title="Admin — EONMUN" description="EONMUN administration.">
	<main class="container mx-auto px-4 py-8">
		<div class="mb-8">
			<h1 class="text-4xl font-bold mb-2 uppercase tracking-wider">Admin</h1>
			<p class="text-gray-600 dark:text-gray-400">
				Signed in as {session.user.email}.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
			<a href="/artworks" class="block border border-gray-200 dark:border-gray-700 rounded-lg p-5 hover:border-gray-500">
				<h2 class="text-xl font-semibold mb-2">Artwork</h2>
				<p class="text-sm text-gray-600 dark:text-gray-400">Review the static artwork collection.</p>
			</a>
			<a href="/posts" class="block border border-gray-200 dark:border-gray-700 rounded-lg p-5 hover:border-gray-500">
				<h2 class="text-xl font-semibold mb-2">Posts</h2>
				<p class="text-sm text-gray-600 dark:text-gray-400">Review published studio posts.</p>
			</a>
			<a href="/store" class="block border border-gray-200 dark:border-gray-700 rounded-lg p-5 hover:border-gray-500">
				<h2 class="text-xl font-semibold mb-2">Store</h2>
				<p class="text-sm text-gray-600 dark:text-gray-400">Review static products and live availability.</p>
			</a>
		</div>

		<div class="mt-8">
			<a
				href="/api/auth/signout"
				class="inline-flex px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md hover:border-gray-500"
			>
				Sign out
			</a>
		</div>
	</main>
</BaseLayout>
