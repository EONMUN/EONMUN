---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAllCollections } from '../../db/queries';
import { setEdgeCache } from '../../lib/cache';

const env = Astro.locals.runtime.env;
const collections = await getAllCollections(env);

setEdgeCache(Astro);
---
<BaseLayout title="Collections — EONMUN" description="Browse EONMUN collections.">
	<div class="container mx-auto px-4 py-8">
		<div class="mb-8">
			<h1 class="text-4xl font-bold mb-2 uppercase tracking-wider">Collections</h1>
			<p class="text-gray-600 dark:text-gray-400">Curated bodies of work.</p>
		</div>

		{collections.length > 0 ? (
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
				{collections.map((c) => (
					<a
						href={`/collections/${c.slug}`}
						class="block p-6 border border-gray-200 dark:border-gray-700 rounded-lg hover:border-gray-400 dark:hover:border-gray-500 transition-colors"
					>
						<h2 class="text-xl font-bold uppercase tracking-wider mb-2">{c.name}</h2>
						{c.description && (
							<p class="text-gray-600 dark:text-gray-400 line-clamp-3">{c.description}</p>
						)}
					</a>
				))}
			</div>
		) : (
			<div class="text-center py-12">
				<p class="text-gray-600 dark:text-gray-400 text-lg">No collections published yet.</p>
			</div>
		)}
	</div>
</BaseLayout>
