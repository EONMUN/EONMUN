---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// Prerendered. Snapshot of the live homepage carousel (admin-configurable
// in the legacy app via getHomePageData). Once Turso Worker secrets are
// set we can promote this to SSR-with-cache and read the live slide
// configuration from the DB.
export const prerender = true;

const slides = [
	{ src: 'https://r2.eonmun.com/1775752300190-44673548e9cb29c8.jpeg', alt: 'Before the Eternal' },
	{ src: 'https://r2.eonmun.com/1775751480745-23b12edb2a0730ae.jpeg', alt: 'Poppies' },
	{ src: 'https://r2.eonmun.com/1767296108544-1e9fc0562e8c704e.jpeg', alt: 'When Clouds Part' },
	{ src: 'https://r2.eonmun.com/1775753048979-db1aaf6dbf2f2b27.jpeg', alt: 'Somewhere in West Texas' },
	{ src: 'https://r2.eonmun.com/1775753290453-8db9813ccc72ab26.jpeg', alt: 'Crane Beneath the Maple' },
	{ src: 'https://r2.eonmun.com/PERS_Int_b08c7cef7c.jpeg', alt: 'Persimmons del Oro' },
	{ src: 'https://r2.eonmun.com/LIM_Int_2b192a6609.jpeg', alt: 'Limones del Cobre' },
	{ src: 'https://r2.eonmun.com/quetzalcoatlin_tetl_e3a31b4836.jpeg', alt: 'Quetzalcōātlin tetl' },
];

const slideSeconds = 5;
const cycleSeconds = slides.length * slideSeconds;
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} image={slides[0].src}>
	<div class="hero-carousel">
		{slides.map(({ src, alt }, i) => (
			<figure class="slide" style={`animation-delay: ${i * slideSeconds}s;`}>
				<img
					src={src}
					alt={alt}
					loading={i === 0 ? 'eager' : 'lazy'}
					fetchpriority={i === 0 ? 'high' : 'auto'}
				/>
				<figcaption>{alt}</figcaption>
			</figure>
		))}
	</div>
</BaseLayout>

<style is:global>
	/* Homepage is a fullscreen carousel — the page is itself the hero. Hide
	   the layout footer here only; other routes keep theirs. */
	body > footer { display: none; }
</style>

<style define:vars={{ cycleSeconds: `${cycleSeconds}s` }}>
	.hero-carousel {
		position: fixed;
		inset: 0;
		z-index: 0;
		background: #000;
	}
	.slide {
		position: absolute;
		inset: 0;
		margin: 0;
		opacity: 0;
		animation: hero-fade var(--cycleSeconds) linear infinite;
	}
	.slide img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}
	.slide figcaption {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		padding: 0.5rem 0.875rem;
		color: #fff;
		background: rgba(0, 0, 0, 0.45);
		backdrop-filter: blur(4px);
		font-size: 0.875rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	/* Each slide visible for 5 of 40s (12.5% of cycle). Fade in 0%→1.25%,
	   hold to 12.5%, fade out 12.5%→13.75%. */
	@keyframes hero-fade {
		0%, 100% { opacity: 0; }
		1.25%, 12.5% { opacity: 1; }
		13.75% { opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.slide { animation: none; }
		.slide:first-child { opacity: 1; }
	}
</style>
