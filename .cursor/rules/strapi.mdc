      "allowedTypes": ["images"]
    }
  }
}
```

### 5. Slider Component (`shared/slider.json`)
```json
{
  "collectionName": "components_shared_sliders",
  "info": {
    "displayName": "Slider",
    "icon": "address-book",
    "description": ""
  },
  "options": {},
  "attributes": {
    "files": {
      "type": "media",
      "multiple": true,
