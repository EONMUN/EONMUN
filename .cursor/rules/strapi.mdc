{
  "collectionName": "components_shared_rich_texts",
  "info": {
    "displayName": "Rich text",
    "icon": "align-justify",
    "description": ""
  },
  "options": {},
  "attributes": {
    "body": {
      "type": "richtext"
    }
  }
}
```

### 4. SEO Component (`shared/seo.json`)
```json
{
  "collectionName": "components_shared_seos",
  "info": {
    "name": "Seo",
    "icon": "allergies",
    "displayName": "Seo",
    "description": ""
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": true
    },
    "metaDescription": {
      "type": "text",
