# ============================================
# PORT CONFIGURATION
# ============================================
# Ports use the same value for both host and container following our port-mapping convention
# See docs/conventions/port-mapping.md for details
STRAPI_PORT=1337
WEB_PORT=3000

# ============================================
# STRAPI CMS CONFIGURATION
# ============================================
# For local development with Docker, use http://strapi:1337
# For production, use your production Strapi URL
NEXT_PUBLIC_STRAPI_API_URL=http://strapi:1337
NEXT_PUBLIC_STRAPI_API_TOKEN=your-strapi-api-token-here

# ============================================
# STRAPI SECRETS
# ============================================
# Generate random base64 strings for each of these values
# You can use: openssl rand -base64 16
APP_KEYS=key1==,key2==,key3==,key4==
API_TOKEN_SALT=your-api-token-salt-here==
ADMIN_JWT_SECRET=your-admin-jwt-secret-here==
TRANSFER_TOKEN_SALT=your-transfer-token-salt-here==
ENCRYPTION_KEY=your-encryption-key-here==
JWT_SECRET=your-jwt-secret-here==

# ============================================
# SMTP CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_FROM="EONMUN Contact Form"
SMTP_PASS=your-app-password

# ============================================
# PRODUCTION SYNC (Optional)
# ============================================
# Only needed if you want to sync data from production
# PROD_STRAPI_URL=https://admin.eonmun.com
# PROD_STRAPI_API_TOKEN=your-production-api-token
# PROD_STRAPI_TRANSFER_TOKEN=your-production-transfer-token

# ============================================
# CLOUDFLARE CONFIGURATION (Optional)
# ============================================
# For generating R2 credentials via API
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token

# ============================================
# CLOUDFLARE R2 CONFIGURATION (Optional)
# ============================================
# Only needed for uploading media files to R2
# Generate these using: npm run r2:generate-credentials
# Or get manually from Cloudflare R2 dashboard
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=eonmun-media
# R2_PUBLIC_URL=https://cdn.eonmun.com
