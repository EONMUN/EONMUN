# ============================================
# PORT CONFIGURATION
# ============================================
# Ports use the same value for both host and container following our port-mapping convention
# See docs/conventions/port-mapping.md for details
WEB_PORT=3002
NEXT_PUBLIC_APP_URL=http://localhost:3002

# ============================================
# SMTP CONFIGURATION
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_FROM="EONMUN Contact Form"
SMTP_PASS=your-app-password

